{
  "name": "guard-master",
  "version": "0.1.0",
  "type": "module",
  "description": "Guard Master Fencing Solutions — high-security perimeter fencing site built with Astro, Tailwind CSS and GSAP.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "images": "node scripts/build-product-images.mjs",
    "format": "prettier --write \"src/**/*.{astro,ts,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css,md}\""
  },
  "dependencies": {
    "astro": "^7.1.3",
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^22.13.1",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3"
  }
}
