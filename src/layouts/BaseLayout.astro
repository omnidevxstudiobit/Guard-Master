---
import '@styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Nav bar variants for the Guard Master build.' } = Astro.props;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
  </head>
  <body>
    <slot />
  </body>
</html>
