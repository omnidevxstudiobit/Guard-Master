---
import '@styles/global.css';
import NavCenterSplit from '@components/nav/NavCenterSplit.astro';
import Footer from '@components/layout/Footer.astro';
import QuoteBar from '@components/layout/QuoteBar.astro';

interface Props {
  title: string;
  description?: string;
  /** Default false: `<main>` gets top padding matching the fixed header's
   * own height (h-16/lg:h-20 in NavCenterSplit.astro), so a page's first
   * section starts clear of it instead of sliding underneath — the header
   * is `position: fixed`, so it doesn't push layout down on its own. Pass
   * true only for a page whose first section is deliberately designed to
   * render full-bleed behind the (initially translucent) header, the way
   * Hero.astro is on the homepage. Every inner page — including
   * quote-estimator.astro, which had this exact bug (its "Step 1 of 5"
   * label was rendering partly behind the header) until this prop existed —
   * should leave this false. */
  fullBleedHero?: boolean;
}

const {
  title,
  description = 'Nav bar variants for the Guard Master build.',
  fullBleedHero = false,
} = Astro.props;

/**
 * seoguide.md Appendix B1 — Organization, site-wide. Only fields that are
 * actually known go in: name, legalName and description are established
 * facts used throughout the site; url reuses astro.config.mjs's own
 * (already TODO-flagged) placeholder domain.
 *
 * `telephone` and `address` are the client's real general sales line and
 * their real factory, both published on their own reference site
 * (fencing-supplier.com). This used to carry the +1 export number and no
 * address at all, on the reasoning that a US-market site shouldn't schema a
 * South African address — that framing is retired, so the primary contact
 * details are now the ones the business actually trades on. The export line
 * is still surfaced in the footer, just not as *the* organization number.
 *
 * Still deliberately omitted rather than filled with placeholders: `logo`
 * (no exported logo file exists yet — Logo.astro is inline SVG, not a URL)
 * and `sameAs` (no real social profiles to link). A missing field is
 * silently incomplete; a fabricated one is silently wrong and search engines
 * will index it as fact.
 */
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${Astro.site ?? new URL(Astro.url.origin)}#org`,
  name: 'Guard Master',
  legalName: 'Wire Ventures CC t/a Guard Master Fencing Solutions',
  url: Astro.site?.href ?? Astro.url.origin,
  telephone: '+27-11-437-8903',
  email: 'info@fencing-supplier.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '10 Burnley Street',
    addressLocality: 'Benoni South Extn.',
    addressRegion: 'Gauteng',
    postalCode: '1501',
    addressCountry: 'ZA',
  },
  description:
    'South African manufacturer of clear view 358 anti-climb high-security perimeter fencing, razor wire and rapid deployment barriers.',
};
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
  </head>
  <body>
    <NavCenterSplit assumeDarkBg={!fullBleedHero} />
    <main class:list={[{ 'pt-16 lg:pt-20': !fullBleedHero }]}>
      <slot />
    </main>
    <Footer />
    <QuoteBar />
  </body>
</html>
