---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import { CTA } from '@data/nav';

/**
 * /projects — a full page for the honesty rule ProjectsShowcase.astro
 * already established on the homepage: no client photography exists yet,
 * so this doesn't invent named projects, client logos or photos. It reuses
 * the same five real sector/scope/spec facts as that section, INCLUDING its
 * exact perimeter-schematic geometry (path/posts/gate) — same numbers, same
 * ≈ prefix, same stroke-draw technique — laid out as a full grid instead of
 * a horizontal filmstrip, since a dedicated page has the width to show all
 * five at once rather than making a visitor scroll sideways to see them.
 */

type Site = {
  id: string;
  sector: string;
  title: string;
  lf: string;
  spec: string;
  /** Perimeter polygon, drawn in a 0 0 200 140 viewBox — identical to
   * ProjectsShowcase.astro's SITES so the two never quote different shapes
   * for the same sector. */
  path: string;
  posts: [number, number][];
  gate: [number, number, number];
  double?: boolean;
};

const SECTORS: Site[] = [
  {
    id: 'commercial',
    sector: 'Commercial',
    title: 'Distribution Center Perimeter',
    lf: '≈2,400 LF',
    spec: '358 Anti-Climb · HDG',
    path: 'M20,30 L180,30 L180,110 L20,110 Z',
    posts: [
      [20, 30], [100, 30], [180, 30], [180, 70], [180, 110], [100, 110], [20, 110], [20, 70],
    ],
    gate: [100, 110, 0],
  },
  {
    id: 'industrial',
    sector: 'Industrial',
    title: 'Processing Plant Perimeter',
    lf: '≈1,800 LF',
    spec: '358 Anti-Climb · Powder Coat',
    path: 'M20,20 L140,20 L140,60 L180,60 L180,120 L20,120 Z',
    posts: [
      [20, 20], [140, 20], [140, 60], [180, 60], [180, 120], [100, 120], [20, 120], [20, 70],
    ],
    gate: [180, 90, 90],
  },
  {
    id: 'utility-solar',
    sector: 'Utility & Solar',
    title: 'Solar Farm Perimeter',
    lf: '≈6,000 LF',
    spec: '358 Anti-Climb · Plascoat, 10-Yr Warranty',
    path: 'M10,40 L190,40 L190,100 L10,100 Z',
    posts: [
      [10, 40], [64, 40], [118, 40], [190, 40], [190, 70], [190, 100], [118, 100], [64, 100], [10, 100], [10, 70],
    ],
    gate: [64, 100, 0],
  },
  {
    id: 'government',
    sector: 'Government & Institutional',
    title: 'Correctional Facility Perimeter',
    lf: '≈3,200 LF',
    spec: '358 Anti-Climb · HDG, Razor Topping',
    path: 'M30,20 L170,20 L170,120 L30,120 Z',
    posts: [
      [30, 20], [170, 20], [170, 70], [170, 120], [100, 120], [30, 120], [30, 70],
    ],
    gate: [100, 20, 180],
    double: true,
  },
  {
    id: 'residential',
    sector: 'Residential',
    title: 'Private Estate Perimeter',
    lf: '≈900 LF',
    spec: '358 Anti-Climb · Powder Coat',
    path: 'M40,25 L160,35 L175,100 L100,120 L25,90 Z',
    posts: [[40, 25], [160, 35], [175, 100], [100, 120], [25, 90]],
    gate: [25, 90, -60],
  },
];

const PROCESS = [
  {
    step: '1. Configure or Request a Survey',
    note: 'Start in the estimator for an instant range, or request a site survey directly — both are options in the same quote flow.',
  },
  {
    step: '2. Engineered to the Site',
    note: 'Length, terrain, access points and finish are specified for your perimeter, not picked off a fixed catalogue.',
  },
  {
    step: '3. Manufactured Direct',
    note: 'Panels, posts and fixtures are made and finished in-house, then shipped direct — no reseller markup or overseas customs wait.',
  },
];
---

<BaseLayout
  title="Security Fencing Projects by Sector | Guard Master"
  description="The scope Guard Master perimeters typically run, by sector — commercial, industrial, utility, government and residential. Manufacturer-direct, engineered to the site."
>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Projects', href: '/projects' },
    ]}
  />

  <!-- Header -->
  <section class="bg-gm-white text-gm-black py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Projects</p>
        <h1
          class="font-display text-gm-black mt-5 text-4xl leading-[0.95] font-black tracking-tight uppercase sm:text-5xl lg:text-6xl"
        >
          The Scope We <span class="text-gm-red">Actually Run</span>
        </h1>
        <p class="text-gm-grey-600 mt-6 max-w-2xl text-base leading-relaxed">
          We're building out our project photography now, so rather than show you stock imagery or
          invented case studies, here's what's true and useful today: the kind of length, sector
          and spec each perimeter typically runs.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href={CTA.href}
            class="tap-target bg-gm-red text-gm-white inline-flex items-center px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
          >
            {CTA.label}
          </a>
          <a
            href="/quote-estimator"
            class="tap-target border-gm-grey-300 text-gm-black hover:border-gm-black inline-flex items-center border px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors"
          >
            Request a Site Survey
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Sector scope grid — same perimeter-schematic technique as the
       homepage's ProjectsShowcase filmstrip (real site-plan shapes, posts
       at the joints, a gate break, perimeter stroke-drawn on scroll-in) laid
       out as a five-up grid instead of a horizontal scroller, since this
       page has the width to show every sector at once. -->
  <section class="bg-gm-black text-gm-white py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">By Sector</p>
      <h2
        class="font-display text-gm-white mt-5 max-w-2xl text-3xl leading-[1.05] font-black tracking-tight uppercase sm:text-4xl"
      >
        From 900 Feet to 6,000
      </h2>
      <p class="text-gm-grey-400 mt-6 max-w-2xl text-base leading-relaxed">
        Illustrative scope, not a specific completed job — every real perimeter is quoted against
        your actual site.
      </p>

      <div data-sector-grid class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          SECTORS.map((site) => (
            <figure
              data-card
              class="rounded-md border border-white/10 bg-[#0c0c0e] p-5"
            >
              <svg
                viewBox="0 0 200 140"
                class="block h-auto w-full"
                role="img"
                aria-label={`Schematic: ${site.title}, ${site.lf}`}
              >
                <g stroke="rgba(255,255,255,0.05)" stroke-width="1">
                  {[20, 60, 100, 140, 180].map((x) => (
                    <line x1={x} y1="0" x2={x} y2="140" />
                  ))}
                  {[20, 60, 100].map((y) => (
                    <line x1="0" y1={y} x2="200" y2={y} />
                  ))}
                </g>

                {site.double && (
                  <path
                    d="M18,10 L182,10 L182,130 L18,130 Z"
                    fill="none"
                    stroke="#3a3a3a"
                    stroke-width="1.4"
                    stroke-dasharray="3 3"
                  />
                )}

                <path
                  data-draw
                  pathLength="100"
                  d={`${site.path} Z`}
                  fill="none"
                  stroke="#e4112a"
                  stroke-width="2"
                  stroke-linejoin="round"
                />

                {site.posts.map(([x, y]) => (
                  <circle cx={x} cy={y} r="2.4" fill="#161616" stroke="#e4112a" stroke-width="1.2" />
                ))}

                <g
                  stroke="#f4f4f4"
                  stroke-width="2"
                  stroke-linecap="round"
                  transform={`translate(${site.gate[0]} ${site.gate[1]}) rotate(${site.gate[2]})`}
                >
                  <line x1="-7" y1="-4" x2="-7" y2="4" />
                  <line x1="7" y1="-4" x2="7" y2="4" />
                </g>
              </svg>

              <figcaption class="mt-4">
                <p class="text-gm-red font-mono text-[10px] tracking-[0.18em] uppercase">
                  {site.sector}
                </p>
                <h3 class="font-display text-gm-white mt-1.5 text-sm font-bold tracking-tight uppercase">
                  {site.title}
                </h3>
                <p class="text-gm-grey-400 mt-2 flex items-baseline gap-2 font-mono text-[11px]">
                  <span class="text-gm-white">{site.lf}</span>
                  <span aria-hidden="true">·</span>
                  <span>{site.spec}</span>
                </p>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="bg-gm-white text-gm-black py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">How a Project Runs</p>
        <h2
          class="font-display text-gm-black mt-5 text-3xl leading-[1.05] font-black tracking-tight uppercase sm:text-4xl"
        >
          Quote-Led, Engineered To The Site
        </h2>
      </div>

      <div class="border-gm-grey-200 mt-12 grid gap-x-10 gap-y-10 border-t pt-10 sm:grid-cols-3">
        {
          PROCESS.map((p) => (
            <div>
              <h3 class="font-display text-gm-black text-base font-bold tracking-tight uppercase">
                {p.step}
              </h3>
              <p class="text-gm-grey-600 mt-2 text-[13px] leading-relaxed">{p.note}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Complete the system -->
  <section class="bg-gm-grey-50 text-gm-black py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Explore The System</p>
      <h2
        class="font-display text-gm-black mt-5 max-w-2xl text-3xl leading-[1.05] font-black tracking-tight uppercase sm:text-4xl"
      >
        See What Goes Into Every Perimeter
      </h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          [
            {
              name: 'Clear View Panels',
              href: '/clear-view-fencing-panels',
              note: '358 mesh · 3 apertures · sized to your run',
            },
            {
              name: 'Clear View Posts',
              href: '/clear-view-fencing-posts',
              note: '6 lengths · reinforced profile',
            },
            {
              name: 'Warranties & Guarantees',
              href: '/warranties-and-guarantees',
              note: 'Up to 10 years on our Plascoat finish',
            },
          ].map((p) => (
            <a
              href={p.href}
              class="tap-target group border-gm-grey-200 hover:border-gm-black block border bg-white p-6 transition-colors"
            >
              <span class="font-display text-gm-black text-lg font-bold tracking-tight uppercase">
                {p.name}
              </span>
              <p class="text-gm-grey-600 mt-2 text-[13px] leading-relaxed">{p.note}</p>
              <span class="text-gm-red mt-4 inline-flex items-center text-[12px] font-bold tracking-[0.08em] uppercase">
                See Options →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="bg-gm-black text-gm-white py-20 text-center sm:py-24">
    <div class="mx-auto max-w-2xl px-6">
      <h2
        class="font-display text-gm-white text-3xl leading-[1.05] font-black tracking-tight uppercase sm:text-4xl"
      >
        Get A Scope <span class="text-gm-red">Specific To Your Site</span>
      </h2>
      <p class="text-gm-grey-300 mx-auto mt-5 max-w-lg text-base leading-relaxed">
        Start with the instant estimator, or request a full site survey — either way, the same
        quote-led process ends with a spec built for your perimeter.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/quote-estimator"
          class="tap-target bg-gm-red text-gm-white inline-flex items-center px-7 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
        >
          Start Your Estimate
        </a>
        <a
          href="/clear-view-fencing-panels"
          class="tap-target text-gm-white hover:border-gm-white inline-flex items-center border border-white/25 px-7 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors"
        >
          Explore the Range
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Same stroke-draw technique as ProjectsShowcase.astro's filmstrip —
     pathLength="100" normalises stroke-dasharray/dashoffset regardless of
     each site's actual polygon geometry. Default fully-drawn (dashoffset 0)
     for no-JS / reduced motion. */
  [data-sector-grid] [data-draw] {
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
  }
  [data-sector-grid].is-armed [data-draw] {
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 0.9s ease-out;
  }
  [data-sector-grid].is-armed [data-card].is-in [data-draw] {
    stroke-dashoffset: 0;
  }
</style>

<script>
  const grid = document.querySelector<HTMLElement>('[data-sector-grid]');

  if (grid) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduce) {
      grid.classList.add('is-armed');
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-card]'));
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.4 },
      );
      cards.forEach((c) => io.observe(c));
    }
  }
</script>
