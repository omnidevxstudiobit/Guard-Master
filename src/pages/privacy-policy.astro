---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';

/**
 * /privacy-policy — a real draft, not filler. Content is restricted to
 * facts already established elsewhere in this build (the quote estimator
 * collects lead details and pushes them to the Monday.com CRM per
 * businessguide.md §7; Google Ads/Merchant Center run paid marketing per
 * §7) plus generic, true-of-any-website boilerplate (standard server logs,
 * no data sale). It deliberately does NOT assert a specific governing-law
 * jurisdiction, a named cookie/analytics stack, specific retention periods,
 * or CCPA/GDPR-specific rights language — none of that has been confirmed,
 * and a wrong specific here is a real legal liability, not just a copy
 * error. The notice banner says so plainly rather than burying the caveat
 * in a footer line no one reads.
 */

const SECTIONS = [
  {
    heading: 'Information We Collect',
    body: 'When you use our quote estimator or contact form, we collect what you submit — typically your name, email, phone number, and project details (fence type, dimensions, finish). Like most websites, our server may also log standard technical information, such as browser type and pages visited, to help us operate and improve the site.',
  },
  {
    heading: 'How We Use It',
    body: "Submitted information is used to prepare your estimate, follow up on your request, and route your inquiry through our internal CRM. If you've engaged with our advertising, Google Ads and Google Merchant Center may also be involved in how you reached us.",
  },
  {
    heading: 'Sharing',
    body: 'We do not sell your personal information. We share it only with the service providers that help us operate — our CRM and hosting providers — and only as needed to respond to your inquiry.',
  },
  {
    heading: 'Your Choices',
    body: 'You can ask us what information we hold about you, or ask us to delete it, by contacting us using the details below.',
  },
  {
    heading: 'Changes to This Policy',
    body: 'We may update this page as our practices or the legal review below are finalized. Check back for the latest version.',
  },
];
---

<BaseLayout
  title="Privacy Policy | Guard Master"
  description="How Guard Master collects, uses and protects information submitted through our quote estimator and contact forms."
>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Privacy Policy', href: '/privacy-policy' },
    ]}
  />

  <section class="bg-gm-white text-gm-black py-16 sm:py-20">
    <div class="mx-auto max-w-[820px] px-6 lg:px-8">
      <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Legal</p>
      <h1
        class="font-display text-gm-black mt-5 text-4xl leading-[0.95] font-black tracking-tight uppercase sm:text-5xl"
      >
        Privacy Policy
      </h1>

      <div class="border-gm-grey-200 bg-gm-grey-50 border-l-gm-red mt-8 border-l-2 p-5">
        <p class="text-gm-grey-700 text-sm leading-relaxed">
          <strong class="text-gm-black">Draft notice:</strong> this page describes our current data practices
          in plain terms and has not yet been reviewed by legal counsel. Treat it as an accurate outline,
          not a final, legally binding policy, until it's been through that review.
        </p>
      </div>

      <div class="mt-12 space-y-10">
        {
          SECTIONS.map((s) => (
            <div>
              <h2 class="font-display text-gm-black text-xl font-bold tracking-tight uppercase">
                {s.heading}
              </h2>
              <p class="text-gm-grey-600 mt-3 text-sm leading-relaxed">{s.body}</p>
            </div>
          ))
        }

        <div>
          <h2 class="font-display text-gm-black text-xl font-bold tracking-tight uppercase">
            Contact
          </h2>
          <p class="text-gm-grey-600 mt-3 text-sm leading-relaxed">
            Questions about this policy or your information can be sent to{' '}
            <a
              href="mailto:export@fencing-supplier.com"
              class="text-gm-red underline underline-offset-2"
            >
              export@fencing-supplier.com
            </a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
