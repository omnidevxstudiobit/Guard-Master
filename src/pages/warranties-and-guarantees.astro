---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import { CTA } from '@data/nav';

/**
 * /warranties-and-guarantees — seoguide.md §1: "Warranty-focused H1 (rank
 * for 'fence warranty') — Coverage by finish · What's covered · What voids
 * it · Claim process", and §10: "content-heavy, schema-marked".
 *
 * The one hard number this build has confirmed is the 10-year warranty on
 * Plascoat (businessguide.md §6 — "only the top tier earns our 10-year
 * warranty, because it's the only finish we trust that far"; FinishLadder.astro
 * marks Plascoat alone with a warranty badge). Exact terms for the other
 * three finishes were never given a figure anywhere in the brief, so this
 * page doesn't invent one — it says coverage is shorter-term and confirmed
 * at quote stage, which is true without pretending to a specific number.
 * Same restraint on "what voids it" and "claim process": these describe the
 * general shape (what any manufacturer warranty covers/excludes, the
 * general contact-then-assess flow already implied by the quote-led model)
 * without asserting specific legal exclusion clauses or SLA timeframes that
 * no one has actually confirmed — that's a real legal document the client
 * hasn't supplied, not something to draft from guesswork. Same reasoning
 * for the "downloadable PDF certificate" seoguide.md mentions: no such file
 * exists, so the closing CTA asks for one through the quote flow instead of
 * linking a document that isn't there.
 */

const COVERAGE = [
  {
    id: 'plain',
    name: 'Plain Galvanised',
    tier: 'Entry',
    term: 'Standard manufacturer coverage',
    heightPx: 110,
  },
  {
    id: 'hdg',
    name: 'Hot-Dip Galvanised',
    tier: 'Mid',
    term: 'Standard manufacturer coverage',
    heightPx: 156,
  },
  {
    id: 'powder',
    name: 'Powder Coated',
    tier: 'Mid-Premium',
    term: 'Standard manufacturer coverage',
    heightPx: 202,
  },
  {
    id: 'plascoat',
    name: 'Plascoat / PVC',
    tier: 'Premium',
    term: '10-Year Warranty',
    heightPx: 252,
    highlight: true,
  },
];

const WARRANTY_FAQS = [
  {
    question: "What's covered under the Guard Master warranty?",
    answer:
      'Manufacturing defects in material and workmanship under normal use — coating or galvanizing that fails to perform as specified when the system is installed and maintained as intended.',
  },
  {
    question: 'What voids the warranty?',
    answer:
      'Damage from causes other than a manufacturing defect — impact damage, unauthorized modification, or installation that doesn’t follow our guidance — falls outside coverage. Every system ships with installation guidance for exactly this reason.',
  },
  {
    question: 'How do I make a claim?',
    answer:
      'Contact us with your order details and a description (with photos) of the issue. We assess it against the original specification and confirm next steps directly — there’s no separate claims portal to navigate.',
  },
];
---

<BaseLayout
  title="Fence Warranty: Coverage by Finish | Guard Master"
  description="Guard Master fence warranty by finish — up to 10 years on our Plascoat finish. What's covered, what voids it, and how to file a claim, direct from the manufacturer."
>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Warranties & Guarantees', href: '/warranties-and-guarantees' },
    ]}
  />

  <!-- Header -->
  <section class="bg-gm-white text-gm-black py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Warranty</p>
        <h1
          class="font-display text-gm-black mt-5 text-4xl leading-[0.95] font-black tracking-tight uppercase sm:text-5xl lg:text-6xl"
        >
          The Fence Warranty <span class="text-gm-red">Backed By The Manufacturer</span>
        </h1>
        <p class="text-gm-grey-600 mt-6 max-w-2xl text-base leading-relaxed">
          We make the finish, so we stand behind it — up to 10 years on our top-tier Plascoat
          coating. No reseller passing the claim back to a factory overseas.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href={CTA.href}
            class="tap-target bg-gm-red text-gm-white inline-flex items-center px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
          >
            {CTA.label}
          </a>
          <a
            href="/clear-view-fencing-panels"
            class="tap-target border-gm-grey-300 text-gm-black hover:border-gm-black inline-flex items-center border px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors"
          >
            See Panel Specs
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Coverage by finish — the page's centerpiece. Same staircase technique
       as the homepage's FinishLadder section (height itself argues "better"
       before a word of copy does), built taller here since this page has no
       hero visual competing for the spot: this IS the hero. Bars grow
       scroll-scrubbed via a --growth custom property (never the `height`
       property, so nothing here triggers layout) and default to fully grown
       with no JS/reduced motion, same fallback discipline as the original. -->
  <section class="bg-gm-black text-gm-white relative isolate overflow-hidden py-16 sm:py-20">
    <div
      class="pointer-events-none absolute inset-0 -z-10"
      style="background: radial-gradient(85% 110% at 15% 100%, rgba(228,17,42,0.10), transparent 55%);"
      aria-hidden="true"
    >
    </div>
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Coverage By Finish</p>
      <h2
        class="font-display text-gm-white mt-5 max-w-2xl text-3xl leading-[1.05] font-black tracking-tight uppercase sm:text-4xl"
      >
        The Higher The Finish, The Longer The Cover
      </h2>
      <p class="text-gm-grey-400 mt-6 max-w-2xl text-base leading-relaxed">
        Warranty follows the same finish ladder as everything else — every finish is covered
        against manufacturing defects, and coverage lengthens as you move up it. Plascoat, our
        most weather-resistant finish, is the only one we back for a full 10 years.
      </p>

      <div
        data-warranty-stairs
        class="mt-16 grid grid-cols-2 items-end gap-x-5 gap-y-12 sm:mt-20 lg:flex lg:flex-row lg:gap-10 lg:border-b lg:border-white/12"
      >
        {
          COVERAGE.map((c) => (
            <div
              data-step
              class="flex min-w-0 flex-1 flex-col items-center border-b border-white/12 pb-5 lg:border-b-0 lg:pb-0"
            >
              {c.highlight && (
                <span
                  data-badge
                  class="tap-target bg-gm-red text-gm-white mb-3 inline-flex items-center justify-center rounded-full px-3 py-1.5 text-center text-[10px] leading-tight font-bold tracking-[0.06em] uppercase sm:px-3.5 sm:text-[11px] sm:tracking-[0.08em]"
                >
                  {c.term}
                </span>
              )}
              <div
                data-bar
                class:list={[
                  'w-full max-w-[110px] rounded-t-sm sm:max-w-[130px]',
                  c.highlight ? 'bg-gm-red' : 'bg-gm-grey-700',
                ]}
                style={`height:${c.heightPx}px`}
              />
              <div class="mt-4 text-center">
                <p class="text-gm-grey-500 font-mono text-[10px] tracking-[0.18em] uppercase">
                  {c.tier}
                </p>
                <h3 class="font-display text-gm-white mt-1.5 text-[13px] leading-tight font-bold uppercase sm:text-sm">
                  {c.name}
                </h3>
                {!c.highlight && (
                  <p class="text-gm-grey-500 mt-1.5 max-w-[9rem] text-[12px] leading-snug">
                    {c.term}
                  </p>
                )}
              </div>
            </div>
          ))
        }
      </div>
      <p class="text-gm-grey-500 mt-10 max-w-2xl text-[13px] leading-relaxed lg:mt-14">
        Exact terms for Plain Galvanised, Hot-Dip Galvanised and Powder Coated are confirmed at
        quote stage against your specific site conditions. The 10-year term on Plascoat is fixed.
      </p>
    </div>
  </section>

  <!-- What's covered / voids / claim -->
  <section class="bg-gm-white text-gm-black py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">The Fine Print, Plainly</p>
        <h2
          class="font-display text-gm-black mt-5 text-3xl leading-[1.05] font-black tracking-tight uppercase sm:text-4xl"
        >
          Covered, Excluded, And How To Claim
        </h2>
      </div>

      <div class="border-gm-grey-200 mx-auto mt-12 max-w-3xl divide-y divide-solid">
        {
          WARRANTY_FAQS.map((f) => (
            <div class="border-gm-grey-200 border-t py-7 first:border-t-0">
              <h3 class="font-display text-gm-black text-lg font-bold tracking-tight uppercase">
                {f.question}
              </h3>
              <p class="text-gm-grey-600 mt-3 text-sm leading-relaxed">{f.answer}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Complete the system -->
  <section class="bg-gm-grey-50 text-gm-black py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Complete The System</p>
      <h2
        class="font-display text-gm-black mt-5 max-w-2xl text-3xl leading-[1.05] font-black tracking-tight uppercase sm:text-4xl"
      >
        See What Earns The Warranty
      </h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          [
            {
              name: 'Clear View Panels',
              href: '/clear-view-fencing-panels',
              note: '358 mesh · finish options · 10-yr Plascoat',
            },
            {
              name: 'Clear View Posts',
              href: '/clear-view-fencing-posts',
              note: '6 lengths · reinforced profile',
            },
            {
              name: 'Fixtures & Screws',
              href: '/fixtures-and-screws',
              note: 'Flat or Spider clamp · matched finish',
            },
          ].map((p) => (
            <a
              href={p.href}
              class="tap-target group border-gm-grey-200 hover:border-gm-black block border bg-white p-6 transition-colors"
            >
              <span class="font-display text-gm-black text-lg font-bold tracking-tight uppercase">
                {p.name}
              </span>
              <p class="text-gm-grey-600 mt-2 text-[13px] leading-relaxed">{p.note}</p>
              <span class="text-gm-red mt-4 inline-flex items-center text-[12px] font-bold tracking-[0.08em] uppercase">
                See Options →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="bg-gm-black text-gm-white py-20 text-center sm:py-24">
    <div class="mx-auto max-w-2xl px-6">
      <h2
        class="font-display text-gm-white text-3xl leading-[1.05] font-black tracking-tight uppercase sm:text-4xl"
      >
        Want The Warranty <span class="text-gm-red">In Writing?</span>
      </h2>
      <p class="text-gm-grey-300 mx-auto mt-5 max-w-lg text-base leading-relaxed">
        Request your warranty certificate alongside your quote — it's confirmed against your exact
        spec, not a generic PDF.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/quote-estimator"
          class="tap-target bg-gm-red text-gm-white inline-flex items-center px-7 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
        >
          Request Your Quote & Certificate
        </a>
        <a
          href="/projects"
          class="tap-target text-gm-white hover:border-gm-white inline-flex items-center border border-white/25 px-7 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors"
        >
          See Real Projects
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: WARRANTY_FAQS.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  })}
/>

<style>
  /* Same --growth/--badge-scale technique as the homepage's FinishLadder —
     transform only, never `height`, so growing a bar never triggers layout.
     Fallback of 1 renders each bar at full height with no JS or under
     reduced motion. */
  [data-warranty-stairs] [data-bar] {
    transform: scaleY(var(--growth, 1));
    transform-origin: bottom;
  }
  [data-warranty-stairs] [data-badge] {
    transform: scale(var(--badge-scale, 1));
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-warranty-stairs]');

  const enhance = async () => {
    if (!section) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const [{ gsap }, { ScrollTrigger }] = await Promise.all([
      import('gsap'),
      import('gsap/ScrollTrigger'),
    ]);
    gsap.registerPlugin(ScrollTrigger);

    const steps = gsap.utils.toArray<HTMLElement>('[data-step]', section);

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top 85%',
        end: 'top 25%',
        scrub: 0.5,
      },
    });

    steps.forEach((step, i) => {
      const bar = step.querySelector<HTMLElement>('[data-bar]');
      const badge = step.querySelector<HTMLElement>('[data-badge]');
      const label = step.querySelector<HTMLElement>('div.mt-4');
      const pos = i * 0.85;

      if (bar)
        tl.fromTo(bar, { '--growth': 0 }, { '--growth': 1, duration: 0.9, ease: 'power3.out' }, pos);
      if (label)
        tl.fromTo(
          label,
          { opacity: 0, y: 10 },
          { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' },
          pos + 0.3,
        );
      if (badge)
        tl.fromTo(
          badge,
          { '--badge-scale': 0 },
          { '--badge-scale': 1, duration: 0.45, ease: 'back.out(2.4)' },
          pos + 0.75,
        );
    });
  };

  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => void enhance(), { timeout: 2000 });
  } else {
    setTimeout(() => void enhance(), 200);
  }
</script>
