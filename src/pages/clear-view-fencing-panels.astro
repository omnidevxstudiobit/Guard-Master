---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import ProductHero from '@components/sections/ProductHero.astro';
import FeatureMedallions from '@components/sections/FeatureMedallions.astro';
import PanelSpecDrawing from '@components/sections/PanelSpecDrawing.astro';
import PanelPricing from '@components/sections/PanelPricing.astro';
import PanelGallery from '@components/sections/PanelGallery.astro';
import { CTA } from '@data/nav';
import { formatRand } from '@data/products';
import { PANEL_FROM_EX_VAT } from '@data/clear-view-panels';

/**
 * /clear-view-fencing-panels — the Panels product page.
 *
 * Title/meta description are seoguide.md Appendix A's own ready-to-use
 * strings for this exact page, reused verbatim rather than reworded.
 *
 * Every spec below is a fact already established elsewhere in this codebase
 * (businessguide.md §5, Proof358's preset data, the client's verified spec
 * sheet used in Proof358/IntrusionAttempt/SystemAssembly) — not new numbers
 * invented for this page. Product JSON-LD (Appendix B2) still omits `image`,
 * because no product photo has been chosen as *the* canonical one for this
 * page, but it now carries `offers`: the earlier note here said pricing
 * "lives in a CMS-editable config this build doesn't have access to", which
 * stopped being true once the client's own published price list was read into
 * src/data/clear-view-panels.ts. It is modelled as an AggregateOffer with a
 * `lowPrice`, which is what it honestly is — the lowest of ninety-six
 * configurations, not a flat rate — read from that module rather than typed
 * here, so it cannot drift from the table further down the page.
 *
 * Everything on this page is quoted **ex VAT**, matching the manufacturer's own
 * estimator, and says so wherever a figure appears.
 */

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Clear View Panels (358 Mesh)',
  sku: 'CVP-358',
  description:
    'High-security anti-climb 358 mesh fence panels — 76.2 × 12.7 mm aperture, galvanised to Plascoat finishes, 10-year warranty.',
  brand: { '@type': 'Brand', name: 'Guard Master' },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'ZAR',
    /* Ex VAT, and flagged as such — the same basis the page prints, so the
       rich result can't quote a figure 15% away from the table below it. */
    lowPrice: PANEL_FROM_EX_VAT,
    valueAddedTaxIncluded: false,
    availability: 'https://schema.org/InStock',
    url: new URL('/clear-view-fencing-panels', Astro.site ?? Astro.url.origin).href,
  },
};

/**
 * The three arguments the medallion section makes. Each is a claim this site
 * already makes in prose elsewhere; the drawings demonstrate them rather than
 * introducing anything new.
 */
const FEATURES = [
  {
    variant: 'anti-cut' as const,
    title: 'Anti-Cut',
    body: 'The aperture is narrower than a bolt-cutter jaw can open around a wire — nothing to get a bite on, and no woven strand to pry apart.',
  },
  {
    variant: 'anti-climb' as const,
    title: 'Anti-Climb',
    body: '12.7 mm leaves no fingerhold and no toehold. There is simply nothing on the face of the panel to climb.',
  },
  {
    variant: 'cctv' as const,
    title: 'CCTV Optimised',
    body: 'A clear line of sight straight through the panel, so cameras, lighting and patrols keep the view a solid fence would take away.',
  },
];
---

<BaseLayout
  title="Clear View 358 Mesh Security Fence Panels | Guard Master"
  description="Configure clear view 358 mesh fence panels — aperture, panel size, wire gauge & finish. Anti-climb, galvanized to Plascoat, 10-yr warranty. Add to quote."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />

  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Panels', href: '/clear-view-fencing-panels' },
    ]}
  />

  <ProductHero
    eyebrow="Manufacturer-Direct · Made In Benoni"
    titleLead="Clear View"
    titleMain="358 Mesh Fence Panels."
    blurb="Welded steel mesh you can see straight through and nobody climbs through. Three apertures, four heights, four finishes — cut, welded and coated in our own factory, then sold straight off the floor."
    price={`From ${formatRand(PANEL_FROM_EX_VAT)} per panel, excl. VAT`}
    stats={['76 × 12.7 mm aperture', '3 m × 1.8–3.0 m panels', '500–650 MPa', '10-Year Warranty']}
    primary={{ label: CTA.label, href: CTA.href }}
    secondary={{ label: 'Configure This Panel', href: '/quote-estimator' }}
    sceneLabel="Perspective drawing of a Clear View fence run seen from the end of the line: capped posts carrying 358 welded mesh panels, converging into the distance, with one aperture of the mesh picked out."
  />

  <FeatureMedallions
    eyebrow="Clear View Fencing"
    title="Open Sightline."
    titleAccent="Closed Perimeter."
    intro="A perimeter you can see straight through, that nobody gets through. The 76 × 12.7 mm aperture defeats fingers, footholds and bolt-cutter jaws at the same time as it leaves the view open for cameras, lighting and patrols — fixed with tamper-proof clamps and screws, in green, grey or black."
    features={FEATURES}
  />

  <PanelSpecDrawing />

  <PanelPricing />

  <!-- Long-form copy -->
  <section class="bg-gm-white text-gm-black py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <div class="grid gap-14 lg:grid-cols-[1.05fr_1fr]">
        <div class="max-w-2xl">
          <h2
            class="font-display text-gm-black text-3xl leading-[1.05] font-black tracking-tight uppercase sm:text-4xl"
          >
            What Makes A 358 Panel Different
          </h2>
          <div class="text-gm-grey-700 mt-6 space-y-5 text-base leading-relaxed">
            <p>
              Clear view fencing is a welded mesh perimeter you can see straight through — unlike a
              solid privacy fence, it keeps sightlines open for cameras, lighting and security
              patrols, while the mesh itself stops anyone from climbing or cutting through it. The
              "358" name comes from its dimensions: a welded steel grid with a 76.2 × 12.7 mm
              aperture, engineered so a fingertip, a foothold or a bolt-cutter's jaw simply doesn't
              fit.
            </p>
            <p>
              Every wire is welded at each intersection — not woven, like chain-link — to a weld
              strength of 80% of the parent material, with a tensile strength of 500–650 MPa.
              There's no strand to pry apart and no weave to spread; a welded grid springs back
              under force instead of flexing open.
            </p>
            <p>
              Panels ship in your choice of finish, from base galvanized protection up to our
              Plascoat/PVC top tier — the only finish that carries Guard Master's 10-year warranty.
              Every panel starts life as plain galvanized steel, then is finished in-house to your
              site's spec, so the coating and the substrate underneath it come from the same
              manufacturer, not stitched together from a reseller's mixed-mill parts.
            </p>
            <p>
              Panels are manufactured and dispatched direct from our own factory in Benoni, Gauteng
              — priced in rand, specified in millimetres, and backed by people you can reach on a
              local number. Bulk, trade and export orders leave from the same floor.
            </p>
          </div>
        </div>

        <div>
          <p class="text-gm-grey-500 font-mono text-[11px] tracking-[0.18em] uppercase">
            Finish Ladder
          </p>
          <div class="border-gm-grey-200 mt-4 border-t">
            {
              [
                { name: 'Plain Galvanised', tier: 'Entry', note: 'Base corrosion protection' },
                {
                  name: 'Hot-Dip Galvanised',
                  tier: 'Mid',
                  note: "Heavier galv · posts' default",
                },
                { name: 'Powder Coated', tier: 'Mid-Premium', note: 'Colour + protection' },
                {
                  name: 'Plascoat / PVC',
                  tier: 'Premium',
                  note: 'Our most weather-resistant finish · 10-year warranty',
                },
              ].map((f) => (
                <div class="border-gm-grey-200 border-b py-4">
                  <div class="flex items-baseline justify-between gap-4">
                    <span class="text-gm-black text-sm font-bold uppercase">{f.name}</span>
                    <span class="text-gm-grey-500 font-mono text-[10px] tracking-[0.14em] uppercase">
                      {f.tier}
                    </span>
                  </div>
                  <p class="text-gm-grey-600 mt-1 text-[13px] leading-relaxed">{f.note}</p>
                </div>
              ))
            }
          </div>
          <a
            href="/warranties-and-guarantees"
            class="text-gm-red mt-4 inline-flex items-center text-[13px] font-bold uppercase underline underline-offset-4"
          >
            See the full warranty terms
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Complete the system -->
  <section class="bg-gm-grey-50 text-gm-black py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Complete The System</p>
      <h2
        class="font-display text-gm-black mt-5 max-w-2xl text-3xl leading-[1.05] font-black tracking-tight uppercase sm:text-4xl"
      >
        A Panel Is Only Part Of The System
      </h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          [
            {
              name: 'Clear View Posts',
              href: '/clear-view-fencing-posts',
              note: 'Anti-tamper lip · 3 000 mm centres · HDG, powder or Plascoat',
            },
            {
              name: 'Fixtures & Screws',
              href: '/fixtures-and-screws',
              note: 'Flat or Spider clamp · HDG / powder / PVC',
            },
            {
              name: 'Accessories & Toppings',
              href: '/accessories',
              note: 'Caps, gates, razor & spike topping',
            },
          ].map((p) => (
            <a
              href={p.href}
              class="tap-target group border-gm-grey-200 hover:border-gm-black block border bg-white p-6 transition-colors"
            >
              <span class="font-display text-gm-black text-lg font-bold tracking-tight uppercase">
                {p.name}
              </span>
              <p class="text-gm-grey-600 mt-2 text-[13px] leading-relaxed">{p.note}</p>
              <span class="text-gm-red mt-4 inline-flex items-center text-[12px] font-bold tracking-[0.08em] uppercase">
                See Options →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <PanelGallery />

  <!-- Closing CTA -->
  <section class="bg-gm-black text-gm-white py-20 text-center sm:py-24">
    <div class="mx-auto max-w-2xl px-6">
      <h2
        class="font-display text-gm-white text-3xl leading-[1.05] font-black tracking-tight uppercase sm:text-4xl"
      >
        Configure Your Panels In <span class="text-gm-red">Minutes</span>
      </h2>
      <p class="text-gm-grey-300 mx-auto mt-5 max-w-lg text-base leading-relaxed">
        Set your length, aperture and finish in the instant estimator for a real bill of materials
        and price range.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/quote-estimator"
          class="tap-target bg-gm-red text-gm-white inline-flex items-center px-7 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
        >
          Start Your Estimate
        </a>
        <a
          href="/projects"
          class="tap-target text-gm-white hover:border-gm-white inline-flex items-center border border-white/25 px-7 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors"
        >
          See Real Applications
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
