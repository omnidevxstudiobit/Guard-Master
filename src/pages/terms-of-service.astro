---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';

/**
 * /terms-of-service — same draft-with-a-visible-notice approach as
 * privacy-policy.astro, for the same reason: this is a real legal document
 * the client hasn't supplied, so this build states only what's already
 * confirmed (the estimate is a range, not a binding price, per
 * businessguide.md §7's "excluding freight, installation, groundworks, and
 * subject to survey" disclaimer) and explicitly leaves governing law,
 * dispute resolution and liability limits marked TBD rather than guessing
 * at a jurisdiction or arbitration clause no one has confirmed.
 */

const SECTIONS = [
  {
    heading: 'Use of This Site',
    body: 'This site is provided to help you research, configure and request a quote for a Guard Master fencing system. Nothing on it is intended for any purpose other than that.',
  },
  {
    heading: 'Estimates Are Not Final Pricing',
    body: 'Figures from the quote estimator are a range, excluding freight, installation, and groundworks, and are always subject to survey. A firm quote follows once we\'ve reviewed your specific site and requirements.',
  },
  {
    heading: 'Intellectual Property',
    body: 'The content, design and diagrams on this site belong to Wire Ventures CC t/a Guard Master Fencing Solutions and may not be reproduced without permission.',
  },
  {
    heading: 'Product Warranty',
    body: 'Warranty terms for Guard Master products are covered separately — see our Warranties & Guarantees page, not this document.',
    link: { href: '/warranties-and-guarantees', label: 'Warranties & Guarantees' },
  },
  {
    heading: 'Governing Law & Liability',
    body: "These terms are still being finalized with legal counsel, including which jurisdiction's law governs them and the limits of our liability. This section will be completed before the site treats these terms as binding.",
  },
];
---

<BaseLayout
  title="Terms of Service | Guard Master"
  description="The terms governing use of the Guard Master website, quote estimator and the pricing information it provides."
>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Terms of Service', href: '/terms-of-service' },
    ]}
  />

  <section class="bg-gm-white text-gm-black py-16 sm:py-20">
    <div class="mx-auto max-w-[820px] px-6 lg:px-8">
      <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Legal</p>
      <h1
        class="font-display text-gm-black mt-5 text-4xl leading-[0.95] font-black tracking-tight uppercase sm:text-5xl"
      >
        Terms of Service
      </h1>

      <div class="border-gm-grey-200 bg-gm-grey-50 mt-8 border-l-2 border-l-gm-red p-5">
        <p class="text-gm-grey-700 text-sm leading-relaxed">
          <strong class="text-gm-black">Draft notice:</strong> this page has not yet been reviewed
          by legal counsel. Treat it as an accurate outline of how the site and estimator work, not
          a final, legally binding contract, until that review is complete.
        </p>
      </div>

      <div class="mt-12 space-y-10">
        {
          SECTIONS.map((s) => (
            <div>
              <h2 class="font-display text-gm-black text-xl font-bold tracking-tight uppercase">
                {s.heading}
              </h2>
              <p class="text-gm-grey-600 mt-3 text-sm leading-relaxed">
                {s.body}
                {s.link && (
                  <>
                    {' '}
                    <a href={s.link.href} class="text-gm-red underline underline-offset-2">
                      {s.link.label}
                    </a>
                    .
                  </>
                )}
              </p>
            </div>
          ))
        }

        <div>
          <h2 class="font-display text-gm-black text-xl font-bold tracking-tight uppercase">
            Contact
          </h2>
          <p class="text-gm-grey-600 mt-3 text-sm leading-relaxed">
            Questions about these terms can be sent to{' '}
            <a href="mailto:export@fencing-supplier.com" class="text-gm-red underline underline-offset-2">
              export@fencing-supplier.com
            </a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
