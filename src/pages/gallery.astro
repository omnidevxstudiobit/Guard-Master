---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import RevealFrame from '@components/ui/RevealFrame.astro';
import { ALBUMS } from '@data/products';
import { CTA } from '@data/nav';

/**
 * /gallery — the whole Clear View library, in two albums.
 *
 * Every other image on this site is chosen to make one argument on one page:
 * the profile photograph proves the post is folded, the after-dark renders
 * prove the sightline, the panel mosaic proves the finishes. This page has no
 * argument. It is the library — both source drops shown whole, so someone who
 * just wants to look at the product can, without reading a spec table first.
 *
 * **Composed, not duplicated.** The albums come from `ALBUMS` in
 * src/data/products.ts, which reassembles the manifest by source folder
 * rather than by which page uses what. Nothing is listed twice, and an image
 * added to any product group appears here automatically.
 *
 * **Motion.** This is the one page where the brief's "motion is priority #3"
 * and "heavy" can both be true, because there is nothing here that motion can
 * get in the way of — no prices, no specs, no forms. So it layers three
 * things, in the order animationguide.md allows them:
 *
 *   1. **Hover** — RevealFrame's CSS-only reveal, identical to every other
 *      gallery on the site. No JS, pointer-devices only.
 *   2. **Scroll entrance** — a stagger per album, GSAP + ScrollTrigger,
 *      imported on idle inside this page's island (§2, §3). Frames rest at
 *      full opacity in the DOM and the tween only runs once the library has
 *      loaded, so a failed import leaves a complete, readable page rather
 *      than an invisible one.
 *   3. **Album switching** — CSS only, driven by radio inputs. No JS, no
 *      layout thrash, and every frame of every album stays in the DOM for
 *      crawlers (seoguide.md §0 treats hidden-but-present the same way the
 *      FAQ accordion does).
 *
 * All of it is `transform`/`opacity`, all of it is gated on
 * `prefers-reduced-motion`, and none of it runs on the critical path.
 *
 * CLS is zero: `RevealFrame` reserves each frame's box from `aspect-ratio`
 * before any image data arrives, and the entrance tween never touches layout.
 */

/**
 * The wall's rhythm: every sixth frame runs double-width, everything else is
 * a single 4:3 tile. Deterministic from the index, so server and client agree
 * and the layout is stable between builds.
 *
 * **Width only — no row spans.** The first version varied both, and both
 * failed in the browser. A `row-span-2` tile makes its own two rows size to
 * it while the single tiles beside it stretch to match, so the declared
 * aspect ratios stop meaning anything and the rows go ragged. And a 2-column
 * tile landing with one column left in the row wraps to the next line and
 * leaves a hole — which is exactly what column four showed.
 *
 * So: one row height throughout, and the wide tiles get a ratio that produces
 * that same height at double the width — a single tile is 4:3, a double is
 * two of those plus the gap between them, near enough 8:3. Rows stay level,
 * nothing is cropped harder than a 4:3 crop, and `grid-flow-dense` backfills
 * any gap a wide tile leaves at the end of a row.
 */
const isWide = (i: number): boolean => i % 6 === 2;
const spanFor = (i: number): string => (isWide(i) ? 'sm:col-span-2' : '');
const ratioFor = (i: number): string => (isWide(i) ? '8 / 3' : '4 / 3');

const total = ALBUMS.reduce((n, a) => n + a.images.length, 0);
---

<BaseLayout
  title="Clear View Fencing Gallery | Guard Master"
  description="The full Clear View library — panels, posts, finishes, fixings and finished perimeters. Studio renders, factory photography and site frames from our own drops."
>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Gallery', href: '/gallery' },
    ]}
  />

  <!-- Header -->
  <section class="bg-gm-black text-gm-white py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Gallery</p>
        <h1
          class="font-display text-gm-white mt-5 text-4xl leading-[0.95] font-black tracking-tight uppercase sm:text-5xl lg:text-6xl"
        >
          The Whole Library, <span class="text-gm-red">Nothing Held Back</span>
        </h1>
        <p class="text-gm-grey-400 mt-6 max-w-2xl text-base leading-relaxed">
          {total} frames across two albums — every Clear View image we have, in one place. Studio renders
          where the product needed explaining, our own factory and site photography where it didn't. Hover
          any frame for what it shows.
        </p>
      </div>
    </div>
  </section>

  {
    /* Albums. Radio inputs drive the whole switch in CSS — no JS, and every
      frame of every album stays in the DOM whichever tab is showing. */
  }
  <div data-gallery class="bg-gm-black text-gm-white">
    {
      ALBUMS.map((albumItem, a) => (
        <input
          type="radio"
          name="album"
          id={`album-${albumItem.id}`}
          class="sr-only"
          checked={a === 0}
        />
      ))
    }

    <div class="mx-auto max-w-[1400px] px-6 pb-24 lg:px-8">
      <div
        class="tabs bg-gm-black/85 sticky top-16 z-20 -mx-6 flex flex-wrap gap-2 border-b border-white/10 px-6 py-4 backdrop-blur-md lg:top-20 lg:-mx-8 lg:px-8"
        role="tablist"
        aria-label="Albums"
      >
        {
          ALBUMS.map((albumItem) => (
            <label
              for={`album-${albumItem.id}`}
              data-tab={albumItem.id}
              class="tab tap-target border-gm-grey-800 text-gm-grey-400 hover:text-gm-white inline-flex cursor-pointer items-center border px-5 font-mono text-[11px] font-bold tracking-[0.16em] uppercase transition-colors"
            >
              {albumItem.title}
              <span class="ml-2 opacity-60">{albumItem.images.length}</span>
            </label>
          ))
        }
      </div>

      {
        ALBUMS.map((albumItem) => (
          <section data-album={albumItem.id} class="album pt-12 sm:pt-16">
            <p class="text-gm-grey-400 max-w-2xl text-[13px] leading-relaxed">{albumItem.note}</p>

            <div class="mt-8 grid grid-flow-row-dense grid-cols-1 gap-4 sm:mt-10 sm:grid-cols-2 lg:grid-cols-4">
              {albumItem.images.map((image, i) => (
                <RevealFrame
                  image={image}
                  kicker={`${String(i + 1).padStart(2, '0')} · ${albumItem.title.replace('Clear View ', '')}`}
                  body={image.alt}
                  sizes="(min-width: 1024px) 340px, (min-width: 640px) 50vw, 100vw"
                  ratio={ratioFor(i)}
                  class={`gframe ${spanFor(i)}`}
                />
              ))}
            </div>
          </section>
        ))
      }

      <p class="text-gm-grey-500 mt-12 max-w-2xl text-[11px] leading-relaxed">
        A mix of studio renders, sector visualisations and our own photography. Where a frame is a
        render it is described as what it shows, never as a completed job — the{' '}
        <a href="/projects/clear-fencing" class="text-gm-grey-300 underline underline-offset-2">
          Clear View project page
        </a>{' '}
        separates the two explicitly.
      </p>

      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href={CTA.href}
          class="tap-target bg-gm-red text-gm-white inline-flex items-center px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
        >
          {CTA.label}
        </a>
        <a
          href="/clear-view-fencing-panels"
          class="tap-target text-gm-white hover:border-gm-white inline-flex items-center border border-white/25 px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors"
        >
          Specify A Panel
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* ---- album switching, CSS only ----
     Each radio selects its own album and lights its own tab. Written out per
     album rather than with :nth-child arithmetic so the rule for "album two"
     is legible as exactly that. */
  [data-gallery] .album {
    display: none;
  }
  [data-gallery] #album-panels:checked ~ * [data-album='panels'],
  [data-gallery] #album-posts:checked ~ * [data-album='posts'] {
    display: block;
  }
  [data-gallery] #album-panels:checked ~ * [data-tab='panels'],
  [data-gallery] #album-posts:checked ~ * [data-tab='posts'] {
    border-color: var(--color-gm-red);
    background: var(--color-gm-red);
    color: var(--color-gm-white);
  }
  /* Keyboard focus lands on the visually-hidden radio, so the visible tab has
     to show it — otherwise the control is unusable without a mouse. */
  [data-gallery] input[name='album']:focus-visible ~ * .tab[data-tab],
  [data-gallery] .tab:focus-visible {
    outline: 2px solid var(--color-gm-red);
    outline-offset: 2px;
  }
  [data-gallery] .tab {
    height: 2.5rem;
  }

  /* ---- scroll entrance ----
     Default is fully visible. The script "arms" the wall by adding `is-armed`,
     and only then does anything hide — so no-JS, a failed script and an old
     browser all get a complete page rather than an empty one. */
  [data-gallery].is-armed .gframe {
    opacity: 0;
    transform: translate3d(0, 28px, 0) scale(0.985);
    transition:
      opacity 0.7s cubic-bezier(0.16, 0.84, 0.24, 1),
      transform 0.7s cubic-bezier(0.16, 0.84, 0.24, 1);
    will-change: transform, opacity;
  }
  [data-gallery].is-armed .gframe.is-in {
    opacity: 1;
    transform: none;
    will-change: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-gallery] .gframe {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  /**
   * Staggered entrance, on IntersectionObserver.
   *
   * This was GSAP + `ScrollTrigger.batch` first, and it did not survive
   * contact with the page: 39 of the 42 frames in the open album stayed at
   * opacity 0 through a full scroll. ScrollTrigger measures start/end
   * positions up front, and on a wall of nearly sixty lazy-loaded images
   * inside a `display: none`-switched album those measurements are stale
   * before they are used — every image that decodes moves everything below
   * it, and a `refresh()` at load time is the one moment the numbers are
   * guaranteed to be wrong.
   *
   * IntersectionObserver has no measurements to go stale. The browser
   * recomputes intersection itself as layout changes, tab switches cost
   * nothing (a `display: none` frame simply never intersects, and starts
   * doing so the moment its album is shown, with no listener to wire up),
   * and it is a few lines rather than two library imports on a page whose
   * whole job is loading images quickly.
   *
   * Frames are visible until this runs — the `is-armed` class is what hides
   * them — so a parse error or a browser without IO leaves the wall complete
   * rather than blank.
   */
  const root = document.querySelector<HTMLElement>('[data-gallery]');

  if (
    root &&
    'IntersectionObserver' in window &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    root.classList.add('is-armed');

    const io = new IntersectionObserver(
      (entries) => {
        /* Stagger across whatever arrived together. Capped so that a jump to
           the middle of the page doesn't leave the last tile of a large batch
           waiting three seconds for its turn. */
        let i = 0;
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const frame = entry.target as HTMLElement;
          frame.style.transitionDelay = `${Math.min(i, 7) * 60}ms`;
          frame.classList.add('is-in');
          io.unobserve(frame);
          i += 1;
        }
      },
      /* Fires a little before the frame is fully on screen, so the movement
         is already underway by the time it is properly in view. */
      { rootMargin: '0px 0px -6% 0px', threshold: 0.04 },
    );

    root.querySelectorAll<HTMLElement>('.gframe').forEach((frame) => io.observe(frame));
  }
</script>
