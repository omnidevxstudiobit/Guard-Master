---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import QuoteTracker from '@components/ui/QuoteTracker.astro';

/**
 * /quote-status?ref=GM-XXXXXXX — what a sent quote looks like afterwards.
 *
 * The reference and its contents were frozen into localStorage at submit time
 * (see `submit` in src/lib/quote-cart.ts), so this page can show a customer
 * exactly what they sent, under a number they can quote down the phone.
 *
 * **The tracker's stages are simulated, and both the component and this page
 * say so.** Nothing here is connected to a warehouse; see the note in
 * ui/QuoteTracker.astro for why that gets stated on screen rather than left
 * implicit. The reference number is real in the only sense available to a
 * static site: it identifies the quote in the email the customer just sent.
 *
 * A reference from a different browser can't be found, because there is no
 * server holding it. That case renders as an explanation and a phone number,
 * not an error.
 */
---

<BaseLayout
  title="Quote Status | Guard Master"
  description="Track the progress of your Clear View fencing quote — received, contacted, arranging, packing and delivered."
>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Quote', href: '/quote' },
      { label: 'Status', href: '/quote-status' },
    ]}
  />

  <section class="bg-gm-black text-gm-white py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Quote Sent</p>
      <h1
        class="font-display text-gm-white mt-5 max-w-3xl text-4xl leading-[0.98] font-black tracking-tight uppercase sm:text-5xl"
      >
        Thanks — <span class="text-gm-red">We've Got It.</span>
      </h1>
      <div class="mt-7 flex flex-wrap items-baseline gap-x-8 gap-y-3">
        <p class="font-mono text-sm">
          <span class="text-gm-grey-500 tracking-[0.18em] uppercase">Reference</span>
          <span data-status-ref class="text-gm-white ml-3 text-lg font-bold tracking-[0.06em]"
            >—</span
          >
        </p>
        <p class="text-gm-grey-500 font-mono text-[12px]">
          <span data-status-date></span>
        </p>
      </div>
    </div>
  </section>

  <section class="bg-gm-black text-gm-white border-t border-white/10 py-14 sm:py-16">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <QuoteTracker step={3} />
    </div>
  </section>

  <!-- What was sent. Hidden until the reference resolves. -->
  <section
    data-status-items
    hidden
    class="bg-gm-black text-gm-white border-t border-white/10 pb-20 sm:pb-28"
  >
    <div class="mx-auto max-w-[1400px] px-6 pt-14 lg:px-8">
      <h2 class="font-display text-gm-white text-xl font-black tracking-tight uppercase">
        What You Sent
      </h2>
      <div class="mt-6 -mr-6 overflow-x-auto pr-6 lg:mr-0 lg:pr-0">
        <table class="status-table w-full min-w-[40rem] border-collapse text-left">
          <thead>
            <tr>
              <th scope="col">Item</th>
              <th scope="col" class="num">Each</th>
              <th scope="col" class="num">Qty</th>
              <th scope="col" class="num">Line</th>
            </tr>
          </thead>
          <tbody data-status-body></tbody>
        </table>
      </div>
      <dl class="border-gm-red mt-8 max-w-sm border-t-2 pt-5 font-mono text-sm">
        <div class="flex justify-between gap-8 border-b border-white/10 py-2">
          <dt class="text-gm-grey-400">Total excl. VAT</dt>
          <dd data-status-ex class="text-gm-white tabular-nums">—</dd>
        </div>
        <div class="flex justify-between gap-8 border-b border-white/10 py-2">
          <dt class="text-gm-grey-400">VAT (15%)</dt>
          <dd data-status-vat class="text-gm-white tabular-nums">—</dd>
        </div>
        <div class="flex justify-between gap-8 py-2">
          <dt class="text-gm-white font-bold">Total incl. VAT</dt>
          <dd data-status-incl class="text-gm-red font-bold tabular-nums">—</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- No reference, or one this browser has never seen. -->
  <section
    data-status-missing
    hidden
    class="bg-gm-black text-gm-white border-t border-white/10 pb-20 sm:pb-28"
  >
    <div class="mx-auto max-w-[1400px] px-6 pt-14 lg:px-8">
      <p class="text-gm-grey-300 max-w-2xl text-base leading-relaxed">
        We can't find that reference in this browser. Quotes are stored on the device they were
        created on, so a link opened on another phone or computer won't show its contents — the
        quote itself is safe, it's in the email you sent us.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="tel:+27114378903"
          class="tap-target bg-gm-red text-gm-white inline-flex items-center px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
        >
          Call +27 11 437 8903
        </a>
        <a
          href="/quote"
          class="tap-target text-gm-white hover:border-gm-white inline-flex items-center border border-white/25 px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors"
        >
          Start A New Quote
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .status-table th,
  .status-table td {
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    padding: 0.8rem 1rem 0.8rem 0;
    vertical-align: baseline;
  }
  .status-table thead th {
    border-bottom-color: rgb(255 255 255 / 0.22);
    color: var(--color-gm-grey-500);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .status-table .num {
    padding-right: 0;
    padding-left: 1rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .status-table tbody td {
    color: var(--color-gm-white);
    font-size: 13px;
  }
  .status-table .item-group {
    display: block;
    color: var(--color-gm-red);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .status-table .item-detail {
    display: block;
    margin-top: 0.2rem;
    color: var(--color-gm-grey-500);
    font-size: 11px;
  }
</style>

<script>
  import { readSubmission, totals, rand } from '@/lib/quote-cart';

  const ref = new URLSearchParams(location.search).get('ref') ?? '';
  const submission = ref ? readSubmission(ref) : null;

  const refEl = document.querySelector<HTMLElement>('[data-status-ref]');
  const dateEl = document.querySelector<HTMLElement>('[data-status-date]');
  const itemsEl = document.querySelector<HTMLElement>('[data-status-items]');
  const missingEl = document.querySelector<HTMLElement>('[data-status-missing]');
  const bodyEl = document.querySelector<HTMLElement>('[data-status-body]');

  if (refEl) refEl.textContent = ref || 'Not supplied';

  if (submission && bodyEl && itemsEl) {
    itemsEl.hidden = false;

    if (dateEl && submission.at) {
      const d = new Date(submission.at);
      dateEl.textContent = Number.isNaN(d.getTime())
        ? ''
        : `Sent ${d.toLocaleDateString('en-ZA', { day: 'numeric', month: 'long', year: 'numeric' })}`;
    }

    bodyEl.replaceChildren(
      ...submission.lines.map((l) => {
        const tr = document.createElement('tr');

        const th = document.createElement('th');
        th.setAttribute('scope', 'row');
        const group = document.createElement('span');
        group.className = 'item-group';
        group.textContent = l.group;
        th.append(group, document.createTextNode(l.label));
        if (l.detail) {
          const detail = document.createElement('span');
          detail.className = 'item-detail';
          detail.textContent = l.detail;
          th.append(detail);
        }

        const cell = (text: string) => {
          const td = document.createElement('td');
          td.className = 'num';
          td.textContent = text;
          return td;
        };

        tr.append(
          th,
          cell(rand(l.unitEx)),
          cell(String(l.qty)),
          cell(rand(Math.round(l.unitEx * l.qty * 100) / 100)),
        );
        return tr;
      }),
    );

    const t = totals(submission.lines);
    const set = (sel: string, v: string) => {
      const el = document.querySelector<HTMLElement>(sel);
      if (el) el.textContent = v;
    };
    set('[data-status-ex]', rand(t.ex));
    set('[data-status-vat]', rand(t.vat));
    set('[data-status-incl]', rand(t.incl));
  } else if (missingEl) {
    missingEl.hidden = false;
  }
</script>
