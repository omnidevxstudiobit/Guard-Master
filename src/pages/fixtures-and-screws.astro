---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import { CTA } from '@data/nav';

/**
 * /fixtures-and-screws — the fixings product page.
 *
 * Real facts only, per businessguide.md §5: two clamp systems (Flat Clamp
 * Kit, Spider Clamps), each available in the same three finishes as the rest
 * of the system. No fastener counts, torque specs or part numbers are
 * invented — those live in a spec sheet this build has no access to.
 */

const CLAMPS = [
  {
    id: 'flat',
    name: 'Flat Clamp Kit',
    caption: 'One post · one straight run',
    note: 'A flat bar clamp bolted through the post’s clamp securing slots — the standard fixture for straight panel runs.',
  },
  {
    id: 'spider',
    name: 'Spider Clamps',
    caption: 'One post · multiple runs meet here',
    note: 'A multi-arm clamp for corner and junction posts, where more than one panel run meets the same post.',
  },
];

const FINISHES = ['Hot-Dip Galvanised', 'Powder Coated', 'PVC'];
---

<BaseLayout
  title="Fence Fixtures & Clamps | Guard Master"
  description="Guard Master fixings: Flat Clamp Kits for straight runs and Spider Clamps for corners and junctions, each in HDG, Powder Coated or PVC finish."
>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Fixtures & Screws', href: '/fixtures-and-screws' },
    ]}
  />

  <!-- Header -->
  <section class="bg-gm-white text-gm-black py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Fixtures</p>
        <h1
          class="font-display text-gm-black mt-5 text-4xl leading-[0.95] font-black tracking-tight uppercase sm:text-5xl lg:text-6xl"
        >
          The Part That Holds <span class="text-gm-red">Everything Else Together</span>
        </h1>
        <p class="text-gm-grey-600 mt-6 max-w-2xl text-base leading-relaxed">
          A panel and a post are only as strong as what clamps them together. Two clamp systems
          cover every configuration on a Guard Master run — straight sections and corners — each
          finished to match the rest of your system.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href={CTA.href}
            class="tap-target bg-gm-red text-gm-white inline-flex items-center px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
          >
            {CTA.label}
          </a>
          <a
            href="/quote-estimator"
            class="tap-target border-gm-grey-300 text-gm-black hover:border-gm-black inline-flex items-center border px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors"
          >
            Configure Your System
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Clamp systems — an interactive site-plan diagram (same post-dot /
       red-run visual language as ProjectsShowcase and the new Projects page,
       reused here since a clamp's whole job is defined by how many runs
       meet at its post) replaces a plain two-card text grid. Two predefined
       states swapped by id on toggle, same technique as the Panels page's
       aperture tool — not a claim about the clamp's own physical shape
       (never confirmed anywhere), just the real, already-stated fact that a
       Flat Clamp holds one straight run and a Spider Clamp holds several
       meeting at one post. -->
  <section data-clamp-tool data-active="flat" class="bg-gm-black text-gm-white py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Two Systems</p>
      <h2
        class="font-display text-gm-white mt-5 max-w-2xl text-3xl leading-[1.05] font-black tracking-tight uppercase sm:text-4xl"
      >
        Straight Runs. Corners. Covered.
      </h2>

      <div class="mt-12 grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:items-start lg:gap-14">
        <div class="rounded-md border border-white/10 bg-[#0c0c0e] p-6">
          <svg
            viewBox="0 0 400 260"
            class="block h-auto w-full"
            role="img"
            aria-label="Site-plan diagram of the selected clamp system at a post"
          >
            <g stroke="rgba(255,255,255,0.05)" stroke-width="1">
              {[40, 120, 200, 280, 360].map((x) => <line x1={x} y1="0" x2={x} y2="260" />)}
              {[40, 90, 130, 170, 220].map((y) => <line x1="0" y1={y} x2="400" y2={y} />)}
            </g>

            <!-- Flat Clamp: one straight run through the post -->
            <g data-clamp="flat" class="clamp-detail">
              <path d="M30,130 H370" fill="none" stroke="#e4112a" stroke-width="2.5"></path>
              <circle cx="30" cy="130" r="3.2" fill="#161616" stroke="#e4112a" stroke-width="1.4"></circle>
              <circle cx="370" cy="130" r="3.2" fill="#161616" stroke="#e4112a" stroke-width="1.4"></circle>
              <rect x="192" y="118" width="16" height="24" rx="1.5" fill="#161616" stroke="#f4f4f4" stroke-width="2"></rect>
              <circle cx="200" cy="130" r="5" fill="#161616" stroke="#f4f4f4" stroke-width="2"></circle>
            </g>

            <!-- Spider Clamp: three runs meeting at a junction post -->
            <g data-clamp="spider" class="clamp-detail hidden">
              <path d="M200,130 L40,130 M200,130 L340,55 M200,130 L340,210" fill="none" stroke="#e4112a" stroke-width="2.5"></path>
              <circle cx="40" cy="130" r="3.2" fill="#161616" stroke="#e4112a" stroke-width="1.4"></circle>
              <circle cx="340" cy="55" r="3.2" fill="#161616" stroke="#e4112a" stroke-width="1.4"></circle>
              <circle cx="340" cy="210" r="3.2" fill="#161616" stroke="#e4112a" stroke-width="1.4"></circle>
              <circle cx="200" cy="130" r="7" fill="#161616" stroke="#f4f4f4" stroke-width="2"></circle>
              <circle cx="200" cy="130" r="2" fill="#f4f4f4"></circle>
            </g>
          </svg>
          <p data-clamp-caption class="text-gm-grey-500 mt-5 text-center font-mono text-[11px] tracking-[0.1em] uppercase">
            One post · one straight run
          </p>
        </div>

        <div class="border-t border-white/12 pt-6 lg:border-t-0 lg:pt-0">
          <div class="grid grid-cols-2 gap-2" role="group" aria-label="Choose a clamp system">
            {
              CLAMPS.map((c, i) => (
                <button
                  type="button"
                  data-clamp-btn={c.id}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  class="clamp-btn tap-target rounded-sm border px-3 py-2.5 text-[12px] font-bold tracking-tight uppercase transition-colors"
                >
                  {c.name}
                </button>
              ))
            }
          </div>

          {
            CLAMPS.map((c, i) => (
              <div data-clamp-note={c.id} class:list={['mt-5', i !== 0 && 'hidden']}>
                <h3 class="font-display text-gm-white text-lg font-bold tracking-tight uppercase">{c.name}</h3>
                <p class="text-gm-grey-400 mt-2.5 text-sm leading-relaxed">{c.note}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
    <script is:inline type="application/json" data-clamps set:html={JSON.stringify(CLAMPS)} />
  </section>

  <!-- Finish options -->
  <section class="bg-gm-white text-gm-black py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <div class="grid gap-14 lg:grid-cols-[1fr_1fr] lg:items-center">
        <div>
          <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Finish</p>
          <h2
            class="font-display text-gm-black mt-5 text-3xl leading-[1.05] font-black tracking-tight uppercase sm:text-4xl"
          >
            Matched, <span class="text-gm-red">Not Mismatched</span>
          </h2>
          <p class="text-gm-grey-600 mt-6 max-w-xl text-base leading-relaxed">
            Both clamp systems ship in Hot-Dip Galvanised, Powder Coated or PVC — the same finish
            options as the posts and panels they hold. Order fixtures in the finish that matches
            your panels and posts, and the whole run reads as one built system, not parts sourced
            from three different suppliers.
          </p>
        </div>
        <div class="border-gm-grey-200 bg-gm-grey-50 p-8">
          <p class="text-gm-grey-500 font-mono text-[11px] tracking-[0.18em] uppercase">
            Fixture Finish Options
          </p>
          <ul class="text-gm-grey-700 mt-4 space-y-3 text-sm">
            {
              FINISHES.map((f) => (
                <li class="border-gm-grey-200 border-b pb-3 font-bold last:border-b-0 last:pb-0">
                  {f}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Complete the system -->
  <section class="bg-gm-grey-50 text-gm-black py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Complete The System</p>
      <h2
        class="font-display text-gm-black mt-5 max-w-2xl text-3xl leading-[1.05] font-black tracking-tight uppercase sm:text-4xl"
      >
        Fixtures Need A Post And A Panel
      </h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          [
            {
              name: 'Clear View Panels',
              href: '/clear-view-fencing-panels',
              note: '358 mesh · 3 apertures · sized to your run',
            },
            {
              name: 'Clear View Posts',
              href: '/clear-view-fencing-posts',
              note: '6 lengths · reinforced profile',
            },
            {
              name: 'Accessories & Toppings',
              href: '/accessories',
              note: 'Caps, gates, razor & spike topping',
            },
          ].map((p) => (
            <a
              href={p.href}
              class="tap-target group border-gm-grey-200 hover:border-gm-black block border bg-white p-6 transition-colors"
            >
              <span class="font-display text-gm-black text-lg font-bold tracking-tight uppercase">
                {p.name}
              </span>
              <p class="text-gm-grey-600 mt-2 text-[13px] leading-relaxed">{p.note}</p>
              <span class="text-gm-red mt-4 inline-flex items-center text-[12px] font-bold tracking-[0.08em] uppercase">
                See Options →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="bg-gm-black text-gm-white py-20 text-center sm:py-24">
    <div class="mx-auto max-w-2xl px-6">
      <h2
        class="font-display text-gm-white text-3xl leading-[1.05] font-black tracking-tight uppercase sm:text-4xl"
      >
        One Quote, <span class="text-gm-red">The Whole System</span>
      </h2>
      <p class="text-gm-grey-300 mx-auto mt-5 max-w-lg text-base leading-relaxed">
        Panels, posts and fixtures priced together in the estimator — matched finish, no
        guesswork.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/quote-estimator"
          class="tap-target bg-gm-red text-gm-white inline-flex items-center px-7 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
        >
          Start Your Estimate
        </a>
        <a
          href="/projects"
          class="tap-target text-gm-white hover:border-gm-white inline-flex items-center border border-white/25 px-7 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors"
        >
          See Real Projects
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  [data-clamp-tool] .clamp-btn {
    border-color: #35353d;
    background: transparent;
    color: var(--color-gm-grey-300);
    line-height: 1.2;
  }
  [data-clamp-tool] .clamp-btn[aria-pressed='true'] {
    border-color: var(--color-gm-red);
    background: var(--color-gm-red);
    color: var(--color-gm-white);
  }

  /* Same redraw pulse as the Panels page's aperture tool, so both
     configurators on the site feel like one system. */
  [data-clamp-tool] .clamp-detail {
    transform-origin: center;
    transition:
      opacity 0.24s ease,
      transform 0.24s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  [data-clamp-tool].is-redrawing .clamp-detail:not(.hidden) {
    opacity: 0.35;
    transform: scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-clamp-tool] .clamp-detail {
      transition: none;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-clamp-tool]');

  if (section) {
    const dataEl = document.querySelector<HTMLScriptElement>('[data-clamps]');
    const clamps = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
    const byId = new Map(clamps.map((c: { id: string }) => [c.id, c]));

    const buttons = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-clamp-btn]'));
    const details = Array.from(section.querySelectorAll<SVGGElement>('.clamp-detail'));
    const notes = Array.from(section.querySelectorAll<HTMLElement>('[data-clamp-note]'));
    const caption = section.querySelector<HTMLElement>('[data-clamp-caption]');

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let redrawTimer = 0;

    const paint = (id: string) => {
      details.forEach((g) => g.classList.toggle('hidden', g.dataset.clamp !== id));
      notes.forEach((n) => n.classList.toggle('hidden', n.dataset.clampNote !== id));
      const c = byId.get(id) as { caption: string } | undefined;
      if (caption && c) caption.textContent = c.caption;
    };

    const setActive = (id: string, animate: boolean) => {
      if (!byId.has(id)) return;

      if (!animate || reduce) {
        paint(id);
      } else {
        clearTimeout(redrawTimer);
        section.classList.add('is-redrawing');
        redrawTimer = window.setTimeout(() => {
          paint(id);
          section.classList.remove('is-redrawing');
        }, 150);
      }

      section.dataset.active = id;
      buttons.forEach((b) => b.setAttribute('aria-pressed', b.dataset.clampBtn === id ? 'true' : 'false'));
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => b.dataset.clampBtn && setActive(b.dataset.clampBtn, true)),
    );
  }
</script>
