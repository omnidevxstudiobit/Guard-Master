---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import { CTA } from '@data/nav';

/**
 * /clear-view-fencing-posts — the Posts product page.
 *
 * Title/meta description follow seoguide.md Appendix A's format for the
 * Panels page (no Posts example is given there, so this matches its pattern
 * rather than inventing an unrelated style).
 *
 * Every spec is a real, already-established fact: lengths/finish/auto-suggest
 * from businessguide.md §5; center spacing and embedded height from the
 * client's verified spec sheet (same source as SystemAssembly.astro's post
 * cutaway, built earlier this session). The cutaway below reuses that
 * diagram's exact geometry (same coordinates, same six labelled features) —
 * this page is where the post is the whole story, so it earns a bigger,
 * scroll-animated version rather than the homepage's compact static one,
 * extended with the embedment/grade detail the homepage version has no room
 * for. The FEATURES text grid further down repeats the same six facts in
 * prose — the diagram is `hidden lg:block` like every other cutaway in this
 * build, so the text carries the content on narrower viewports.
 */

const LENGTHS = [
  { us: '6 ft', metric: '1.8 m' },
  { us: '7 ft', metric: '2.1 m' },
  { us: '8 ft', metric: '2.4 m' },
  { us: '10 ft', metric: '3.0 m' },
  { us: '12 ft', metric: '3.6 m' },
];

const FEATURES = [
  { name: 'Reinforcing Rib', note: 'A fold-over rib profile down the shaft — stiffness without extra wall thickness.' },
  { name: 'Anti-Tamper Protection Lip', note: 'A folded edge near the top of the shaft that resists prying at the fixture line.' },
  { name: 'Anti-Push System Lip', note: 'A second folded edge lower down, resisting lateral force against the panel face.' },
  { name: 'Mesh Securing Teeth', note: 'Formed into the post edge at regular intervals — the panel locks in without a separate bracket at every point.' },
  { name: 'Clamp Securing Slots', note: 'Adjustable slots for the fixture clamps, so panel height can be fine-tuned on site.' },
  { name: 'Solar Post Cap', note: 'Front and back lights, standard on the accessory cap — see Accessories for the full spec.' },
];

const SPEC_ROWS = [
  { label: 'Center-to-center spacing', value: '3,000 mm (~9.8 ft)' },
  { label: 'Embedded height (600 mm below grade)', value: '2,400 / 2,700 / 3,000 / 3,600 mm' },
  { label: 'Default finish', value: 'Hot-Dip Galvanised' },
];
---

<BaseLayout
  title="Clear View 358 Fence Posts | Guard Master"
  description="Guard Master Clear View posts — 6 lengths from 6–12 ft, reinforcing ribs, anti-tamper and anti-push lips, mesh securing teeth. Manufacturer-direct, US shipping."
>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Posts', href: '/clear-view-fencing-posts' },
    ]}
  />

  <!-- Header -->
  <section class="bg-gm-white text-gm-black py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Clear View Posts</p>
        <h1
          class="font-display text-gm-black mt-5 text-4xl leading-[0.95] font-black tracking-tight uppercase sm:text-5xl lg:text-6xl"
        >
          Engineered Posts, <span class="text-gm-red">Not Just Cut To Length</span>
        </h1>
        <p class="text-gm-grey-600 mt-6 max-w-2xl text-base leading-relaxed">
          Six real lengths, a folded profile with built-in stiffening ribs, and a set of features
          most resellers never mention because they didn't engineer the post — they bought it from
          whoever was cheapest that month.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href={CTA.href}
            class="tap-target bg-gm-red text-gm-white inline-flex items-center px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
          >
            {CTA.label}
          </a>
          <a
            href="/quote-estimator"
            class="tap-target border-gm-grey-300 text-gm-black hover:border-gm-black inline-flex items-center border px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors"
          >
            Configure Your System
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Lengths + spacing -->
  <section class="bg-gm-black text-gm-white py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Sizing</p>
      <h2
        class="font-display text-gm-white mt-5 max-w-2xl text-3xl leading-[1.05] font-black tracking-tight uppercase sm:text-4xl"
      >
        Six Lengths. One Spacing.
      </h2>

      <div class="mt-10 grid gap-x-14 gap-y-10 lg:grid-cols-[1fr_1fr]">
        <div>
          <p class="text-gm-grey-400 font-mono text-[11px] tracking-[0.18em] uppercase">
            Post Lengths
          </p>
          <div class="border-gm-grey-800 mt-4 border-t">
            {
              LENGTHS.map((l) => (
                <div class="border-gm-grey-800 flex items-baseline justify-between border-b py-3.5">
                  <span class="text-gm-white text-sm font-bold">{l.us}</span>
                  <span class="text-gm-grey-500 font-mono text-[12px]">{l.metric}</span>
                </div>
              ))
            }
          </div>
          <p class="text-gm-grey-500 mt-4 text-[13px] leading-relaxed">
            Post height auto-suggests from your panel height in the estimator — you're never
            guessing which length pairs with which panel.
          </p>
        </div>

        <div class="border-gm-grey-800 border-t pt-4 lg:border-t-0 lg:pt-0">
          {
            SPEC_ROWS.map((row) => (
              <div class="border-gm-grey-800 flex items-baseline justify-between gap-6 border-b py-4">
                <span class="text-gm-grey-400 font-mono text-[11px] tracking-[0.14em] uppercase">
                  {row.label}
                </span>
                <span class="text-gm-white text-right text-sm font-bold">{row.value}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Feature breakdown -->
  <section class="bg-gm-white text-gm-black py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">
          What's Actually In The Profile
        </p>
        <h2
          class="font-display text-gm-black mt-5 text-3xl leading-[1.05] font-black tracking-tight uppercase sm:text-4xl"
        >
          Every Feature, Named
        </h2>
        <p class="text-gm-grey-600 mx-auto mt-6 max-w-xl text-base leading-relaxed">
          A post is a folded steel profile, not a plain tube — every fold does a specific job.
          These are the real features on the Guard Master post, from our own spec sheet.
        </p>
      </div>

      <!-- Cutaway — the bigger, scroll-animated sibling of SystemAssembly's
           homepage diagram. Same geometry (cap, shaft, rib, teeth, slot,
           lips), extended below the shaft with the grade line and embedment
           detail that diagram had no room for. Hidden below `lg` for the
           same reason as every other cutaway in this build: the wide aspect
           ratio compresses enough at narrower widths that seven labels
           would crowd their own leader lines, and the FEATURES grid below
           already carries the full content on its own. -->
      <div data-post-cutaway class="relative mx-auto mt-14 hidden aspect-[640/460] w-full max-w-4xl lg:mt-16 lg:block">
        <svg
          viewBox="0 0 640 460"
          class="h-full w-full"
          role="img"
          aria-label="Cutaway of a Clear View post showing the reinforcing rib, anti-tamper and anti-push lips, mesh securing teeth, clamp securing slots, solar cap, and embedment depth below grade"
        >
          <!-- cap + solar lights -->
          <rect x="295" y="20" width="50" height="26" rx="3" fill="#f7f7f7" stroke="#161616" stroke-width="2"></rect>
          <circle cx="309" cy="33" r="2.5" fill="#e4112a"></circle>
          <circle cx="331" cy="33" r="2.5" fill="#e4112a"></circle>

          <!-- shaft, above grade -->
          <rect x="305" y="46" width="30" height="290" fill="#f7f7f7" stroke="#161616" stroke-width="2"></rect>

          <!-- reinforcing rib + fold-over rib -->
          <line x1="320" y1="55" x2="320" y2="325" stroke="#9a9a9a" stroke-width="1.5"></line>
          <line x1="312" y1="55" x2="312" y2="325" stroke="#c9c9c9" stroke-width="1.2"></line>

          <!-- mesh securing teeth, right edge -->
          {
            [100, 140, 180, 220, 260, 300].map((y) => (
              <path d={`M335 ${y - 5} L343 ${y} L335 ${y + 5} Z`} fill="#161616" />
            ))
          }

          <!-- clamp securing slot -->
          <rect x="308" y="175" width="16" height="8" rx="1" fill="none" stroke="#161616" stroke-width="1.2"></rect>

          <!-- anti-tamper lip (upper) + anti-push lip (lower), left edge -->
          <path d="M305 74 H296 V84 H305" fill="none" stroke="#161616" stroke-width="1.6"></path>
          <path d="M305 244 H296 V254 H305" fill="none" stroke="#161616" stroke-width="1.6"></path>

          <!-- leader lines, each independently scroll-drawn -->
          <path class="draw" pathLength="100" d="M331 33 H420" fill="none" stroke="#c9c9c9" stroke-width="1"></path>
          <path class="draw" pathLength="100" d="M296 79 H60" fill="none" stroke="#c9c9c9" stroke-width="1"></path>
          <path class="draw" pathLength="100" d="M316 150 H440" fill="none" stroke="#c9c9c9" stroke-width="1"></path>
          <path class="draw" pathLength="100" d="M308 179 H60" fill="none" stroke="#c9c9c9" stroke-width="1"></path>
          <path class="draw" pathLength="100" d="M296 249 H440" fill="none" stroke="#c9c9c9" stroke-width="1"></path>
          <path class="draw" pathLength="100" d="M338 220 H60" fill="none" stroke="#c9c9c9" stroke-width="1"></path>

          <!-- grade line + soil hatching -->
          <line x1="40" y1="340" x2="600" y2="340" stroke="#161616" stroke-width="2" stroke-dasharray="7 4"></line>
          {
            [60, 100, 140, 180, 220, 260, 300, 340, 380, 420, 460, 500, 540, 580].map((x) => (
              <line x1={x} y1="344" x2={x - 10} y2="357" stroke="#4a4a4a" stroke-width="1.2" />
            ))
          }

          <!-- buried portion of the shaft — dashed, since it's hidden below grade -->
          <rect x="305" y="336" width="30" height="58" fill="#eeeeee" stroke="#8a8a8a" stroke-width="1.6" stroke-dasharray="4 3"></rect>

          <!-- embedment dimension bracket + leader -->
          <path d="M408 340 H420 M408 394 H420" fill="none" stroke="#9a9a9a" stroke-width="1.4"></path>
          <path d="M420 340 V394" fill="none" stroke="#9a9a9a" stroke-width="1.4"></path>
          <path class="draw" pathLength="100" d="M420 367 H480" fill="none" stroke="#c9c9c9" stroke-width="1"></path>
        </svg>

        {
          [
            { top: '6.2%', left: '65.6%', align: 'left', text: 'Solar Cap · Front & Back Lights' },
            { top: '14.5%', left: '9.4%', align: 'right', text: 'Anti-Tamper Protection Lip' },
            { top: '31%', left: '68.75%', align: 'left', text: 'Reinforcing Rib · Fold-Over Design' },
            { top: '37.2%', left: '9.4%', align: 'right', text: 'Clamp Securing Slots' },
            { top: '51.7%', left: '68.75%', align: 'left', text: 'Anti-Push System Lip' },
            { top: '45.7%', left: '9.4%', align: 'right', text: 'Mesh Securing Teeth' },
            { top: '80%', left: '75%', align: 'left', text: '600 mm (24 in) Embedment Below Grade' },
          ].map((l) => (
            <p
              class="cutaway-label text-gm-grey-600 font-mono absolute max-w-[10rem] text-[10px] leading-tight tracking-[0.08em] uppercase"
              style={`top:${l.top}; left:${l.left}; text-align:${l.align}; transform: translateY(-50%);`}
              aria-hidden="true"
            >
              {l.text}
            </p>
          ))
        }
        <p
          class="text-gm-grey-400 font-mono absolute text-[9px] tracking-[0.14em] uppercase"
          style="left: 3%; top: 71%;"
          aria-hidden="true"
        >
          Grade
        </p>
      </div>

      <div class="border-gm-grey-200 mt-12 grid gap-x-10 gap-y-10 border-t pt-10 sm:grid-cols-2 sm:gap-x-14 sm:gap-y-12 sm:pt-12 lg:grid-cols-3">
        {
          FEATURES.map((f) => (
            <div>
              <h3 class="font-display text-gm-black text-base font-bold tracking-tight uppercase">
                {f.name}
              </h3>
              <p class="text-gm-grey-600 mt-2 text-[13px] leading-relaxed">{f.note}</p>
            </div>
          ))
        }
      </div>

      <p class="text-gm-grey-500 mt-10 max-w-2xl text-sm leading-relaxed">
        Every layer of the perimeter is engineered in-house to fit the one before it — post, panel,
        fixture and cap, made together and shipped together. See how the post fits the rest of the
        chain on the <a href="/#built-for" class="text-gm-red underline underline-offset-2">homepage's system overview</a>,
        or configure your exact spec in the estimator.
      </p>
    </div>
  </section>

  <!-- Finish options -->
  <section class="bg-gm-grey-50 text-gm-black py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <div class="grid gap-14 lg:grid-cols-[1fr_1fr] lg:items-center">
        <div>
          <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Finish</p>
          <h2
            class="font-display text-gm-black mt-5 text-3xl leading-[1.05] font-black tracking-tight uppercase sm:text-4xl"
          >
            Hot-Dip Galvanised, <span class="text-gm-red">By Default</span>
          </h2>
          <p class="text-gm-grey-600 mt-6 max-w-xl text-base leading-relaxed">
            Posts ship Hot-Dip Galvanised as standard — the heavier-galv finish built for the
            structural load a post actually carries. Powder Coated and Plascoat Zam310 are both
            available where the site calls for it, matched to your panel finish so the whole system
            reads as one coherent build, not mismatched parts.
          </p>
        </div>
        <div class="border-gm-grey-200 bg-white p-8">
          <p class="text-gm-grey-500 font-mono text-[11px] tracking-[0.18em] uppercase">
            Post Finish Options
          </p>
          <ul class="text-gm-grey-700 mt-4 space-y-3 text-sm">
            <li class="border-gm-grey-200 flex items-center justify-between border-b pb-3">
              <span class="font-bold">Hot-Dip Galvanised</span>
              <span class="text-gm-grey-500 font-mono text-[11px] uppercase">Default</span>
            </li>
            <li class="border-gm-grey-200 flex items-center justify-between border-b pb-3">
              <span class="font-bold">Powder Coated</span>
              <span class="text-gm-grey-500 font-mono text-[11px] uppercase">Optional</span>
            </li>
            <li class="flex items-center justify-between">
              <span class="font-bold">Plascoat Zam310</span>
              <span class="text-gm-grey-500 font-mono text-[11px] uppercase">Optional</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Complete the system -->
  <section class="bg-gm-white text-gm-black py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Complete The System</p>
      <h2
        class="font-display text-gm-black mt-5 max-w-2xl text-3xl leading-[1.05] font-black tracking-tight uppercase sm:text-4xl"
      >
        A Post Needs A Panel
      </h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          [
            {
              name: 'Clear View Panels',
              href: '/clear-view-fencing-panels',
              note: '358 mesh · 3 apertures · sized to your run',
            },
            {
              name: 'Fixtures & Screws',
              href: '/fixtures-and-screws',
              note: 'Flat or Spider clamp · HDG / powder / PVC',
            },
            {
              name: 'Accessories & Toppings',
              href: '/accessories',
              note: 'Caps, gates, razor & spike topping',
            },
          ].map((p) => (
            <a
              href={p.href}
              class="tap-target group border-gm-grey-200 hover:border-gm-black block border p-6 transition-colors"
            >
              <span class="font-display text-gm-black text-lg font-bold tracking-tight uppercase">
                {p.name}
              </span>
              <p class="text-gm-grey-600 mt-2 text-[13px] leading-relaxed">{p.note}</p>
              <span class="text-gm-red mt-4 inline-flex items-center text-[12px] font-bold tracking-[0.08em] uppercase">
                See Options →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="bg-gm-black text-gm-white py-20 text-center sm:py-24">
    <div class="mx-auto max-w-2xl px-6">
      <h2
        class="font-display text-gm-white text-3xl leading-[1.05] font-black tracking-tight uppercase sm:text-4xl"
      >
        Get The Right Post <span class="text-gm-red">On The First Try</span>
      </h2>
      <p class="text-gm-grey-300 mx-auto mt-5 max-w-lg text-base leading-relaxed">
        The estimator auto-suggests post length and finish from your panel choice — no separate
        spec sheet to cross-reference.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/quote-estimator"
          class="tap-target bg-gm-red text-gm-white inline-flex items-center px-7 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
        >
          Start Your Estimate
        </a>
        <a
          href="/warranties-and-guarantees"
          class="tap-target text-gm-white hover:border-gm-white inline-flex items-center border border-white/25 px-7 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors"
        >
          See The Warranty
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* pathLength="100" normalises stroke-dasharray/dashoffset for every leader
     regardless of its actual length — same technique as SystemAssembly's
     `.draw` icons and ProjectsShowcase's perimeter lines. Default is fully
     drawn (dashoffset 0) for no-JS / reduced motion. */
  [data-post-cutaway] .draw {
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-post-cutaway] .cutaway-label {
      opacity: 1 !important;
      transform: translateY(-50%) !important;
    }
  }
</style>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-post-cutaway]');

  const enhance = async () => {
    if (!wrap) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const [{ gsap }, { ScrollTrigger }] = await Promise.all([
      import('gsap'),
      import('gsap/ScrollTrigger'),
    ]);
    gsap.registerPlugin(ScrollTrigger);

    const draws = gsap.utils.toArray<SVGPathElement>('.draw', wrap);
    const labels = gsap.utils.toArray<HTMLElement>('.cutaway-label', wrap);

    gsap.set(labels, { opacity: 0 });

    /* Each of the seven callouts (six post features + the embedment
       bracket) draws in turn as the diagram scrolls past — not pinned, tied
       directly to scroll position like SystemAssembly's chain and
       FinishLadder's staircase, so it plays forward and reverses exactly
       with the gesture. */
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: wrap,
        start: 'top 80%',
        end: 'top 15%',
        scrub: 0.5,
      },
    });

    draws.forEach((path, i) => {
      const pos = i * 0.9;
      tl.fromTo(path, { strokeDashoffset: 100 }, { strokeDashoffset: 0, duration: 0.6, ease: 'none' }, pos);
      const label = labels[i];
      if (label) {
        /* Opacity only — these labels already carry an inline
           `transform: translateY(-50%)` for vertical centering on their
           anchor point, and GSAP's y/x tweens replace an element's whole
           transform rather than composing with it, which would silently
           cancel that centering the moment this timeline first touches the
           label. */
        tl.fromTo(label, { opacity: 0 }, { opacity: 1, duration: 0.4, ease: 'power2.out' }, pos + 0.2);
      }
    });
  };

  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => void enhance(), { timeout: 2000 });
  } else {
    setTimeout(() => void enhance(), 200);
  }
</script>
