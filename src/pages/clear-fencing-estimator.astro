---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import { CTA } from '@data/nav';
import {
  WIRE_SIZES,
  PANEL_WIDTH_MM,
  VAT_RATE,
  POST_LENGTH_MM,
  SPIDER_CLAMPS,
} from '@data/clear-view-panels';
import { POST_RATES, FIXINGS } from '@data/clear-view-estimator';

/**
 * /clear-fencing-estimator — the full configurator + instant estimator.
 *
 * businessguide.md §7: "no US competitor offers a genuinely interactive
 * configurator plus an instant estimator" is the stated market wedge, and
 * "every completed estimate is a lead" pushed to a Monday.com CRM via
 * webhook. This page is the real, full version of what EstimatorTeaser
 * previews on the homepage — same panel/post/gate arithmetic, same segments as
 * BuiltFor and same finish tiers as FinishLadder, reused rather than
 * reinvented so the numbers agree everywhere they appear.
 *
 * **It prices for real now.** This page used to show a bill of materials and
 * no money at all, on the stated grounds that pricing "lives in a CMS-editable
 * config this build doesn't have access to". That stopped being true once the
 * client's own published list was read into src/data/clear-view-panels.ts and
 * clear-view-estimator.ts — the same numbers the Panels and Posts pages print.
 * The estimate below is built from those, not from a range invented here, and
 * the arithmetic is the same port of the client's own calculator that
 * PanelPricing uses: panels = ceil(perimeter / 3 m), posts = panels + 1, VAT
 * applied once on the ex-VAT subtotal.
 *
 * Three assumptions are made to get from a perimeter to a figure, and all
 * three are printed next to it rather than buried here:
 *
 *   - **Posts** are quoted as the T-Post 100 x 60 x 1.6 mm, at the post length
 *     the assembly drawing gives for the chosen panel height.
 *   - **Clamps** are spider clamps at the drawing's own per-height count.
 *   - **Hot-Dip Galvanised posts have no published rate.** The list covers
 *     PRE GALV, powder-coated and Plascoat T-posts only, so on that finish the
 *     posts line reads "quoted separately" and is left out of the total rather
 *     than being filled in with the nearest number to hand.
 *
 * Gates and toppings stay unpriced for the same reason they always were: no
 * list price for them exists anywhere in this codebase.
 *
 * One thing this page still deliberately does NOT fabricate:
 *
 * 1. (retired — see above.)
 * 2. A working CRM handoff. There is no Monday.com webhook URL or lead-intake
 *    inbox anywhere in this codebase to send a real submission to — same
 *    reasoning as the rest of this project's "no fabrication" rule, just
 *    applied to infrastructure that doesn't exist rather than a fact that
 *    isn't known. (Footer.astro's contact details are real now — the
 *    client's actual export line — but that's a phone number to call, not a
 *    form-submission endpoint.) The form below is fully real — proper
 *    fields, validation, and structure — and submitting it shows an honest
 *    "here's your estimate" confirmation rather than a fabricated "we've
 *    received your request" promise. Wiring the actual webhook is a pending
 *    backend integration task once the client supplies real CRM credentials.
 *
 * Static-first: every field below is a real, native form control, and
 * without JS all five steps simply render stacked as one long form — nothing
 * is hidden behind script. Where JS is available, it turns the stack into a
 * step-by-step wizard (progress bar, Back/Next) and live-updates the summary
 * sidebar on every change; reduced-motion only affects the step-swap
 * transition, never the functionality.
 */

/**
 * Metres, not feet. The rest of the site moved to metric and rand a while ago
 * — a Benoni manufacturer quoting a South African customer — but this page was
 * still running a 10 ft panel module against a linear-feet perimeter. That was
 * survivable while it printed no money; the moment it prices a 3 000 mm panel
 * off the client's list, a 10 ft module produces a panel count, and therefore a
 * total, that disagrees with both the Panels page and the client's own
 * calculator.
 */
const MIN_M = 30;
const MAX_M = 2000;
const DEFAULT_M = 150;
const PANEL_WIDTH_M = PANEL_WIDTH_MM / 1000;

/** One gate per ~250 m of run, the metric equivalent of the old 800 ft rule. */
const GATE_EVERY_M = 250;

/** Panel grades and heights, read off the price list rather than retyped. */
const GRADES = WIRE_SIZES[0].grades.map((g) => ({
  id: g.id,
  label: g.label,
  aperture: g.aperture,
}));
const HEIGHTS = WIRE_SIZES[0].grades[0].rows.map((r) => r.heightMm);

/**
 * Everything the client-side estimator needs to price a run, flattened once
 * here rather than looked up in the browser.
 *
 * The script below is `is:inline` with `define:vars` — it cannot import
 * modules — so the alternative was hand-typing prices into it, which is
 * exactly how a page ends up quoting a figure the Panels page disagrees with.
 * This derives every number from the same modules those pages read, so the
 * two cannot drift.
 *
 * **Finish mapping lives here, in the open.** The radios on this page use
 * their own ids; the price list keys finishes differently; the post rates use
 * the client's own estimator wording again. All three vocabularies are
 * reconciled once, below.
 *
 * `posts.hdg` is deliberately null: the published list has no hot-dip
 * galvanised T-post rate — only PRE GALV, powder-coated and Plascoat — so on
 * that finish the estimate reports posts as quoted separately instead of
 * substituting the nearest number to hand.
 */
const PANEL_FINISH_KEY = {
  plain: 'plainGalv',
  hdg: 'dipped',
  powder: 'powderCoated',
  plascoat: 'plascoat',
} as const;

/** Posts are quoted as the T-Post 100 x 60 x 1.6 mm, per metre, ex VAT. */
const tPostRate = (finish: string): number | null =>
  POST_RATES.find((r) => r.kind === 't' && r.w === 100 && r.finish === finish)?.rate ?? null;

const clampPrice = (label: string): number => FIXINGS.find((f) => f.label === label)?.price ?? 0;

const PRICING = {
  panelWidthM: PANEL_WIDTH_M,
  vat: VAT_RATE,
  gateEveryM: GATE_EVERY_M,
  /** wire id -> grade id -> height mm -> ex-VAT price by finish key. */
  panels: Object.fromEntries(
    WIRE_SIZES.map((w) => [
      w.id,
      Object.fromEntries(
        w.grades.map((g) => [g.id, Object.fromEntries(g.rows.map((r) => [r.heightMm, r.ex]))]),
      ),
    ]),
  ),
  finishKey: PANEL_FINISH_KEY,
  postLengthMm: POST_LENGTH_MM,
  clampsPerPanel: Object.fromEntries(Object.entries(SPIDER_CLAMPS).map(([h, v]) => [h, v.total])),
  /** Rand per metre of post, by this page's finish id. */
  postRatePerM: {
    plain: tPostRate('PRE GALV'),
    hdg: null,
    powder: tPostRate('PRE GALV + P/COATED'),
    plascoat: tPostRate('PRE GALV + PLASCOAT'),
  },
  clampEach: {
    plain: clampPrice('Spider Clamps HDG'),
    hdg: clampPrice('Spider Clamps HDG'),
    powder: clampPrice('Spider Clamps Powder Coated'),
    plascoat: clampPrice('Spider Clamps PVC'),
  },
};

type Segment = { id: string; name: string };
const SEGMENTS: Segment[] = [
  { id: 'commercial', name: 'Commercial' },
  { id: 'industrial', name: 'Industrial' },
  { id: 'utility-solar', name: 'Utility & Solar' },
  { id: 'government', name: 'Government & Institutional' },
  { id: 'residential', name: 'Residential' },
];

type Finish = { id: string; name: string; tier: string; warranty?: string };
const FINISHES: Finish[] = [
  { id: 'plain', name: 'Plain Galvanised', tier: 'Entry' },
  { id: 'hdg', name: 'Hot-Dip Galvanised', tier: 'Mid' },
  { id: 'powder', name: 'Powder Coated', tier: 'Mid-Premium' },
  { id: 'plascoat', name: 'Plascoat / PVC', tier: 'Premium', warranty: '10-Year Warranty' },
];
---

<BaseLayout
  title="Clear View Fencing Estimator | Guard Master"
  description="Price a Clear View 358 run instantly — perimeter, grade, height and finish, costed at our published list prices in rand. Manufacturer-direct from Benoni."
>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Clear View Estimator', href: '/clear-fencing-estimator' },
    ]}
  />

  <section class="bg-gm-black text-gm-white relative overflow-hidden py-16 sm:py-20">
    <div
      class="pointer-events-none absolute inset-0 -z-10"
      style="background: radial-gradient(85% 110% at 85% 0%, rgba(228,17,42,0.10), transparent 55%);"
      aria-hidden="true"
    >
    </div>
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Quote Estimator</p>
      <h1
        class="font-display text-gm-white mt-5 max-w-3xl text-4xl leading-[0.95] font-black tracking-tight uppercase sm:text-5xl lg:text-6xl"
      >
        Configure Your Fence. <span class="text-gm-red">Get Your Estimate.</span>
      </h1>
      <p class="text-gm-grey-300 mt-6 max-w-xl text-base leading-relaxed">
        Five steps, no obligation. Set your perimeter, finish and toppings for a real bill of
        materials — the same arithmetic our team uses to confirm a firm quote.
      </p>
    </div>
  </section>

  <section class="bg-gm-white text-gm-black relative overflow-hidden py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <div data-qw-grid class="grid items-start gap-10 lg:grid-cols-[1.4fr_1fr] lg:gap-14">
        <form data-qw-form novalidate>
          <!-- Progress bar + step label — inserted visually by JS only; with
               no JS every step below is simply visible at once, so a "Step 1
               of 5" label pointing at hidden content would be misleading. -->
          <div data-qw-progress-wrap class="hidden">
            <div class="bg-gm-grey-100 h-1 overflow-hidden rounded-full">
              <div
                data-qw-progress-bar
                class="bg-gm-red h-full transition-[width] duration-300 ease-out"
                style="width: 20%;"
              >
              </div>
            </div>
            <p
              data-qw-progress-label
              class="text-gm-grey-500 mt-3 font-mono text-[11px] tracking-[0.18em] uppercase"
            >
              Step 1 of 5
            </p>
          </div>

          <!-- Step 1 — segment -->
          <fieldset data-qw-step data-qw-step-index="0" class="mt-8 first:mt-0">
            <legend class="font-display text-2xl font-black tracking-tight uppercase">
              What Are You Protecting?
            </legend>
            <p class="text-gm-grey-500 mt-2 text-sm leading-relaxed">
              Helps us route your estimate to the right team — it doesn't change the numbers below.
            </p>
            <div class="mt-6 grid gap-3 sm:grid-cols-2">
              {
                SEGMENTS.map((s, i) => (
                  <label class="qw-card border-gm-grey-200 has-checked:border-gm-red has-checked:bg-gm-red/5 flex cursor-pointer items-center gap-3 rounded-md border p-4 transition-colors">
                    <input
                      type="radio"
                      name="segment"
                      value={s.id}
                      checked={i === 0}
                      class="accent-gm-red h-4 w-4 shrink-0"
                    />
                    <span data-name class="text-[15px] font-semibold">
                      {s.name}
                    </span>
                  </label>
                ))
              }
            </div>
            <div class="mt-8 flex justify-end gap-3">
              <button
                type="button"
                data-qw-next
                class="tap-target bg-gm-red text-gm-white hidden items-center px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
              >
                Next →
              </button>
            </div>
          </fieldset>

          <!-- Step 2 — the run. Perimeter in metres, plus the three
               things a price actually needs: wire size, grade and height.
               Without them this step can count panels but cannot cost one,
               which is why it never showed money before. -->
          <fieldset data-qw-step data-qw-step-index="1" class="mt-8 first:mt-0">
            <legend class="font-display text-2xl font-black tracking-tight uppercase">
              Your Run
            </legend>
            <p class="text-gm-grey-500 mt-2 text-sm leading-relaxed">
              Perimeter, then the panel you want in it — the count and the price update live.
            </p>

            <div class="mt-6 flex items-baseline justify-between gap-3">
              <label
                for="qw-lf-number"
                class="text-gm-grey-500 font-mono text-[11px] tracking-[0.24em] uppercase"
              >
                Perimeter length
              </label>
              <span class="flex items-baseline gap-2">
                <input
                  id="qw-lf-number"
                  data-qw-lf-number
                  type="number"
                  inputmode="numeric"
                  min={MIN_M}
                  max={MAX_M}
                  step="5"
                  value={DEFAULT_M}
                  class="border-gm-grey-200 w-24 rounded-sm border px-2 py-1 text-right font-mono text-lg font-bold"
                />
                <span class="font-mono text-lg font-bold">m</span>
              </span>
            </div>
            <input
              data-qw-lf-slider
              type="range"
              min={MIN_M}
              max={MAX_M}
              step="5"
              value={DEFAULT_M}
              aria-label="Perimeter length in metres"
              class="tap-target accent-gm-red mt-4 w-full"
            />
            <div
              class="text-gm-grey-500 flex justify-between font-mono text-[10px] tracking-wide uppercase"
            >
              <span>{MIN_M.toLocaleString()} m</span>
              <span>{MAX_M.toLocaleString()} m</span>
            </div>

            <div class="border-gm-grey-200 mt-6 grid gap-4 border-t pt-6 sm:grid-cols-3">
              <div>
                <label
                  for="qw-wire"
                  class="text-gm-grey-500 block font-mono text-[10px] tracking-[0.18em] uppercase"
                >
                  Wire size
                </label>
                <select id="qw-wire" name="wire" data-qw-wire class="qw-select mt-2">
                  {WIRE_SIZES.map((w) => <option value={w.id}>{w.label}</option>)}
                </select>
              </div>
              <div>
                <label
                  for="qw-grade"
                  class="text-gm-grey-500 block font-mono text-[10px] tracking-[0.18em] uppercase"
                >
                  Security grade
                </label>
                <select id="qw-grade" name="grade" data-qw-grade class="qw-select mt-2">
                  {
                    GRADES.map((g) => (
                      <option value={g.id}>
                        {g.label} — {g.aperture}
                      </option>
                    ))
                  }
                </select>
              </div>
              <div>
                <label
                  for="qw-height"
                  class="text-gm-grey-500 block font-mono text-[10px] tracking-[0.18em] uppercase"
                >
                  Panel height
                </label>
                <select id="qw-height" name="height" data-qw-height class="qw-select mt-2">
                  {HEIGHTS.map((h) => <option value={h}>{(h / 1000).toFixed(1)} m</option>)}
                </select>
              </div>
            </div>

            <div class="border-gm-grey-200 mt-6 grid grid-cols-3 gap-4 border-t pt-6">
              <div>
                <p class="font-mono text-2xl font-black" data-qw-panels>
                  {Math.ceil(DEFAULT_M / PANEL_WIDTH_M)}
                </p>
                <p class="text-gm-grey-500 mt-1 font-mono text-[10px] tracking-[0.14em] uppercase">
                  Panels
                </p>
              </div>
              <div>
                <p class="font-mono text-2xl font-black" data-qw-posts>
                  {Math.ceil(DEFAULT_M / PANEL_WIDTH_M) + 1}
                </p>
                <p class="text-gm-grey-500 mt-1 font-mono text-[10px] tracking-[0.14em] uppercase">
                  Posts
                </p>
              </div>
              <div>
                <p class="font-mono text-2xl font-black" data-qw-gates-suggested>
                  {Math.max(1, Math.round(DEFAULT_M / GATE_EVERY_M))}
                </p>
                <p class="text-gm-grey-500 mt-1 font-mono text-[10px] tracking-[0.14em] uppercase">
                  Est. Gates
                </p>
              </div>
            </div>

            <div class="mt-8 flex justify-end gap-3">
              <button
                type="button"
                data-qw-back
                class="tap-target border-gm-grey-300 text-gm-black hover:border-gm-black hidden items-center border px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors"
              >
                ← Back
              </button>
              <button
                type="button"
                data-qw-next
                class="tap-target bg-gm-red text-gm-white hidden items-center px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
              >
                Next →
              </button>
            </div>
          </fieldset>

          <!-- Step 3 — finish -->
          <fieldset data-qw-step data-qw-step-index="2" class="mt-8 first:mt-0">
            <legend class="font-display text-2xl font-black tracking-tight uppercase">
              Pick Your Finish
            </legend>
            <p class="text-gm-grey-500 mt-2 text-sm leading-relaxed">
              Every panel starts plain galvanised, then is finished in-house to your spec.
            </p>
            <div class="mt-6 grid gap-3 sm:grid-cols-2">
              {
                FINISHES.map((f, i) => (
                  <label class="qw-card border-gm-grey-200 has-checked:border-gm-red has-checked:bg-gm-red/5 flex cursor-pointer items-start gap-3 rounded-md border p-4 transition-colors">
                    <input
                      type="radio"
                      name="finish"
                      value={f.id}
                      checked={i === FINISHES.length - 1}
                      class="accent-gm-red mt-1 h-4 w-4 shrink-0"
                    />
                    <span>
                      <span class="text-gm-grey-500 block font-mono text-[10px] tracking-[0.18em] uppercase">
                        {f.tier}
                      </span>
                      <span data-name class="block text-[15px] font-semibold">
                        {f.name}
                      </span>
                      {f.warranty && (
                        <span class="bg-gm-red text-gm-white mt-1.5 inline-block rounded-full px-2 py-0.5 text-[10px] font-bold tracking-[0.06em] uppercase">
                          {f.warranty}
                        </span>
                      )}
                    </span>
                  </label>
                ))
              }
            </div>
            <div class="mt-8 flex justify-end gap-3">
              <button
                type="button"
                data-qw-back
                class="tap-target border-gm-grey-300 text-gm-black hover:border-gm-black hidden items-center border px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors"
              >
                ← Back
              </button>
              <button
                type="button"
                data-qw-next
                class="tap-target bg-gm-red text-gm-white hidden items-center px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
              >
                Next →
              </button>
            </div>
          </fieldset>

          <!-- Step 4 — extras. businessguide.md §5's own named list: gates,
               razor topping, spike topping, solar caps. -->
          <fieldset data-qw-step data-qw-step-index="3" class="mt-8 first:mt-0">
            <legend class="font-display text-2xl font-black tracking-tight uppercase">
              Extras
            </legend>
            <p class="text-gm-grey-500 mt-2 text-sm leading-relaxed">
              Incremental options on top of the core system — adjust the gate count or add toppings.
            </p>

            <label
              for="qw-gates"
              class="text-gm-grey-500 mt-6 block font-mono text-[11px] tracking-[0.24em] uppercase"
            >
              Gate count
            </label>
            <input
              id="qw-gates"
              data-qw-gates
              type="number"
              inputmode="numeric"
              min="0"
              step="1"
              value={Math.max(1, Math.round(DEFAULT_M / GATE_EVERY_M))}
              class="border-gm-grey-200 mt-2 w-24 rounded-sm border px-2 py-1 text-right font-mono text-lg font-bold"
            />
            <p class="text-gm-grey-500 mt-1.5 text-[11px] leading-relaxed">
              Pre-filled from your perimeter — edit if you know your access points.
            </p>

            <div class="border-gm-grey-200 mt-6 space-y-3 border-t pt-6">
              <label
                class="qw-card border-gm-grey-200 has-checked:border-gm-red has-checked:bg-gm-red/5 flex cursor-pointer items-center gap-3 rounded-md border p-4 transition-colors"
              >
                <input
                  type="checkbox"
                  name="extras"
                  value="spike"
                  class="accent-gm-red h-4 w-4 shrink-0"
                />
                <span>
                  <span data-name class="block text-[15px] font-semibold">Spike Topping</span>
                  <span class="text-gm-grey-500 text-[13px]"
                    >Anti-climb spike topping along the top rail.</span
                  >
                </span>
              </label>
              <label
                class="qw-card border-gm-grey-200 has-checked:border-gm-red has-checked:bg-gm-red/5 flex cursor-pointer items-center gap-3 rounded-md border p-4 transition-colors"
              >
                <input
                  type="checkbox"
                  name="extras"
                  value="razor"
                  class="accent-gm-red h-4 w-4 shrink-0"
                />
                <span>
                  <span data-name class="block text-[15px] font-semibold">Razor Topping</span>
                  <span class="text-gm-grey-500 text-[13px]"
                    >Razor wire topping for maximum-security sites.</span
                  >
                </span>
              </label>
              <label
                class="qw-card border-gm-grey-200 has-checked:border-gm-red has-checked:bg-gm-red/5 flex cursor-pointer items-center gap-3 rounded-md border p-4 transition-colors"
              >
                <input
                  type="checkbox"
                  name="extras"
                  value="solar"
                  class="accent-gm-red h-4 w-4 shrink-0"
                />
                <span>
                  <span data-name class="block text-[15px] font-semibold">Solar Caps</span>
                  <span class="text-gm-grey-500 text-[13px]">Solar-powered post cap lighting.</span>
                </span>
              </label>
            </div>

            <div class="mt-8 flex justify-end gap-3">
              <button
                type="button"
                data-qw-back
                class="tap-target border-gm-grey-300 text-gm-black hover:border-gm-black hidden items-center border px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors"
              >
                ← Back
              </button>
              <button
                type="button"
                data-qw-next
                class="tap-target bg-gm-red text-gm-white hidden items-center px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
              >
                Next →
              </button>
            </div>
          </fieldset>

          <!-- Step 5 — contact -->
          <fieldset data-qw-step data-qw-step-index="4" class="mt-8 first:mt-0">
            <legend class="font-display text-2xl font-black tracking-tight uppercase">
              Your Details
            </legend>
            <p class="text-gm-grey-500 mt-2 text-sm leading-relaxed">
              We'll route this to the right person — often a specifier or contractor is buying on
              the owner's behalf, so a company name helps.
            </p>

            <div class="mt-6 grid gap-4 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <label
                  for="qw-name"
                  class="text-gm-grey-500 font-mono text-[11px] tracking-[0.18em] uppercase"
                  >Full name *</label
                >
                <input
                  id="qw-name"
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                  class="border-gm-grey-200 mt-1.5 w-full rounded-sm border px-3 py-2 text-sm"
                />
              </div>
              <div>
                <label
                  for="qw-email"
                  class="text-gm-grey-500 font-mono text-[11px] tracking-[0.18em] uppercase"
                  >Email *</label
                >
                <input
                  id="qw-email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  class="border-gm-grey-200 mt-1.5 w-full rounded-sm border px-3 py-2 text-sm"
                />
              </div>
              <div>
                <label
                  for="qw-phone"
                  class="text-gm-grey-500 font-mono text-[11px] tracking-[0.18em] uppercase"
                  >Phone</label
                >
                <input
                  id="qw-phone"
                  name="phone"
                  type="tel"
                  inputmode="tel"
                  autocomplete="tel"
                  class="border-gm-grey-200 mt-1.5 w-full rounded-sm border px-3 py-2 text-sm"
                />
              </div>
              <div class="sm:col-span-2">
                <label
                  for="qw-company"
                  class="text-gm-grey-500 font-mono text-[11px] tracking-[0.18em] uppercase"
                  >Company / organization</label
                >
                <input
                  id="qw-company"
                  name="company"
                  type="text"
                  autocomplete="organization"
                  class="border-gm-grey-200 mt-1.5 w-full rounded-sm border px-3 py-2 text-sm"
                />
              </div>
              <div class="sm:col-span-2">
                <label
                  for="qw-notes"
                  class="text-gm-grey-500 font-mono text-[11px] tracking-[0.18em] uppercase"
                  >Project notes</label
                >
                <textarea
                  id="qw-notes"
                  name="notes"
                  rows="3"
                  class="border-gm-grey-200 mt-1.5 w-full rounded-sm border px-3 py-2 text-sm"
                ></textarea>
              </div>
            </div>

            <div class="mt-8 flex justify-end gap-3">
              <button
                type="button"
                data-qw-back
                class="tap-target border-gm-grey-300 text-gm-black hover:border-gm-black hidden items-center border px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors"
              >
                ← Back
              </button>
              <button
                type="submit"
                class="tap-target bg-gm-red text-gm-white inline-flex items-center px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
              >
                Get My Estimate
              </button>
            </div>
          </fieldset>
        </form>

        <!-- Live summary — same numbers as the form, mirrored for review. -->
        <aside
          data-qw-summary
          class="border-gm-grey-200 bg-gm-grey-50 sticky top-24 rounded-md border p-6 shadow-[0_1px_3px_rgba(0,0,0,0.06)]"
        >
          <p class="text-gm-grey-500 font-mono text-[11px] tracking-[0.24em] uppercase">
            Your Estimate
          </p>
          <dl class="mt-4 space-y-3 text-sm">
            <div class="flex items-center justify-between gap-3">
              <dt class="text-gm-grey-500">Protecting</dt>
              <dd data-qw-summary-segment class="text-right font-semibold">Commercial</dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-gm-grey-500">Perimeter</dt>
              <dd data-qw-summary-lf class="text-right font-semibold">
                {DEFAULT_M.toLocaleString()} m
              </dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-gm-grey-500">Panel</dt>
              <dd data-qw-summary-panel class="text-right font-semibold">—</dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-gm-grey-500">Panels · Posts</dt>
              <dd data-qw-summary-parts class="text-right font-semibold">
                {Math.ceil(DEFAULT_M / PANEL_WIDTH_M)} · {Math.ceil(DEFAULT_M / PANEL_WIDTH_M) + 1}
              </dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-gm-grey-500">Gates</dt>
              <dd data-qw-summary-gates class="text-right font-semibold">
                {Math.max(1, Math.round(DEFAULT_M / GATE_EVERY_M))}
              </dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-gm-grey-500">Finish</dt>
              <dd data-qw-summary-finish class="text-right font-semibold">Plascoat / PVC</dd>
            </div>
            <div class="flex items-start justify-between gap-3">
              <dt class="text-gm-grey-500">Toppings</dt>
              <dd data-qw-summary-extras class="max-w-[60%] text-right font-semibold">
                None selected
              </dd>
            </div>
          </dl>

          {
            /* Real money, off the published list. Rendered server-side at the
              default configuration so the panel is never a row of dashes
              before the script runs. */
          }
          <dl class="border-gm-grey-200 mt-5 space-y-2.5 border-t pt-5 font-mono text-[13px]">
            <div class="flex items-center justify-between gap-3">
              <dt class="text-gm-grey-500">Panels</dt>
              <dd data-qw-cost-panels class="tabular-nums">—</dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-gm-grey-500">Posts</dt>
              <dd data-qw-cost-posts class="tabular-nums">—</dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-gm-grey-500">Clamps</dt>
              <dd data-qw-cost-clamps class="tabular-nums">—</dd>
            </div>
            <div class="border-gm-grey-200 flex items-center justify-between gap-3 border-t pt-2.5">
              <dt class="text-gm-grey-500">Subtotal excl. VAT</dt>
              <dd data-qw-cost-ex class="tabular-nums">—</dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-gm-grey-500">VAT ({VAT_RATE * 100}%)</dt>
              <dd data-qw-cost-vat class="tabular-nums">—</dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-gm-black font-sans font-bold">Total incl. VAT</dt>
              <dd data-qw-cost-incl class="text-gm-red font-bold tabular-nums">—</dd>
            </div>
          </dl>

          <p data-qw-cost-note class="text-gm-grey-500 mt-4 text-[11px] leading-relaxed"></p>
          <p
            class="text-gm-grey-500 border-gm-grey-200 mt-5 border-t pt-4 text-[11px] leading-relaxed"
          >
            Illustrative bill of materials — excludes freight, installation and groundworks; final
            scope is confirmed on survey.
          </p>
        </aside>
      </div>

      <!-- Confirmation — swapped in for the form + summary on submit; the
           form is never actually wired to a CRM (see the doc comment above),
           so this states only what's true: the estimate is ready, not that
           a request was received somewhere. -->
      <div data-qw-confirm class="hidden">
        <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Estimate Ready</p>
        <h2 class="font-display mt-4 text-3xl font-black tracking-tight uppercase sm:text-4xl">
          Here's Your Bill Of Materials.
        </h2>
        <p class="text-gm-grey-600 mt-4 max-w-2xl text-base leading-relaxed">
          Save this summary — a completed estimate is the first step toward a firm, surveyed quote.
        </p>
        <div
          data-qw-confirm-summary
          class="border-gm-grey-200 bg-gm-grey-50 mt-8 max-w-xl rounded-md border p-6 text-sm"
        >
        </div>
        <a
          href={CTA.href}
          class="tap-target bg-gm-red text-gm-white mt-8 inline-flex items-center px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
        >
          Start A New Estimate
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script
  is:inline
  define:vars={{ MIN_M, MAX_M, DEFAULT_M, PANEL_WIDTH_M, GATE_EVERY_M, PRICING, TOTAL_STEPS: 5 }}
>
  const form = document.querySelector('[data-qw-form]');
  if (form) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const steps = Array.from(form.querySelectorAll('[data-qw-step]'));
    const progressWrap = form.querySelector('[data-qw-progress-wrap]');
    const progressBar = form.querySelector('[data-qw-progress-bar]');
    const progressLabel = form.querySelector('[data-qw-progress-label]');
    const nextButtons = Array.from(form.querySelectorAll('[data-qw-next]'));
    const backButtons = Array.from(form.querySelectorAll('[data-qw-back]'));

    const lfSlider = form.querySelector('[data-qw-lf-slider]');
    const lfNumber = form.querySelector('[data-qw-lf-number]');
    const panelsEl = form.querySelector('[data-qw-panels]');
    const postsEl = form.querySelector('[data-qw-posts]');
    const gatesSuggestedEl = form.querySelector('[data-qw-gates-suggested]');
    const gatesInput = form.querySelector('[data-qw-gates]');

    let gatesTouched = false;
    gatesInput?.addEventListener('input', () => {
      gatesTouched = true;
    });

    const renderLf = (lf) => {
      const panels = Math.ceil(lf / PANEL_WIDTH_M);
      const posts = panels + 1;
      const suggestedGates = Math.max(1, Math.round(lf / GATE_EVERY_M));
      if (panelsEl) panelsEl.textContent = String(panels);
      if (postsEl) postsEl.textContent = String(posts);
      if (gatesSuggestedEl) gatesSuggestedEl.textContent = String(suggestedGates);
      if (gatesInput && !gatesTouched) gatesInput.value = String(suggestedGates);
    };

    lfSlider?.addEventListener('input', () => {
      if (lfNumber) lfNumber.value = lfSlider.value;
      renderLf(Number(lfSlider.value));
      updateSummary();
    });
    lfNumber?.addEventListener('input', () => {
      const clamped = Math.min(MAX_M, Math.max(MIN_M, Number(lfNumber.value) || MIN_M));
      if (lfSlider) lfSlider.value = String(clamped);
      renderLf(clamped);
      updateSummary();
    });

    // Live summary — mirrors whatever's currently selected in the form.
    const summarySegment = document.querySelector('[data-qw-summary-segment]');
    const summaryLf = document.querySelector('[data-qw-summary-lf]');
    const summaryParts = document.querySelector('[data-qw-summary-parts]');
    const summaryGates = document.querySelector('[data-qw-summary-gates]');
    const summaryFinish = document.querySelector('[data-qw-summary-finish]');
    const summaryExtras = document.querySelector('[data-qw-summary-extras]');
    const summaryPanel = document.querySelector('[data-qw-summary-panel]');

    const wireSel = form.querySelector('[data-qw-wire]');
    const gradeSel = form.querySelector('[data-qw-grade]');
    const heightSel = form.querySelector('[data-qw-height]');

    const costPanels = document.querySelector('[data-qw-cost-panels]');
    const costPosts = document.querySelector('[data-qw-cost-posts]');
    const costClamps = document.querySelector('[data-qw-cost-clamps]');
    const costEx = document.querySelector('[data-qw-cost-ex]');
    const costVat = document.querySelector('[data-qw-cost-vat]');
    const costIncl = document.querySelector('[data-qw-cost-incl]');
    const costNote = document.querySelector('[data-qw-cost-note]');

    const rand = (v) =>
      `R ${new Intl.NumberFormat('en-US', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      }).format(v)}`;
    const r2 = (v) => Math.round(v * 100) / 100;

    /**
     * Prices the current configuration off PRICING, which was flattened from
     * the same modules the Panels and Posts pages read. Same arithmetic as
     * PanelPricing: ex-VAT line totals, VAT applied once at the end.
     */
    function priceRun(panels, posts, finishId, wireId, gradeId, heightMm) {
      const ex = PRICING.panels[wireId]?.[gradeId]?.[heightMm];
      const key = PRICING.finishKey[finishId];
      const panelEach = ex && key ? ex[key] : 0;
      const panelsEx = r2(panelEach * panels);

      const ratePerM = PRICING.postRatePerM[finishId];
      const postLenM = (PRICING.postLengthMm[heightMm] ?? 0) / 1000;
      const postsEx = ratePerM === null ? null : r2(ratePerM * postLenM * posts);

      const clampsEach = PRICING.clampEach[finishId] ?? 0;
      const clampsPerPanel = PRICING.clampsPerPanel[heightMm] ?? 0;
      const clampsQty = clampsPerPanel * panels;
      const clampsEx = r2(clampsEach * clampsQty);

      const subtotal = r2(panelsEx + (postsEx ?? 0) + clampsEx);
      const vat = r2(subtotal * PRICING.vat);
      return {
        panelEach,
        panelsEx,
        postsEx,
        postLenM,
        clampsQty,
        clampsEx,
        subtotal,
        vat,
        incl: r2(subtotal + vat),
      };
    }

    function updateSummary() {
      const segment = form.querySelector('input[name="segment"]:checked');
      const finish = form.querySelector('input[name="finish"]:checked');
      const extras = Array.from(form.querySelectorAll('input[name="extras"]:checked')).map(
        (el) => el.closest('label')?.querySelector('[data-name]')?.textContent?.trim() ?? el.value,
      );
      const lf = Number(lfNumber?.value || DEFAULT_M);
      const panels = Math.ceil(lf / PANEL_WIDTH_M);
      const posts = panels + 1;
      const gates = Number(gatesInput?.value || Math.max(1, Math.round(lf / GATE_EVERY_M)));

      const finishId = finish?.value ?? 'plascoat';
      const wireId = wireSel?.value ?? Object.keys(PRICING.panels)[0];
      const gradeId = gradeSel?.value ?? 'high';
      const heightMm = Number(heightSel?.value ?? 1800);
      const cost = priceRun(panels, posts, finishId, wireId, gradeId, heightMm);

      if (summaryPanel) {
        const gradeLabel = gradeSel?.selectedOptions?.[0]?.textContent?.split('—')[0].trim() ?? '';
        summaryPanel.textContent = `${gradeLabel} · ${(heightMm / 1000).toFixed(1)} m`;
      }
      if (costPanels) costPanels.textContent = `${panels} x ${rand(cost.panelEach)}`;
      if (costPosts) {
        costPosts.textContent =
          cost.postsEx === null ? 'Quoted separately' : `${posts} x ${cost.postLenM.toFixed(1)} m`;
      }
      if (costClamps) costClamps.textContent = `${cost.clampsQty} clamps`;
      if (costEx) costEx.textContent = rand(cost.subtotal);
      if (costVat) costVat.textContent = rand(cost.vat);
      if (costIncl) costIncl.textContent = rand(cost.incl);
      if (costNote) {
        costNote.textContent =
          cost.postsEx === null
            ? 'Panels and clamps at list price, excl. VAT. Hot-dip galvanised posts have no published rate, so they are quoted separately and are not in this total. Clamps are spider clamps at the assembly drawing’s count.'
            : 'At list price, excl. VAT. Posts quoted as the T-Post 100 × 60 × 1.6 mm at the length the assembly drawing gives for this height; clamps are spider clamps at its own per-height count.';
      }

      if (summarySegment) {
        summarySegment.textContent =
          segment?.closest('label')?.querySelector('[data-name]')?.textContent?.trim() ?? '—';
      }
      if (summaryLf) summaryLf.textContent = `${lf.toLocaleString()} m`;
      if (summaryParts) summaryParts.textContent = `${panels} · ${posts}`;
      if (summaryGates) summaryGates.textContent = String(gates);
      if (summaryFinish) {
        summaryFinish.textContent =
          finish?.closest('label')?.querySelector('[data-name]')?.textContent?.trim() ?? '—';
      }
      if (summaryExtras)
        summaryExtras.textContent = extras.length ? extras.join(', ') : 'None selected';
    }

    form.addEventListener('change', updateSummary);
    updateSummary();

    // Step-wizard enhancement — without this, every fieldset above is just
    // visible at once (a normal, if long, stacked form).
    let active = 0;
    // `scroll` defaults true for the Next/Back navigation this is actually
    // built for. The initial showStep(0) below passes false: nothing has
    // scrolled the page yet at that point, so auto-scrolling the moment the
    // wizard mounts would yank a visitor's position on every page load for
    // no reason they asked for — and browsers do the smooth variant of
    // scrollIntoView slightly differently from an instant jump, so on some
    // scroll-margin-top setups (this page's own [data-qw-form] rule)
    // "smooth" now settles a few pixels short of the resting position an
    // instant jump reaches. Skipping the scroll on mount sidesteps needing
    // to reconcile that at all.
    const showStep = (i, scroll = true) => {
      active = Math.max(0, Math.min(steps.length - 1, i));
      steps.forEach((s, idx) => s.classList.toggle('is-active', idx === active));
      if (progressBar) progressBar.style.width = ((active + 1) / TOTAL_STEPS) * 100 + '%';
      if (progressLabel) progressLabel.textContent = `Step ${active + 1} of ${TOTAL_STEPS}`;
      if (scroll && !reduce) form.scrollIntoView({ block: 'start', behavior: 'smooth' });
    };

    steps.forEach((step) => step.classList.add('qw-step'));
    progressWrap?.classList.remove('hidden');
    [...nextButtons, ...backButtons].forEach((b) => {
      b.classList.remove('hidden');
      b.classList.add('inline-flex');
    });
    showStep(0, false);

    nextButtons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const step = btn.closest('[data-qw-step]');
        const requiredEls = step ? Array.from(step.querySelectorAll('[required]')) : [];
        if (requiredEls.some((el) => !el.checkValidity())) {
          requiredEls.forEach((el) => el.reportValidity());
          return;
        }
        showStep(active + 1);
      }),
    );
    backButtons.forEach((btn) => btn.addEventListener('click', () => showStep(active - 1)));

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      updateSummary();

      const grid = document.querySelector('[data-qw-grid]');
      const confirm = document.querySelector('[data-qw-confirm]');
      const confirmSummary = document.querySelector('[data-qw-confirm-summary]');
      if (confirmSummary) {
        confirmSummary.innerHTML = document.querySelector('[data-qw-summary]')?.innerHTML ?? '';
      }
      grid?.classList.add('hidden');
      confirm?.classList.remove('hidden');
      if (!reduce) confirm?.scrollIntoView({ block: 'start', behavior: 'smooth' });
    });
  }
</script>

<style is:global>
  [data-qw-step] {
    display: block;
  }
  .qw-step:not(.is-active) {
    display: none;
  }

  /* showStep()/the submit handler call scrollIntoView({ block: 'start' }) on
     [data-qw-form]/[data-qw-confirm] on every step change — without this,
     that aligns their top edge flush with the viewport top, sliding the
     "Step X of 5" label (and the confirmation heading) under the fixed
     header, same bug BaseLayout.astro's fullBleedHero/pt-16/lg:pt-20 fixes
     for the page's own static layout but can't reach here since this is a
     runtime scroll, not initial paint. scroll-margin-top makes
     scrollIntoView itself stop short by the header's height instead. */
  [data-qw-form],
  [data-qw-confirm] {
    scroll-margin-top: 4rem;
  }
  @media (min-width: 1024px) {
    [data-qw-form],
    [data-qw-confirm] {
      scroll-margin-top: 5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-qw-progress-bar] {
      transition: none;
    }
  }
</style>
