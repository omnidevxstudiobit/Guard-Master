---
import { COILS, Y_BRACKETS } from '@data/clear-view-estimator';
import { VAT_RATE } from '@data/clear-view-panels';
import { formatRand } from '@data/products';
import { CTA } from '@data/nav';

/**
 * "Anti-climb Fence Options" and "Y-Brackets for Concertina Coils" — the last
 * two sections of the client's own quote estimator, which an earlier pass here
 * missed entirely.
 *
 * Both are sold by coverage rather than by the piece, and that is the whole
 * reason they get a calculator instead of a price list. A Ø 980 mm concertina
 * coil is R 713.00 and covers 13 m; a Ø 450 mm coil is R 315.00 and covers 8 m.
 * Per unit the small one is cheaper and per metre it is dearer, and no table of
 * unit prices makes that visible. So every row here carries its rate per metre
 * alongside its unit price, and the estimator converts a perimeter into units.
 *
 * Rows are grouped by what they are, not left as one 41-line dropdown the way
 * the source has them: coils, flat wrap, electrified coil, multi-coil, spikes
 * and brackets are six different decisions, and a spike is not an alternative
 * to a bracket.
 *
 * Every figure is the estimator's own `data-price` / `data-length`, ex VAT, on
 * the same basis as the panels and posts. Y-brackets carry `data-weight="0"` on
 * the source — that is a gap in their data, not a weightless bracket, so no
 * mass is shown for them rather than a zero that reads as fact.
 *
 * Controls are JS-only and hidden until the script runs; the tables are the
 * content and render complete without it.
 */

type Row = (typeof COILS)[number];

/** Split the source's flat lists into the decisions they actually represent. */
const startsWith =
  (...prefixes: string[]) =>
  (r: Row) =>
    prefixes.some((p) => r.label.toLowerCase().startsWith(p.toLowerCase()));

const GROUPS = [
  {
    id: 'coils',
    title: 'Concertina Coils',
    note: 'Expanded coil, fixed along the top of a line or a wall. Larger diameters cover more metres per unit.',
    rows: COILS.filter(startsWith('Concertina coil')),
  },
  {
    id: 'flat',
    title: 'Flat Wrap',
    note: 'A flat-profile wrap for walls and existing fence lines, where a full coil is too deep.',
    rows: COILS.filter(startsWith('Flat wrap')),
  },
  {
    id: 'electrified',
    title: 'Electrified Concertina',
    note: 'Energised coil for detection-grade perimeters. Covers fewer metres per unit than the same diameter unenergised.',
    rows: COILS.filter(startsWith('Electrified concertina')),
  },
  {
    id: 'multi',
    title: 'Multi-Coil System',
    note: 'Three diameters stacked into one barrier — Ø 450, Ø 730 and Ø 980 mm together.',
    rows: COILS.filter(startsWith('Multi-Coils')),
  },
  {
    id: 'spikes',
    title: 'Super Spikes',
    note: 'Shark-tooth spike bar, 1.475 m a unit, with or without fixators, in five finishes.',
    rows: COILS.filter(startsWith('Super Spike')),
  },
  {
    id: 'brackets',
    title: 'Y-Brackets For Concertina Coils',
    note: 'The arm that carries the coil off the top of the post. Sized to the coil diameter it holds.',
    rows: Y_BRACKETS,
  },
];

const perMetre = (row: Row): number | null =>
  row.lengthM && row.lengthM > 0 ? Math.round((row.price / row.lengthM) * 100) / 100 : null;
---

<section id="anti-climb" class="bg-gm-black text-gm-white py-20 sm:py-28">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Anti-Climb Options</p>
      <h2
        class="font-display text-gm-white mt-5 text-3xl leading-[1.02] font-black tracking-tight uppercase sm:text-4xl lg:text-5xl"
      >
        What Goes <span class="text-gm-red">On Top.</span>
      </h2>
      <p class="text-gm-grey-400 mt-6 text-base leading-relaxed">
        Coils, flat wrap, spikes and the brackets that carry them. These are priced by the unit but
        bought by the metre, so every row shows both — the unit price you'll be invoiced and the
        rate per metre you should actually compare on.
      </p>
    </div>

    <div data-acalc class="mt-12 sm:mt-14">
      <div class="calc-head border-gm-grey-800 border-y py-6">
        <div class="flex flex-wrap items-end gap-x-6 gap-y-5">
          <div>
            <label
              for="ac-run"
              class="text-gm-grey-500 block font-mono text-[10px] tracking-[0.18em] uppercase"
            >
              Run to cover (m)
            </label>
            <input
              id="ac-run"
              data-calc-run
              type="number"
              min="0"
              step="any"
              inputmode="decimal"
              placeholder="e.g. 400"
              class="calc-field mt-2 w-40"
            />
          </div>
          <p
            data-calc-derived
            class="text-gm-grey-400 min-w-[16rem] flex-1 text-[13px] leading-snug"
          >
            Enter a run and each option below tells you how many units it takes.
          </p>
        </div>
      </div>

      {
        GROUPS.filter((group) => group.rows.length > 0).map((group, g) => (
          <article data-ac-group class="mt-12 first-of-type:mt-10">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <span class="text-gm-grey-500 font-mono text-[10px] tracking-[0.2em] tabular-nums">
                0{g + 1}
              </span>
              <h3 class="font-display text-gm-white text-lg font-bold tracking-tight uppercase">
                {group.title}
              </h3>
            </div>
            <p class="text-gm-grey-400 mt-2 max-w-2xl text-[13px] leading-relaxed">{group.note}</p>

            <div data-calc-row class="calc-row border-gm-grey-800 mt-5 border p-4 sm:p-5">
              <div class="flex flex-wrap items-end gap-x-5 gap-y-4">
                <div class="min-w-[18rem] flex-1">
                  <label
                    for={`ac-opt-${group.id}`}
                    class="text-gm-grey-500 block font-mono text-[10px] tracking-[0.18em] uppercase"
                  >
                    {group.title}
                  </label>
                  <select id={`ac-opt-${group.id}`} data-calc-option class="calc-field mt-2 w-full">
                    <option value="">Select an option…</option>
                    {group.rows.map((row) => (
                      <option
                        value={row.label}
                        data-price={row.price}
                        data-length={row.lengthM ?? ''}
                      >
                        {row.label} — {formatRand(row.price)}
                      </option>
                    ))}
                  </select>
                </div>
                <div>
                  <label
                    for={`ac-qty-${group.id}`}
                    class="text-gm-grey-500 block font-mono text-[10px] tracking-[0.18em] uppercase"
                  >
                    Units
                  </label>
                  <input
                    id={`ac-qty-${group.id}`}
                    data-calc-qty
                    type="number"
                    min="0"
                    step="1"
                    placeholder="0"
                    class="calc-field mt-2 w-28"
                  />
                </div>
                <div>
                  <button
                    type="button"
                    data-calc-add
                    disabled
                    class="add-btn tap-target bg-gm-red text-gm-white inline-flex items-center px-5 text-[11px] font-bold tracking-[0.1em] uppercase transition-colors hover:bg-[#c50e24] disabled:cursor-not-allowed disabled:opacity-40"
                  >
                    Add To Quote
                  </button>
                </div>
              </div>
              <p data-calc-line class="text-gm-grey-400 mt-4 hidden text-[13px] leading-relaxed" />
            </div>

            <div class="mt-5 -mr-6 overflow-x-auto pr-6 lg:mr-0 lg:pr-0">
              <table class="price-table w-full min-w-[42rem] border-collapse text-left">
                <caption class="sr-only">
                  {group.title} — unit price, coverage and rate per metre, excluding VAT
                </caption>
                <thead>
                  <tr>
                    <th scope="col">Item</th>
                    <th scope="col" class="num">
                      Covers
                    </th>
                    <th scope="col" class="num">
                      Per unit
                    </th>
                    <th scope="col" class="num">
                      Per m
                    </th>
                    <th scope="col" class="num">
                      Units
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {group.rows.map((row) => (
                    <tr data-ac-row data-length={row.lengthM ?? ''}>
                      <th scope="row">{row.label}</th>
                      <td class="num soft">{row.lengthM ? `${row.lengthM} m` : '—'}</td>
                      <td class="num">{formatRand(row.price)}</td>
                      <td class="num rate">
                        {perMetre(row) === null ? '—' : `${formatRand(perMetre(row) as number)}`}
                      </td>
                      {/* Filled by the estimator once a run is entered. */}
                      <td class="num units" data-ac-units>
                        —
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </article>
        ))
      }
      <div data-calc-total class="calc-total border-gm-red mt-12 hidden border-t-2 pt-8">
        <div class="flex flex-wrap items-start justify-between gap-8">
          <div>
            <p class="text-gm-grey-500 font-mono text-[10px] tracking-[0.2em] uppercase">
              Order Estimate
            </p>
            <p
              data-calc-total-lines
              class="text-gm-grey-300 mt-3 max-w-md text-[13px] leading-relaxed"
            >
            </p>
          </div>
          <dl class="min-w-[17rem] font-mono text-[13px]">
            <div class="flex justify-between gap-8 border-b border-white/10 py-2">
              <dt class="text-gm-grey-400">Total excl. VAT</dt>
              <dd data-calc-ex class="text-gm-white tabular-nums">—</dd>
            </div>
            <div class="flex justify-between gap-8 border-b border-white/10 py-2">
              <dt class="text-gm-grey-400">VAT ({VAT_RATE * 100}%)</dt>
              <dd data-calc-vat class="text-gm-white tabular-nums">—</dd>
            </div>
            <div class="flex justify-between gap-8 py-2">
              <dt class="text-gm-white font-bold">Total incl. VAT</dt>
              <dd data-calc-incl class="text-gm-red font-bold tabular-nums">—</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-6 border-t border-white/10 pt-8 sm:flex-row sm:items-start sm:justify-between"
    >
      <p class="text-gm-grey-500 max-w-lg text-[11px] leading-relaxed">
        Prices are per unit and exclude VAT; add {VAT_RATE * 100}%. Unit counts round up — a coil
        can't be bought in halves — and assume a straight run with no overlap allowance. Coils
        overlap at every joint in practice, so treat the count as a floor, not a bill of materials.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href={CTA.href}
          class="tap-target bg-gm-red text-gm-white inline-flex items-center px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
        >
          {CTA.label}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  [data-acalc] .calc-head,
  [data-acalc] .calc-row {
    display: none;
  }
  [data-acalc].is-live .calc-head,
  [data-acalc].is-live .calc-row {
    display: block;
  }

  [data-acalc] .calc-field {
    height: 2.75rem;
    padding: 0 0.75rem;
    border: 1px solid #35353d;
    background: #111114;
    color: var(--color-gm-white);
    font-size: 13px;
    line-height: 1.2;
  }
  [data-acalc] .calc-field:focus-visible {
    outline: 2px solid var(--color-gm-red);
    outline-offset: 1px;
  }

  /* The Units column is meaningless until a run is entered, so it stays out of
     the table until the script can fill it. */
  [data-acalc] .price-table th:last-child,
  [data-acalc] .price-table td:last-child {
    display: none;
  }
  [data-acalc].is-live .price-table th:last-child,
  [data-acalc].is-live .price-table td:last-child {
    display: table-cell;
  }

  .price-table th,
  .price-table td {
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    padding: 0.7rem 1rem 0.7rem 0;
    vertical-align: baseline;
  }
  .price-table thead th {
    border-bottom-color: rgb(255 255 255 / 0.22);
    color: var(--color-gm-grey-500);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .price-table tbody th {
    color: var(--color-gm-white);
    font-weight: 700;
  }
  .price-table tbody td {
    color: var(--color-gm-white);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }
  .price-table .num {
    padding-right: 0;
    padding-left: 1rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  /* The rate per metre is the number worth comparing on. */
  .price-table tbody td.rate {
    color: var(--color-gm-red);
  }
  .price-table tbody td.soft {
    color: var(--color-gm-grey-500);
    font-weight: 400;
  }
  .price-table tbody td.units {
    color: var(--color-gm-grey-300);
  }
  .price-table tbody tr:hover td,
  .price-table tbody tr:hover th {
    background: rgb(255 255 255 / 0.03);
  }
</style>

<script>
  import { add } from '@/lib/quote-cart';

  const root = document.querySelector<HTMLElement>('[data-acalc]');

  if (root) {
    const VAT = 0.15;

    const rand = (v: number): string =>
      `R ${new Intl.NumberFormat('en-US', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      }).format(v)}`;

    const runEl = root.querySelector<HTMLInputElement>('[data-calc-run]');
    const derivedEl = root.querySelector<HTMLElement>('[data-calc-derived]');
    const totalEl = root.querySelector<HTMLElement>('[data-calc-total]');
    const totalLinesEl = root.querySelector<HTMLElement>('[data-calc-total-lines]');
    const exEl = root.querySelector<HTMLElement>('[data-calc-ex]');
    const vatEl = root.querySelector<HTMLElement>('[data-calc-vat]');
    const inclEl = root.querySelector<HTMLElement>('[data-calc-incl]');
    const tableRows = Array.from(root.querySelectorAll<HTMLElement>('[data-ac-row]'));
    const calcRows = Array.from(root.querySelectorAll<HTMLElement>('[data-calc-row]'));

    /* A row the visitor has typed a quantity into is never overwritten by a
       later change to the run — their number wins over ours. */
    const edited = new WeakSet<HTMLElement>();

    /** Units needed to cover `run` metres with an item covering `each`. */
    const unitsFor = (run: number, each: number): number =>
      run > 0 && each > 0 ? Math.ceil(run / each) : 0;

    const recalc = () => {
      const run = Number(runEl?.value) || 0;

      if (derivedEl) {
        derivedEl.textContent =
          run > 0
            ? `Units to cover ${run} m, rounded up. Coils overlap at joints — add for that.`
            : 'Enter a run and each option below tells you how many units it takes.';
      }

      /* The reference tables get a per-row unit count, so the whole range can
         be compared at a glance rather than one selection at a time. */
      tableRows.forEach((row) => {
        const cell = row.querySelector<HTMLElement>('[data-ac-units]');
        if (!cell) return;
        const each = Number(row.dataset.length) || 0;
        const units = unitsFor(run, each);
        cell.textContent = units > 0 ? String(units) : '—';
      });

      let totalEx = 0;
      const lines: string[] = [];

      calcRows.forEach((row) => {
        const option = row.querySelector<HTMLSelectElement>('[data-calc-option]');
        const qtyEl = row.querySelector<HTMLInputElement>('[data-calc-qty]');
        const lineEl = row.querySelector<HTMLElement>('[data-calc-line]');
        if (!option || !qtyEl || !lineEl) return;

        const chosen = option.selectedOptions[0];
        const price = Number(chosen?.dataset.price) || 0;
        const each = Number(chosen?.dataset.length) || 0;

        /* A run fills every row from its coverage; failing that, a chosen
           item is worth one of. Without the fallback the Add button stayed
           dead until a run was typed. */
        if (!edited.has(row)) {
          const suggested = unitsFor(run, each);
          if (suggested > 0) qtyEl.value = String(suggested);
          else if (price && !Number(qtyEl.value)) qtyEl.value = '1';
        }

        const qty = Math.max(0, Math.floor(Number(qtyEl.value) || 0));
        if (!price || !qty) {
          const btn = row.querySelector<HTMLButtonElement>('[data-calc-add]');
          if (btn) btn.disabled = true;
          lineEl.classList.add('hidden');
          return;
        }

        const lineEx = Math.round(price * qty * 100) / 100;

        /* The button is only live once the row actually prices something. */
        const addBtn = row.querySelector<HTMLButtonElement>('[data-calc-add]');
        if (addBtn) {
          addBtn.disabled = false;
          addBtn.onclick = () => {
            const groupName =
              row.closest('[data-ac-group]')?.querySelector('h3')?.textContent?.trim() ?? 'Option';
            add({
              id: `ac:${chosen.value}`,
              group: groupName,
              label: chosen.value,
              unitEx: price,
              qty,
              detail: each > 0 ? `covers ${each} m per unit` : '',
            });
            addBtn.textContent = 'Added ✓';
            window.setTimeout(() => {
              addBtn.textContent = 'Add To Quote';
            }, 1600);
          };
        }
        lineEl.classList.remove('hidden');
        lineEl.textContent =
          `${qty} × ${rand(price)} = ${rand(lineEx)} excl. VAT` +
          (each > 0 ? ` · covers ${Math.round(each * qty * 100) / 100} m.` : '.');

        totalEx += lineEx;
        const name = row.closest('[data-ac-group]')?.querySelector('h3');
        lines.push(`${qty} × ${name?.textContent?.trim() ?? 'units'}`);
      });

      if (totalEx > 0) {
        /* VAT on the ex-VAT subtotal, the way the source's own total works. */
        const vat = Math.round(totalEx * VAT * 100) / 100;
        totalEl?.classList.remove('hidden');
        if (totalLinesEl) totalLinesEl.textContent = lines.join(' · ');
        if (exEl) exEl.textContent = rand(Math.round(totalEx * 100) / 100);
        if (vatEl) vatEl.textContent = rand(vat);
        if (inclEl) inclEl.textContent = rand(Math.round((totalEx + vat) * 100) / 100);
      } else {
        totalEl?.classList.add('hidden');
      }
    };

    root.classList.add('is-live');
    runEl?.addEventListener('input', recalc);
    calcRows.forEach((row) => {
      row.querySelector('[data-calc-option]')?.addEventListener('change', recalc);
      row.querySelector('[data-calc-qty]')?.addEventListener('input', () => {
        edited.add(row);
        recalc();
      });
    });
    recalc();
  }
</script>
