---
import { CTA } from '@data/nav';

/**
 * Section — "How It Works".
 *
 * Adapted from a reference site's pinned horizontal-scroll process timeline
 * (connecting line + numbered step markers, a card per step with a "why it
 * matters" sub-callout, a huge faint watermark word behind everything). The
 * layout is unchanged from that first pass — it was already right, and the
 * brief for this revision was explicitly "design is ok". What changed is the
 * content underneath it.
 *
 * The five steps now trace the client's own published process rather than
 * this site's internal cross-references. Every claim maps to something Wire
 * Ventures already states on fencing-supplier.com: what their enquiry form
 * asks for (project, products, quantities, site location, requirements) is
 * step 1; "expert product selection" and "custom sizes and specifications" is
 * step 2; "strict quality control" and "reduce lead times where possible" is
 * step 3; "competitive factory-direct pricing without unnecessary reseller
 * mark-ups" plus their bulk/trade/export enquiry route is step 4; and their
 * "Installation & Site Survey Request" option is step 5.
 *
 * Step 4 previously read "across the continental US — imperial units, US
 * specs, US support". That framing is gone site-wide: this is a Benoni,
 * Gauteng manufacturer quoting in rand, and the delivery step now says so.
 *
 * Step 5 still stops short of the reference's own "in-house crew, never
 * subcontractors" line — businessguide.md §"Do they install or repair?"
 * confirms that Guard Master installs, but not by which mechanism, so the
 * copy claims only the confirmed part.
 *
 * Sits between BuiltFor and FactoryDirect: who we protect, how the work
 * actually runs, then who is doing it.
 *
 * Static-first: the five steps are a real, always-scrollable horizontal
 * strip (same native scroll-snap technique as ProjectsShowcase) — nothing
 * here is hidden behind JS. Where JS + motion + a wide-enough viewport are
 * all available, the section pins and the horizontal position is driven by
 * vertical scroll instead (GSAP ScrollTrigger), with the step markers along
 * the connecting line filling in red to track progress. Below `lg`, under
 * reduced-motion, or with JS unavailable, it stays the plain scrollable strip
 * — a deliberately different reading (numbered cards + a "why it matters"
 * callout, no SVG diagrams) from ProjectsShowcase's schematic filmstrip, even
 * though both scroll horizontally, so the two don't read as the same
 * component twice.
 */

type Step = {
  id: string;
  title: string;
  body: string;
  why: string;
};

const STEPS: Step[] = [
  {
    id: 'scope',
    title: 'Scope The Site',
    body: 'Send us the project — products, quantities, site location and any specific requirements — or run your perimeter length through the estimator yourself for a bill of materials in minutes.',
    why: 'The quote is built on your actual run and site conditions, not a per-metre rate applied blind.',
  },
  {
    id: 'specify',
    title: 'Specify The System',
    body: 'Aperture, panel height, wire size and finish, plus posts, fixators, gates and toppings — selected across the full range, with custom sizes and specifications where the standard range does not fit.',
    why: 'Every component is chosen to work with the ones either side of it, so nothing has to be made to fit on site.',
  },
  {
    id: 'manufacture',
    title: 'Manufactured In-House',
    body: 'Panels, posts, fixings and razor wire are made on our own line in Benoni under strict quality control — not assembled from a reseller’s mixed-mill parts.',
    why: 'One manufacturer, one spec, start to finish — and shorter lead times wherever we can hold them.',
  },
  {
    id: 'deliver',
    title: 'Factory-Direct Delivery',
    body: 'Your order leaves the Benoni factory for your site — or for the port, on bulk, trade and export orders — at factory-direct pricing.',
    why: 'You pay the manufacturer’s price, with no reseller mark-up stacked on top of it.',
  },
  {
    id: 'install',
    title: 'Survey & Installation',
    body: 'Book a site survey and our team installs the system. Prefer your own contractor? Every system still ships with full installation guidance and our technical support through the build.',
    why: "You're not left holding a pallet of panels with no one to call once it lands.",
  },
];
---

<section
  data-process
  class="bg-gm-black text-gm-white relative isolate overflow-hidden py-20 sm:py-28"
>
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    style="background: radial-gradient(85% 110% at 15% 0%, rgba(228,17,42,0.10), transparent 55%);"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">How It Works</p>
      <h2
        class="font-display text-gm-white mt-5 text-4xl leading-[0.95] font-black tracking-tight uppercase sm:text-5xl lg:text-6xl"
      >
        You Spec It. <span class="text-gm-red">We Take It From There.</span>
      </h2>
      <p class="text-gm-grey-300 mt-6 max-w-xl text-base leading-relaxed">
        From first enquiry to a standing fence, here's exactly what happens — and who does it.
      </p>
    </div>
  </div>

  <!-- Horizontal step track. Native scroll-snap by default (works and is
       discoverable with touch/trackpad/JS off, same technique as
       ProjectsShowcase's filmstrip); a wide-enough desktop viewport with JS
       and motion allowed pins the section and drives this same track's
       position from vertical scroll instead. -->
  <div data-steps-wrapper class="relative mt-14 lg:mt-16">
    <p
      aria-hidden="true"
      class="text-gm-white pointer-events-none absolute inset-x-0 top-1/2 -z-10 -translate-y-1/2 text-center text-[20vw] leading-none font-black uppercase opacity-[0.04] select-none"
    >
      Process
    </p>

    <div
      data-steps-track
      tabindex="0"
      role="region"
      aria-label="Our five-step process, scroll horizontally"
      class="focus-visible:outline-gm-red mx-auto flex max-w-[1400px] snap-x snap-mandatory gap-8 overflow-x-auto scroll-smooth px-6 pb-6 focus-visible:outline-2 focus-visible:outline-offset-4 lg:gap-12 lg:px-8"
      style="scrollbar-width: none;"
    >
      {
        STEPS.map((s, i) => (
          <div data-process-step class="w-[300px] shrink-0 snap-start sm:w-[340px] lg:w-[380px]">
            <div class="flex items-center gap-3" aria-hidden="true">
              <span data-step-dot class="h-3 w-3 shrink-0 rounded-full border-2 border-white/25" />
              <span class="h-px flex-1 bg-white/15" />
            </div>

            <div class="mt-6 rounded-md border border-white/10 bg-white/[0.03] p-6">
              <span class="text-gm-red font-mono text-xs tracking-[0.2em] uppercase">
                Step 0{i + 1}
              </span>
              <h3 class="font-display text-gm-white mt-3 text-xl font-bold tracking-tight uppercase">
                {s.title}
              </h3>
              <p class="text-gm-grey-300 mt-2.5 text-sm leading-relaxed">{s.body}</p>
              <div class="border-gm-red/40 mt-5 border-l-2 pl-3">
                <p class="text-gm-red font-mono text-[10px] tracking-[0.18em] uppercase">
                  Why It Matters
                </p>
                <p class="text-gm-grey-400 mt-1.5 text-[12px] leading-relaxed">{s.why}</p>
              </div>
            </div>
          </div>
        ))
      }

      {
        /* trailing spacer so the last card can snap fully into view past the
          section's own right padding — same reasoning as ProjectsShowcase */
      }
      <div class="w-px shrink-0" aria-hidden="true"></div>
    </div>
  </div>

  <div class="mx-auto mt-14 max-w-[1400px] px-6 lg:px-8">
    <div class="flex flex-wrap gap-3">
      <a
        href={CTA.href}
        class="tap-target bg-gm-red text-gm-white inline-flex items-center px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
      >
        {CTA.label}
      </a>
      <a
        href="#contact"
        class="tap-target text-gm-white hover:border-gm-white inline-flex items-center border border-white/25 px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors"
      >
        Talk To Our Team
      </a>
    </div>
  </div>
</section>

<style>
  [data-process] [data-steps-track]::-webkit-scrollbar {
    display: none;
  }

  /* scroll-padding matches the track's own px-6/lg:px-8 padding — without it
     scroll-snap treats the padding as outside the "safe area" and auto-snaps
     past it on load, the same bug ProjectsShowcase hit. */
  [data-process] [data-steps-track] {
    scroll-padding-inline: 1.5rem;
  }
  @media (min-width: 1024px) {
    [data-process] [data-steps-track] {
      scroll-padding-inline: 2rem;
    }
  }

  /* Step-dot progress fill — only meaningful once the JS below is actively
     scrubbing the track from vertical scroll; in the native-scroll fallback
     (mobile, reduced-motion, no JS) the dots stay a plain hollow connector,
     not an implied progress state that never resolves. */
  [data-process] [data-step-dot] {
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }
  [data-process] [data-step-dot].is-active {
    background: var(--color-gm-red);
    border-color: var(--color-gm-red);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-process] [data-steps-track] {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-process]');
  const wrapper = section?.querySelector<HTMLElement>('[data-steps-wrapper]');
  const track = section?.querySelector<HTMLElement>('[data-steps-track]');

  const enhance = async () => {
    if (!section || !wrapper || !track) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    // Below `lg` the track is genuinely more comfortable as a normal
    // touch-scrollable strip — pinning the page to drive a horizontal swipe
    // gesture from vertical scroll fights the gesture visitors already know.
    if (!window.matchMedia('(min-width: 1024px)').matches) return;

    const [{ gsap }, { ScrollTrigger }] = await Promise.all([
      import('gsap'),
      import('gsap/ScrollTrigger'),
    ]);
    gsap.registerPlugin(ScrollTrigger);

    // Hero also pins itself, on its own independent idle-callback + dynamic
    // import, and its pin-spacer reserves real scroll-height above this
    // section. Nothing guarantees that spacer exists yet by the time this
    // section is ready to measure its own position — whichever section's
    // idle callback fires first wins the race. If this section measures
    // first, its start position comes out short by roughly Hero's pin
    // distance, so it pins ~900px too early: the wrapper locks to the
    // viewport while EstimatorTeaser is still legitimately scrolling past
    // above it, and the two render in the same space. A later
    // ScrollTrigger.refresh() does NOT fix this retroactively (verified —
    // the trigger's start stays wrong even long after Hero's spacer is
    // confirmed correct), so the fix is to not measure until the page's
    // height has actually stopped changing, not just "wait a while and
    // hope Hero won by then."
    const waitForStableLayout = async (maxWaitMs = 2500) => {
      const startedAt = performance.now();
      let lastHeight = document.documentElement.scrollHeight;
      let stableTicks = 0;
      while (performance.now() - startedAt < maxWaitMs) {
        await new Promise((resolve) => setTimeout(resolve, 100));
        const height = document.documentElement.scrollHeight;
        if (height === lastHeight) {
          stableTicks += 1;
          if (stableTicks >= 2) return;
        } else {
          stableTicks = 0;
          lastHeight = height;
        }
      }
    };
    await waitForStableLayout();

    // Hand off from native scroll to a GSAP-driven transform — both can't
    // own the track's position at once.
    track.style.overflow = 'visible';
    track.classList.remove('snap-x', 'snap-mandatory');
    track.scrollLeft = 0;

    const dots = gsap.utils.toArray<HTMLElement>('[data-step-dot]', section);
    // Measured against the TRACK's own width, not the wrapper's — the track
    // is capped at max-w-[1400px] and centered, while wrapper spans the
    // section's full (unconstrained) width. On any viewport wider than
    // ~1460px those two widths diverge, and using wrapper.clientWidth here
    // under-scrolls the track, permanently cropping the last card(s).
    const distance = () => Math.max(track.scrollWidth - track.clientWidth, 1);

    // The site header is `position: fixed` and sits on top of everything
    // (NavCenterSplit.astro), not pushed out of the layout — so a pin start
    // of 'top top' would lock the track flush with the viewport's true top
    // and slide the step-dots, connector line and "Step 0X" labels behind it
    // for the whole scroll. Pinning `headerHeight` lower instead keeps the
    // pinned track sitting just below the header the entire time.
    const headerHeight =
      document.querySelector<HTMLElement>('[data-nav]')?.getBoundingClientRect().height ?? 80;

    ScrollTrigger.create({
      trigger: wrapper,
      start: `top ${headerHeight}px`,
      end: () => '+=' + distance(),
      pin: true,
      scrub: 0.6,
      invalidateOnRefresh: true,
      onUpdate: (self) => {
        gsap.set(track, { x: -distance() * self.progress });
        const active = Math.min(dots.length - 1, Math.floor(self.progress * dots.length));
        dots.forEach((d, i) => d.classList.toggle('is-active', i <= active));
      },
    });
  };

  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => void enhance(), { timeout: 2000 });
  } else {
    setTimeout(() => void enhance(), 200);
  }
</script>
