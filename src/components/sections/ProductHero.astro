---
import PerimeterScene from '@components/ui/PerimeterScene.astro';

/**
 * Product hero — the homepage hero's composition, a different scene underneath.
 *
 * The brief was explicit: the top of a product page should read like the
 * homepage hero (tracked lead line, oversized headline, subhead, two CTAs,
 * trust strip along the bottom), but must not *be* the homepage hero. So the
 * layout is deliberately the same and everything inside it is different — dark
 * instead of daylight, a constructed perspective line drawing instead of the
 * photographic fence-and-clouds plate, and copy specific to the product rather
 * than to the company.
 *
 * The headline is one `<h1>` in two tiers: a small wide-tracked lead and a
 * tight oversized main line. They are two spans of one heading, not two
 * elements, so the page still has a single H1 and the accessible name reads as
 * one sentence ("Clear View 358 Mesh Fence Panels") rather than two fragments.
 *
 * No JS, and no `fullBleedHero` on the layout: an inner page keeps its
 * breadcrumb trail above the fold, so this hero starts below the header rather
 * than behind it. That is also why it is sized off `svh` with a cap instead of
 * filling the viewport — the homepage earns a full-height hero, an inner page
 * with a trail and a nav above it does not.
 */

interface Cta {
  label: string;
  href: string;
}

interface Props {
  eyebrow: string;
  /** Small tracked first line of the H1. */
  titleLead: string;
  /** Oversized second line of the H1. */
  titleMain: string;
  blurb: string;
  /** e.g. "From R 550,85 per panel" — rendered in the accent, never invented. */
  price?: string;
  /** Short factual chips along the bottom, the trust-strip slot. */
  stats?: string[];
  primary: Cta;
  secondary?: Cta;
  /** Text alternative for the drawn scene. */
  sceneLabel: string;
}

const {
  eyebrow,
  titleLead,
  titleMain,
  blurb,
  price,
  stats = [],
  primary,
  secondary,
  sceneLabel,
} = Astro.props;
---

<section
  class="bg-gm-black text-gm-white relative isolate flex min-h-[min(78svh,720px)] flex-col justify-center overflow-hidden py-20 sm:py-24"
>
  <div class="absolute inset-0 -z-20" aria-hidden="true">
    <PerimeterScene label={sceneLabel} />
  </div>

  {
    /* Legibility. The mesh puts fine lines straight behind the copy, so the
      scrim is strongest exactly where the type sits and clears toward the
      edges, leaving the drawing readable as a drawing. */
  }
  <div class="hero-scrim absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="relative mx-auto w-full max-w-[1400px] px-6 text-center lg:px-8">
    <p class="text-gm-red font-mono text-[11px] tracking-[0.34em] uppercase sm:text-xs">
      {eyebrow}
    </p>

    <h1 class="ph-title mx-auto mt-6 max-w-[16ch]">
      <span class="ph-title__lead">{titleLead}</span>{' '}
      <span class="ph-title__main">{titleMain}</span>
    </h1>

    <p class="text-gm-grey-300 mx-auto mt-7 max-w-xl text-[15px] leading-relaxed sm:text-base">
      {blurb}
    </p>

    {
      price && (
        <p class="text-gm-white mt-6 font-mono text-sm tracking-[0.06em]">
          <span class="text-gm-red">■</span> {price}
        </p>
      )
    }

    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a
        href={primary.href}
        class="tap-target bg-gm-red text-gm-white inline-flex items-center px-7 text-[12px] font-bold tracking-[0.12em] uppercase transition-colors hover:bg-[#c50e24]"
      >
        {primary.label}
      </a>
      {
        secondary && (
          <a
            href={secondary.href}
            class="tap-target text-gm-white hover:bg-gm-white hover:text-gm-black inline-flex items-center border border-white/30 px-7 text-[12px] font-bold tracking-[0.12em] uppercase transition-colors"
          >
            {secondary.label}
          </a>
        )
      }
    </div>

    {
      stats.length > 0 && (
        <ul class="text-gm-grey-400 mt-14 flex flex-wrap justify-center gap-x-8 gap-y-2 font-mono text-[11px] tracking-[0.16em] uppercase">
          {stats.map((stat) => (
            <li>{stat}</li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .hero-scrim {
    background:
      radial-gradient(
        62% 58% at 50% 46%,
        rgb(10 10 10 / 0.94) 0%,
        rgb(10 10 10 / 0.7) 55%,
        rgb(10 10 10 / 0.1) 100%
      ),
      linear-gradient(to bottom, rgb(10 10 10 / 0.55), rgb(10 10 10 / 0.2) 45%, rgb(10 10 10 / 0.7));
  }

  .ph-title {
    display: block;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .ph-title__lead {
    display: block;
    font-size: clamp(0.8rem, 1.4vw, 1.2rem);
    font-weight: 500;
    letter-spacing: 0.34em;
    color: var(--color-gm-grey-400);
    margin-bottom: 0.6em;
  }

  .ph-title__main {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.6vw, 4.4rem);
    font-weight: 900;
    letter-spacing: -0.035em;
    /* The tight tracking squeezes the space character too, so the words run
       together visually; word-spacing opens the gaps without loosening the
       letterforms. Same fix as the homepage headline. */
    word-spacing: 0.16em;
    line-height: 0.92;
    color: var(--color-gm-white);
  }
</style>
