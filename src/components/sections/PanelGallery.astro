---
import { findImage } from '@data/products';
import RevealFrame from '@components/ui/RevealFrame.astro';

/**
 * Clear View panels, photographed — the last section on the product page.
 *
 * Everything above this point on the page is drawn: the perspective hero, the
 * three medallions, the spec sheet, the aperture details, the assembly
 * drawing. That is the right register for explaining how a product works, and
 * the wrong one for answering "what does it look like on a real boundary". So
 * the page closes on photographs, and only photographs — the client's own, from
 * the "Products 2026" drop.
 *
 * A mosaic of unequal frames rather than a uniform grid: these were shot by
 * different people in different conditions and at different distances, and
 * forcing them into identical tiles crops the wide site shots into
 * meaninglessness while blowing the detail shots up past their resolution.
 * Letting the first frame run large and the rest fall in around it also stops
 * the section reading as the stock "gallery grid" animationguide.md §0 rules
 * out.
 *
 * **The frames are named, not sliced.** This used to take `images.slice(0, 9)`
 * off the panels group, which was wrong in a way that showed: that array is
 * ordered render-first on purpose (the homepage range card renders
 * `images[0]` at full size), so the first nine entries are eight white-
 * background studio renders and one photograph. The section directly above
 * them promised "our own photography — the panel as it lands on a site", and
 * every actual boundary photograph in the group sits at index 9 or later,
 * outside the slice. It also simply looked broken: white cut-outs floating on
 * a grey section, with the isolated post render contributing a tile that was
 * about 80% empty.
 *
 * So the five real in-context photographs are named by id instead. Naming
 * them fixes the picture and the sentence at the same time — the copy above
 * is now true rather than aspirational — and it survives the manifest being
 * reordered, which a slice never could.
 *
 * Five is also exactly what the mosaic wants: the lead spans 2 × 2 of a
 * four-column grid, and four singles fill the rest with no ragged tail.
 *
 * Zero JavaScript. Motion is RevealFrame's CSS-only hover — gated to pointer
 * devices, off under reduced motion. No lightbox: a lightbox on a product
 * page is a detour, and these are already served at their full width.
 */

/** In-context photographs only, lead first. Renders live in the sections
    above this one, where they are labelled as drawings. */
const SHOTS = [
  {
    id: 'clear-view-fencing-anti-cut-anti-climb-high-visibility',
    kicker: 'Open Ground',
    title: 'Sightline Kept',
    body: 'A galvanised run across open ground — the treeline and the hills behind it stay legible straight through the mesh.',
  },
  {
    id: 'clear-view-fencing-commercial-property-high-security-fencing-600x442',
    kicker: 'Commercial',
    title: 'Boundary And Access',
    body: 'Black powder coat along a commercial frontage, taken right up to the boom. The perimeter and the controlled entry are one continuous line.',
  },
  {
    id: 'clear-view-fencing-private-property-powder-coated-option-anti-climb-600x442',
    kicker: 'Private Property',
    title: 'The Garden Still Reads',
    body: 'Dark powder coat down a domestic boundary — lawn, planting, roofline and the trees beyond all come through the mesh from where this was taken.',
  },
  {
    id: '52',
    kicker: 'Office',
    title: 'Against The Building Line',
    body: 'Black 358 along a landscaped office boundary — anti-climb the whole way, and close to invisible from the building.',
  },
  /* Last frame is deliberately not a boundary. The obvious fifth candidate
     was `8` — a clean galvanised run against sky — but that file belongs to
     the same 640 × 640 composite series as the sector visualisations, and
     one render in a set introduced by "every frame is our own photography"
     is exactly the quiet untruth this component was just rewritten to
     remove. This is a real photograph of the real product instead. */
  {
    id: 'clear-view-high-security-anti-climb-fencing-panels-plain-galv',
    kicker: 'Plain Galvanised',
    title: 'Before It Goes Up',
    body: 'The same panel in plain galvanised, stacked at depth before installation — the curved stiffening ribs run through every sheet in the pile.',
  },
];

const images = SHOTS.map((shot) => ({
  ...shot,
  image: findImage('clear-view-fencing-panels', shot.id),
})).filter((shot): shot is (typeof SHOTS)[number] & { image: NonNullable<typeof shot.image> } =>
  Boolean(shot.image),
);

const [lead, ...rest] = images;
---

{
  lead && (
    <section class="bg-gm-grey-50 text-gm-black py-20 sm:py-28">
      <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
        <div class="flex flex-wrap items-end justify-between gap-8">
          <div class="max-w-2xl">
            <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">In The Field</p>
            <h2 class="font-display text-gm-black mt-5 text-3xl leading-[1.02] font-black tracking-tight uppercase sm:text-4xl lg:text-5xl">
              The Same Panel, <span class="text-gm-red">On Real Boundaries.</span>
            </h2>
            <p class="text-gm-grey-600 mt-6 text-base leading-relaxed">
              Drawings explain the product; these are the product. Every frame is our own
              photography — the panel as it lands on a site, in the finishes people actually order.
            </p>
          </div>
          <a
            href="/projects"
            class="tap-target border-gm-grey-300 text-gm-black hover:border-gm-black inline-flex items-center border px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors"
          >
            See Scope By Sector
          </a>
        </div>

        <div class="mt-14 grid gap-4 sm:mt-16 sm:grid-cols-2 lg:grid-cols-4">
          <RevealFrame
            image={lead.image}
            kicker={lead.kicker}
            title={lead.title}
            body={lead.body}
            sizes="(min-width: 1024px) 700px, 100vw"
            ratio="4 / 3"
            ratioLg="auto"
            class="sm:col-span-2 lg:row-span-2"
          />

          {rest.map((shot) => (
            <RevealFrame
              image={shot.image}
              kicker={shot.kicker}
              title={shot.title}
              body={shot.body}
              sizes="(min-width: 1024px) 340px, (min-width: 640px) 50vw, 100vw"
              ratio="4 / 3"
            />
          ))}
        </div>

        <p class="text-gm-grey-500 mt-8 max-w-2xl text-[11px] leading-relaxed">
          Finishes shown include plain galvanised, powder coated and Plascoat. Colour reproduction
          varies with light and screen — ask us for a physical sample before specifying a colour.
        </p>
      </div>
    </section>
  )
}
