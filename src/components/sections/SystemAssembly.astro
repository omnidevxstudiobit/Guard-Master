---
import { CTA } from '@data/nav';

/**
 * Section 3 — "Built As One System".
 *
 * businessguide.md §5: Guard Master sells an engineered system (post + panel +
 * fixings), not disconnected SKUs — that's the differentiator against
 * resellers stitching together parts from different mills. This section makes
 * that literal: an assembly chain — post, panel, fixture, accessory — that
 * joins together on scroll, rather than a grid of product cards.
 *
 * animationguide.md §0 explicitly rules out generic card/grid layouts ("kono
 * layout ba card ba besi grid use kora jabe na"). A plain tile grid of product
 * icons is the most common AI-generated landing-page pattern, so this section
 * is built around a sequence instead — the same reasoning that shaped
 * Proof358 (an interactive demonstration, not a feature grid).
 *
 * Light section: hero (light) → Proof358 (dark spec-lab) → here (light) —
 * the deliberate rhythm from designguide.md §4.
 *
 * All copy, specs and icons are static DOM, fully visible with no JS —
 * nothing here needs the script to be complete. Where JS *is* available and
 * motion is allowed, the assembly plays as a scroll-scrubbed GSAP timeline
 * (matching the hero's cloud/image parallax): each component's arrival is
 * tied directly to scroll position rather than firing on a timer the moment
 * the section enters view, so it visibly advances and reverses as the user
 * scrolls rather than "just happening" on load.
 */

type Node = {
  id: string;
  name: string;
  spec: string;
};

const NODES: Node[] = [
  {
    id: 'post',
    name: 'Clear View Posts',
    spec: '6 lengths, 6–12 ft · HDG, powder or Plascoat finish',
  },
  { id: 'panel', name: 'Clear View Panels', spec: '358 mesh · 3 apertures · sized to your run' },
  { id: 'fixture', name: 'Fixtures & Screws', spec: 'Flat or Spider clamp · HDG / powder / PVC' },
  { id: 'accessory', name: 'Accessories & Toppings', spec: 'Caps, gates, razor & spike topping' },
];
---

<section data-assembly class="bg-gm-white text-gm-black relative overflow-hidden py-20 sm:py-28">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">
        Manufacturer-Direct System
      </p>
      <h2
        class="font-display text-gm-black mt-5 text-4xl leading-[0.95] font-black tracking-tight uppercase sm:text-5xl lg:text-6xl"
      >
        Post to Cap. One Manufacturer, <span class="text-gm-red">One System.</span>
      </h2>
      <p class="text-gm-grey-600 mx-auto mt-6 max-w-xl text-base leading-relaxed">
        Every layer of the perimeter is engineered in-house to fit the one before it — post, panel,
        fixture and cap, made together and shipped together. Buy from a reseller stitching parts
        from different mills, and something is always a little off. Buy direct, and it isn't.
      </p>
    </div>

    <!-- Assembly chain — the four system components, joined in installation
         order. Stacks vertically on mobile; becomes a horizontal chain from
         lg up, each link a thin rule that draws in as the section reveals. -->
    <div data-chain class="mt-16 flex flex-col items-stretch lg:mt-20 lg:flex-row lg:items-start">
      {
        NODES.map((node, i) => (
          <>
            <div
              data-node
              data-id={node.id}
              class="chain-node flex flex-col items-center text-center lg:flex-1"
            >
              <span class="chain-icon border-gm-grey-200 bg-gm-white flex h-16 w-16 items-center justify-center rounded-full border">
                {node.id === 'post' && (
                  <svg viewBox="0 0 48 48" class="h-8 w-8" fill="none" aria-hidden="true">
                    <rect
                      class="draw"
                      pathLength="100"
                      x="18"
                      y="2"
                      width="12"
                      height="6"
                      rx="1"
                      stroke="#161616"
                      stroke-width="2"
                    />
                    <line
                      class="draw"
                      pathLength="100"
                      x1="24"
                      y1="8"
                      x2="24"
                      y2="42"
                      stroke="#161616"
                      stroke-width="2"
                    />
                    <line
                      class="draw"
                      pathLength="100"
                      x1="14"
                      y1="42"
                      x2="34"
                      y2="42"
                      stroke="#161616"
                      stroke-width="2"
                    />
                  </svg>
                )}
                {node.id === 'panel' && (
                  <svg viewBox="0 0 48 48" class="h-8 w-8" fill="none" aria-hidden="true">
                    <rect
                      class="draw"
                      pathLength="100"
                      x="6"
                      y="10"
                      width="36"
                      height="28"
                      stroke="#161616"
                      stroke-width="2"
                    />
                    <line
                      class="draw"
                      pathLength="100"
                      x1="16"
                      y1="10"
                      x2="16"
                      y2="38"
                      stroke="#161616"
                      stroke-width="1.4"
                    />
                    <line
                      class="draw"
                      pathLength="100"
                      x1="26"
                      y1="10"
                      x2="26"
                      y2="38"
                      stroke="#161616"
                      stroke-width="1.4"
                    />
                    <line
                      class="draw"
                      pathLength="100"
                      x1="36"
                      y1="10"
                      x2="36"
                      y2="38"
                      stroke="#161616"
                      stroke-width="1.4"
                    />
                    <line
                      class="draw"
                      pathLength="100"
                      x1="6"
                      y1="19"
                      x2="42"
                      y2="19"
                      stroke="#161616"
                      stroke-width="1.4"
                    />
                    <line
                      class="draw"
                      pathLength="100"
                      x1="6"
                      y1="29"
                      x2="42"
                      y2="29"
                      stroke="#161616"
                      stroke-width="1.4"
                    />
                  </svg>
                )}
                {node.id === 'fixture' && (
                  <svg viewBox="0 0 48 48" class="h-8 w-8" fill="none" aria-hidden="true">
                    <path
                      class="draw"
                      pathLength="100"
                      d="M12 10V34H36"
                      stroke="#161616"
                      stroke-width="2"
                      stroke-linecap="square"
                    />
                    <circle
                      class="draw"
                      pathLength="100"
                      cx="12"
                      cy="10"
                      r="3"
                      stroke="#161616"
                      stroke-width="2"
                    />
                    <circle
                      class="draw"
                      pathLength="100"
                      cx="36"
                      cy="34"
                      r="3"
                      stroke="#161616"
                      stroke-width="2"
                    />
                  </svg>
                )}
                {node.id === 'accessory' && (
                  <svg viewBox="0 0 48 48" class="h-8 w-8" fill="none" aria-hidden="true">
                    <path
                      class="draw"
                      pathLength="100"
                      d="M12 24Q24 8 36 24"
                      stroke="#161616"
                      stroke-width="2"
                      stroke-linecap="round"
                    />
                    <line
                      class="draw"
                      pathLength="100"
                      x1="24"
                      y1="24"
                      x2="24"
                      y2="42"
                      stroke="#161616"
                      stroke-width="2"
                    />
                  </svg>
                )}
              </span>

              <h3 class="font-display text-gm-black mt-5 text-sm font-bold tracking-wide uppercase">
                {node.name}
              </h3>
              <p class="text-gm-grey-500 mt-2 max-w-[15rem] text-[13px] leading-snug">
                {node.spec}
              </p>
            </div>

            {i < NODES.length - 1 && <div data-link class="chain-link" aria-hidden="true" />}
          </>
        ))
      }
    </div>

    <div class="mt-16 flex flex-wrap justify-center gap-3 lg:mt-20">
      <a
        href={CTA.href}
        class="tap-target bg-gm-red text-gm-white inline-flex items-center px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
      >
        Configure Your System
      </a>
      <a
        href="/clear-view-fencing-panels"
        class="tap-target border-gm-grey-300 text-gm-black hover:border-gm-black inline-flex items-center border px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors"
      >
        See Every Option
      </a>
    </div>
  </div>
</section>

<style>
  /* The connecting rule between two nodes. A short vertical stroke on mobile
     (nodes stack top to bottom); a horizontal stroke spanning the gap between
     nodes from lg up.
     --link-scale is what the script scrubs from 0 to 1 as the user scrolls
     past this link. The fallback of 1 is what renders with no JS or under
     reduced motion — a plain, fully-drawn line, no animation involved. The lg
     media query swaps which axis reads the same variable, so the script never
     needs to know or care which breakpoint is active. */
  [data-assembly] .chain-link {
    position: relative;
    flex: 0 0 auto;
    align-self: center;
    width: 2px;
    height: 40px;
    margin: 4px 0;
    background: var(--color-gm-grey-200);
    transform: scaleY(var(--link-scale, 1));
    transform-origin: top;
  }

  /* Weld-joint dot at the link's midpoint — the same mark used in Proof358's
     mesh pattern. Same variable-with-fallback approach: --joint-scale is
     scrubbed in once its link has drawn most of the way in; the fallback of 1
     keeps it visible with no JS or under reduced motion. */
  [data-assembly] .chain-link::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-gm-red);
    transform: translate(-50%, -50%) scale(var(--joint-scale, 1));
  }

  @media (min-width: 1024px) {
    [data-assembly] .chain-link {
      align-self: flex-start;
      margin: 31px 0 0;
      width: auto;
      height: 2px;
      flex: 1 1 32px;
      transform: scaleX(var(--link-scale, 1));
      transform-origin: left;
    }
  }

  /* Icon line-work — pathLength="100" on each shape normalises
     stroke-dasharray/dashoffset to the same 0–100 scale regardless of the
     shape's actual geometry, so the script can drive every icon with one
     dashoffset tween. Default is fully drawn (0), for no-JS / reduced motion;
     the script only ever writes an inline dashoffset once ScrollTrigger has
     computed where the icon's own scroll-linked progress actually sits, so it
     never flashes hidden before jumping to the correct state. */
  [data-assembly] .draw {
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-assembly]');

  /* Per-role entrance — each component arrives the way it's actually fitted,
     not a uniform fade-up. The post drops in like it's driven into the
     ground; the panel slides in off-axis like it's sliding onto the post;
     the fixture spins in tight like a clamp snapping shut; the cap drops
     from above. Every entrance uses a back-ease that overshoots slightly
     before settling — GSAP samples that eased position at whatever point the
     scrub's current progress lands on, forwards or backwards, so it reads
     the same "clicking into place" way on the way up as on the way down. */
  const FROM: Record<string, Record<string, number>> = {
    post: { y: -34 },
    panel: { x: -36, rotate: -5 },
    fixture: { scale: 0.5, rotate: -26 },
    accessory: { y: -26, scale: 0.65 },
  };
  const EASE: Record<string, string> = {
    fixture: 'back.out(2.3)',
  };

  const enhance = async () => {
    if (!section) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const [{ gsap }, { ScrollTrigger }] = await Promise.all([
      import('gsap'),
      import('gsap/ScrollTrigger'),
    ]);
    gsap.registerPlugin(ScrollTrigger);

    const nodes = gsap.utils.toArray<HTMLElement>('[data-node]', section);
    const links = gsap.utils.toArray<HTMLElement>('.chain-link', section);

    /* Not pinned — the chain plays out as the section scrolls past normally,
       tied to how far the user has scrolled through it rather than held in
       place. scrub smooths the timeline to the scroll position instead of
       jumping frame-to-frame, and (unlike the hero's crisp panel swap) is
       meant to track the scroll directly, so it runs and reverses exactly
       with the gesture instead of autoplaying once the section is in view. */
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top 85%',
        end: 'top 20%',
        scrub: 0.5,
      },
    });

    nodes.forEach((node, i) => {
      const id = node.dataset.id ?? '';
      const draws = node.querySelectorAll<SVGGeometryElement>('.draw');
      const pos = i; // one beat per node along the scrubbed timeline

      tl.fromTo(
        node,
        { opacity: 0, ...FROM[id] },
        {
          opacity: 1,
          x: 0,
          y: 0,
          rotate: 0,
          scale: 1,
          duration: 0.8,
          ease: EASE[id] ?? 'back.out(1.7)',
        },
        pos,
      );

      if (draws.length) {
        tl.fromTo(
          draws,
          { strokeDashoffset: 100 },
          { strokeDashoffset: 0, duration: 0.7, ease: 'none' },
          pos + 0.15,
        );
      }
    });

    links.forEach((link, i) => {
      const pos = i + 0.55; // draws in right after the node before it settles
      tl.fromTo(
        link,
        { '--link-scale': 0 },
        { '--link-scale': 1, duration: 0.6, ease: 'power2.out' },
        pos,
      ).fromTo(
        link,
        { '--joint-scale': 0 },
        { '--joint-scale': 1, duration: 0.4, ease: 'back.out(2.4)' },
        pos + 0.45,
      );
    });
  };

  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => void enhance(), { timeout: 2000 });
  } else {
    setTimeout(() => void enhance(), 200);
  }
</script>
