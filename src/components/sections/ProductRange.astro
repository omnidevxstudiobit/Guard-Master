---
import { PRODUCTS, priceLabel } from '@data/products';
import { CTA } from '@data/nav';
import ProductDrawing from '@components/ui/ProductDrawing.astro';

/**
 * Section — the range: four systems, four engineering renders, four prices.
 *
 * Replaces the ProjectsShowcase filmstrip that used to sit here. That section
 * drew five stylised site-plan schematics because no client photography
 * existed at the time and inventing named projects would have been a false
 * claim. Photography exists now, so this slot shows the actual range instead —
 * and the sector schematics weren't lost: /projects still carries all five,
 * and RecentProject.astro covers proof-in-the-field on this page with real
 * installation photographs.
 *
 * **Four tiles, not eight.** The first version of this section listed every
 * purchasable line as a peer — a R 8,06 clamp sitting at the same weight as a
 * whole fencing system. What the business actually sells is four things, and
 * everything else is a component inside one of them, so each tile leads with
 * the family and then names the parts underneath it (with their own from-price,
 * since that is the question a specifier is really asking).
 *
 * **Renders, not snapshots.** `images[0]` for every family is a studio
 * engineering render of the real assembly — see the render-first ordering in
 * scripts/build-product-images.mjs. Each is given a full-width frame at a
 * consistent 4:3, deliberately large: the whole argument of this section is
 * that the parts are engineered, and a thumbnail can't make that argument.
 *
 * Zero JavaScript. Four figures, four links, four price lists — an earlier
 * draft carried a hover-to-swap sticky media panel, which stopped earning its
 * complexity the moment every tile had its own full-size image.
 *
 * Light section: IntrusionAttempt (dark) → here (light) →
 * FinishLadder (dark), restoring designguide.md §4's alternation now that
 * SystemAssembly (the light section that used to break that dark run) has
 * moved off the homepage to the product pages.
 */
---

<section data-range class="bg-gm-white text-gm-black relative overflow-hidden py-20 sm:py-28">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">
        Manufacturer-Direct Range
      </p>
      <h2
        class="font-display text-gm-black mt-5 text-4xl leading-[0.95] font-black tracking-tight uppercase sm:text-5xl lg:text-6xl"
      >
        Four Systems. <span class="text-gm-red">One Factory.</span>
      </h2>
      <p class="text-gm-grey-600 mt-6 max-w-xl text-base leading-relaxed">
        Clear View fencing, razor wire mesh, concertina razor wire and temporary fencing — every
        component of all four made in Benoni and sold straight off the factory floor. Every price
        below is a real published list price, not a placeholder.
      </p>
    </div>

    <div class="mt-14 grid gap-8 lg:mt-16 lg:grid-cols-2 lg:gap-10">
      {
        PRODUCTS.map((product, i) => (
          <article class="border-gm-grey-200 group flex flex-col border">
            {/* Not a link. Wrapping the drawing in a third link to the same
                place would add a duplicate tab stop and a duplicate
                announcement for no gain — the heading and the button below
                both already go there, so this stays a figure. */}
            <figure class="bg-gm-grey-50 border-gm-grey-200 relative aspect-[4/3] overflow-hidden border-b p-4 sm:p-6">
              <ProductDrawing variant={product.drawing} label={product.drawingLabel} />
              <span
                class="text-gm-grey-400 absolute top-4 left-4 font-mono text-[10px] tracking-[0.2em] tabular-nums"
                aria-hidden="true"
              >
                0{i + 1}
              </span>
              <span
                class="text-gm-grey-400 absolute right-4 bottom-4 font-mono text-[9px] tracking-[0.18em] uppercase"
                aria-hidden="true"
              >
                Fig. 0{i + 1} · {product.shortName}
              </span>
            </figure>

            <div class="flex flex-1 flex-col p-6 sm:p-8">
              <p class="text-gm-red font-mono text-[10px] tracking-[0.2em] uppercase">
                {product.tagline}
              </p>
              <h3 class="font-display text-gm-black mt-3 text-2xl leading-none font-black tracking-tight uppercase sm:text-3xl">
                <a href={product.href} class="hover:text-gm-red transition-colors">
                  {product.name}
                </a>
              </h3>
              <p class="text-gm-grey-600 mt-4 text-[13px] leading-relaxed">{product.blurb}</p>

              <ul class="mt-5 flex flex-wrap gap-x-2 gap-y-2">
                {product.specs.map((spec) => (
                  <li class="border-gm-grey-200 text-gm-grey-600 border px-2.5 py-1 font-mono text-[10px] tracking-[0.08em] uppercase">
                    {spec}
                  </li>
                ))}
              </ul>

              {/* The parts inside the system, each with its own from-price —
                  the question a specifier is actually asking when they look
                  at a family tile. */}
              <dl class="border-gm-grey-200 mt-6 border-t">
                {product.includes.map((part) => (
                  <div class="border-gm-grey-100 flex items-baseline justify-between gap-4 border-b py-2.5">
                    <dt class="text-gm-grey-700 min-w-0 text-[12px]">
                      {part.href ? (
                        <a href={part.href} class="hover:text-gm-red font-bold transition-colors">
                          {part.name}
                        </a>
                      ) : (
                        <span class="font-bold">{part.name}</span>
                      )}
                      <span class="text-gm-grey-500 mt-0.5 block text-[11px] leading-snug">
                        {part.note}
                      </span>
                    </dt>
                    <dd class="text-gm-grey-600 shrink-0 font-mono text-[11px] whitespace-nowrap">
                      {part.priceFrom === null ? 'On request' : priceLabel(part)}
                    </dd>
                  </div>
                ))}
              </dl>

              <div class="mt-auto flex flex-wrap items-end justify-between gap-4 pt-6">
                <p>
                  <span class="text-gm-grey-500 block font-mono text-[10px] tracking-[0.18em] uppercase">
                    {product.priceFrom === null ? 'Pricing' : 'System from'}
                  </span>
                  <span class="font-display text-gm-black mt-1 block text-xl font-black tracking-tight">
                    {product.priceFrom === null ? 'On request' : priceLabel(product)}
                  </span>
                </p>
                <a
                  href={product.href}
                  class="tap-target bg-gm-black text-gm-white hover:bg-gm-red inline-flex items-center px-5 text-[12px] font-bold tracking-[0.08em] uppercase transition-colors"
                >
                  {product.hasPage ? 'See The System' : 'Get A Price'}
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-gm-grey-500 max-w-md text-[11px] leading-relaxed">
        Published list prices, VAT included, quoted as a <em>from</em> price for the lowest configuration
        of each item. Volume, project and installed pricing on request.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href={CTA.href}
          class="tap-target bg-gm-red text-gm-white inline-flex items-center px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
        >
          {CTA.label}
        </a>
        <a
          href="#contact"
          class="tap-target border-gm-grey-300 text-gm-black hover:border-gm-black inline-flex items-center border px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors"
        >
          Talk To Our Team
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  [data-range] article {
    transition: border-color 0.25s ease;
  }
  [data-range] article:hover,
  [data-range] article:focus-within {
    border-color: var(--color-gm-black);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-range] article {
      transition: none;
    }
  }
</style>
