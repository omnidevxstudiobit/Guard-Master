---
import { CTA } from '@data/nav';

/**
 * Section 2 — "Watch It Fail" (a break-in narrative).
 *
 * The scene panel is a direct port of the Claude Design project
 * "Fencing company redesign" → `Guard Master Site.dc.html`, whose hero visual
 * (`initHeroStory`) is the canonical version of this animation. The earlier
 * build of this section was adapted from a much shorter four-phase sketch of
 * the same idea; this replaces it with the ten-phase story the design
 * actually specifies:
 *
 *   enter → kneel → drill → fail → hatoff → exit → rope → throw → climb → spiked
 *
 * i.e. he walks the fence line with a drill, kneels, has three goes at one
 * weld, the weld wins, he flings the drill into the dirt, walks off, comes
 * back with a grapple, throws it over the top rail, climbs the line hand over
 * hand — and the spike topping stops him at the top and he slides back down.
 *
 * Ported faithfully from the design, including:
 * - The canvas scene: vertical/horizontal wires that heat up around the point
 *   of attack, posts, top rail, shark-tooth spikes with their own glow, the
 *   solar post light, ground line and its falloff gradient.
 * - The SVG intruder rig (walk + kneel poses) positioned over the canvas, its
 *   gait driven by distance travelled so the feet never slide, plus the
 *   canvas-painted rope climber whose hands grip and feet clamp the line.
 * - Rigid-body physics for the flung drill (gravity, ground bounce, roll to
 *   rest) and the grapple's ballistic arc and elastic bite on the rail.
 *
 * Two deliberate departures from a literal copy, both about fitting a
 * fixed-pixel design into a responsive section rather than changing what it
 * looks like:
 *
 * 1. Uniform scale. The design's panel is a fixed ~660×760; every constant in
 *    it (the 186px rig, 46px wire pitch, 15px wire rise) is a CSS pixel. Drawn
 *    1:1 into a shorter panel the intruder would tower over the fence. So the
 *    scene is rendered in the design's own units against a fixed virtual
 *    height of 760, and the canvas context, the rig and the overlay positions
 *    are all multiplied by one scale factor S = renderedHeight / 760. At the
 *    design's own height that is S = 1 and the output is pixel-identical; at
 *    any other height it is the same picture, uniformly zoomed, showing more
 *    or less fence to the sides exactly as widening the design's own panel
 *    would.
 * 2. Static-first fallback. The design's panel is blank until its script runs.
 *    This site keeps a no-JS / reduced-motion resting frame — the story's
 *    ENDING (intruder slumped at the fence base, stamp and callout showing),
 *    drawn as real SVG at the design's exact geometry, hidden the moment the
 *    canvas story arms.
 *
 * Markup the design carries but never shows is dropped rather than ported:
 * the `gm-crate` prop (opacity is pinned to 0 for every phase), the `gm-hat`
 * prop (`display:none` on the first line of the story, the flung tool is
 * canvas-drawn), and the `gm-pose-air` rig (its blend factor is 0 in all ten
 * phases). Their behaviour is unchanged by their absence.
 *
 * The caption card below the scene is this site's own, not the design's — it
 * is wired to the design's phase tag/title/sub and progress bar. It sits over
 * the panel, so the canvas stage is inset above it (`--ia-card-h`, measured
 * live) instead of being drawn behind it: everything the story does stays
 * visible, which was the whole point of the earlier version's bottom-edge
 * pinning.
 */

type Phase = {
  mode:
    | 'enter'
    | 'kneel'
    | 'drill'
    | 'fail'
    | 'hatoff'
    | 'exit'
    | 'rope'
    | 'throw'
    | 'climb'
    | 'spiked';
  dur: number;
  hud: 0 | 1;
  tag: string;
  title: string;
  sub: string;
  stamp?: string;
  callout?: string;
};

const PHASES: Phase[] = [
  {
    mode: 'enter',
    dur: 4800,
    hud: 0,
    tag: '02:14 — Perimeter',
    title: 'A thief walks the fence line.',
    sub: 'After dark. Hood up, drill in hand, looking for a weak point. There isn’t one.',
  },
  {
    mode: 'kneel',
    dur: 1700,
    hud: 0,
    tag: 'Attempt 01 — Setup',
    title: 'He kneels to the weld.',
    sub: 'Braced on one knee, both hands on the drill, weight over the bit.',
  },
  {
    mode: 'drill',
    dur: 6000,
    hud: 0,
    tag: 'Attempt 01 — Drilling',
    title: 'Three goes at one weld.',
    sub: 'The bit chatters, walks off the wire and kicks the drill back at him each time.',
  },
  {
    mode: 'fail',
    dur: 3200,
    hud: 0,
    tag: 'Attempt 01 — Denied',
    title: 'The weld won’t give.',
    sub: '500–650 MPa high-tensile wire welded at 80% of parent steel. The bit dulls first.',
    stamp: 'WON’T CUT',
    callout:
      'Ø 3.5–5.6 mm wire · 500–650 MPa · welded at 80% of parent steel — the bit dulls first.',
  },
  {
    mode: 'hatoff',
    dur: 3200,
    hud: 0,
    tag: 'Attempt 01 — Over',
    title: 'The drill goes into the dirt.',
    sub: 'Flung away. Nothing handheld is getting through this mesh.',
  },
  {
    mode: 'exit',
    dur: 4400,
    hud: 1,
    tag: 'Attempt 02 — Regroup',
    title: 'He walks off for another way over.',
    sub: 'If he can’t go through it, the only way left is over the top.',
  },
  {
    mode: 'rope',
    dur: 5000,
    hud: 1,
    tag: 'Attempt 02 — Rope',
    title: 'He comes back with a grapple.',
    sub: 'A coil of line and a three-prong hook — the classic way over a fence.',
  },
  {
    mode: 'throw',
    dur: 2400,
    hud: 1,
    tag: 'Attempt 02 — The Throw',
    title: 'He throws the hook over.',
    sub: 'One swing and the grapple arcs up and bites on the top rail.',
  },
  {
    mode: 'climb',
    dur: 6600,
    hud: 1,
    tag: 'Attempt 02 — The Climb',
    title: 'He climbs the line.',
    sub: 'Knees up, feet clamped, drive and pull — hand over hand up the rope.',
  },
  {
    mode: 'spiked',
    dur: 4400,
    hud: 1,
    tag: 'Attempt 02 — Denied',
    title: 'The spikes stop him dead.',
    sub: 'Nothing to grab, no way to swing a leg over — he slides straight back down.',
    stamp: 'NO WAY OVER',
    callout: 'Anti-climb spike topping on a 3 m panel — no grip, no landing, nothing to stand on.',
  },
];

// The static, no-JS / reduced-motion resting frame is the story's ending —
// the last phase (spiked), not the first. See the doc comment above.
const RESTING = PHASES[PHASES.length - 1]!;

/* ---------------------------------------------------------------------------
   Static fallback geometry — the design's own scene constants evaluated at its
   own panel size, so the resting SVG below is the exact frame the canvas would
   draw at S = 1. Kept in sync with the script's constants by construction:
   same numbers, same names.

   The one adjustment: the design's panel is 760 tall with its ground line at
   0.86 of that, leaving ~106px of empty foreground dirt below it. The design
   has nothing under that dirt; this section has the caption card, and the two
   stacked read as a gap. So the visible frame is cropped to the ground line
   plus a thin FOREGROUND strip — the rail and ground stay at their design
   heights, only empty dirt is trimmed.
   --------------------------------------------------------------------------- */
const SW = 660; // design panel width
const DESIGN_H = 760; // the design's own panel height
const VX = 46; // vertical wire pitch
const HY = 15; // horizontal wire rise
const RIG_H = 186; // intruder rig height

const TR = Math.round(DESIGN_H * 0.2); // top rail line
const GY = Math.round(DESIGN_H * 0.86); // ground line
const FOREGROUND = 18; // dirt kept below the ground line
const SH = GY + FOREGROUND; // the visible frame's height
const OX = (SW % VX) / 2;
const XS = OX + Math.round((SW * 0.44 - OX) / VX) * VX; // the attacked wire column

const V_WIRES: number[] = [];
for (let x = OX; x <= SW; x += VX) V_WIRES.push(x);

const H_WIRES: number[] = [];
for (let y = TR + HY; y < GY; y += HY) H_WIRES.push(y);

const POSTS: number[] = [];
for (let px = OX + 2 * VX; px < SW; px += 6 * VX) POSTS.push(px);
const LAMP_X = POSTS.filter((px) => px < SW * 0.92).at(-1) ?? POSTS[0]!;

const SPIKES: number[] = [];
for (let sx = 0; sx < SW; sx += 16) SPIKES.push(sx);

// Where the beaten intruder ends up: the climb anchor column, less the rig's
// own offset, standing on the ground line.
const REST_X = XS - 72;
const REST_Y = GY - RIG_H;
---

<section data-intrusion class="bg-gm-black text-gm-white relative overflow-hidden py-20 sm:py-28">
  <div
    class="mx-auto grid max-w-[1400px] items-center gap-14 px-6 lg:grid-cols-[1fr_1.05fr] lg:gap-16 lg:px-8"
  >
    <div class="min-w-0">
      <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Watch It Fail</p>
      <h2
        class="font-display text-gm-white mt-5 text-4xl leading-[0.95] font-black tracking-tight uppercase sm:text-5xl lg:text-6xl"
      >
        Two Ways In. <span class="text-gm-red">Zero Ways Through.</span>
      </h2>
      <p class="text-gm-grey-300 mt-6 max-w-xl text-base leading-relaxed">
        Force doesn't open 358 mesh. Neither does climbing it. Here's what actually happens when
        someone tries.
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href={CTA.href}
          class="tap-target bg-gm-red text-gm-white inline-flex items-center px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
