                    <path d="M56.5 76 A13.5 13.5 0 0 1 83.5 76 L83.5 72 L56.5 72 Z" fill="#191b23"
                    ></path>
                  </g>
                  <g transform="rotate(30 76 96)">
                    <line
                      x1="76"
                      y1="96"
                      x2="52"
                      y2="112"
                      stroke="#23252e"
                      stroke-width="12"
                      stroke-linecap="round"></line>
                    <line
                      x1="52"
                      y1="112"
                      x2="34"
                      y2="126"
                      stroke="#2b2d38"
                      stroke-width="11"
                      stroke-linecap="round"></line>
                    <circle cx="31" cy="128" r="6.5" fill="#414552" opacity="0.38"></circle>
                  </g>
                  <g transform="rotate(26 76 96)">
                    <line
                      x1="76"
                      y1="96"
                      x2="54"
                      y2="104"
                      stroke="#2f313d"
                      stroke-width="12"
                      stroke-linecap="round"></line>
                    <line
                      x1="54"
                      y1="104"
                      x2="36"
                      y2="118"
                      stroke="#383b48"
                      stroke-width="11"
                      stroke-linecap="round"></line>
                    <circle cx="33" cy="120" r="6.5" fill="#4a4e5c"></circle>
                  </g>
                </g>
              </g>
            </svg>

            {
              /* Stamp + callout ride inside the shake wrapper, exactly as the
                design has them. Both are revealed by default: the resting
                state is the story's ending, so its stamp and callout should
                already be showing rather than waiting on JS that never runs
                under reduced motion. The cycle's own stampHide()/calloutHide()
                reset them the instant it starts. The script positions them in
                px from the scene geometry; the classes here are the pre-script
                fallback for that same position. */
            }
            <div
              data-stamp
              class="border-gm-red font-display text-gm-red pointer-events-none absolute top-[37%] left-[38%] z-[3] border-[3px] px-3 py-1.5 text-base leading-none font-black tracking-[0.05em] whitespace-nowrap uppercase sm:px-5 sm:py-2.5 sm:text-2xl"
              style="background:rgba(6,6,7,0.55); box-shadow:0 0 34px rgba(228,17,42,0.35); transform:scale(1) rotate(-8deg); transition:transform .3s cubic-bezier(.2,1.5,.35,1), opacity .25s ease;"
            >
              {RESTING.stamp}
            </div>

            <div
              data-callout
              class="pointer-events-none absolute top-[calc(37%+70px)] left-[6%] z-[3] hidden w-[300px] max-w-[62%] sm:block"
              style="transition:opacity .5s ease .25s, transform .5s ease .25s;"
            >
              <div class="flex items-center">
                <span class="bg-gm-red h-3 w-px"></span><span class="bg-gm-red h-px flex-1"
                ></span><span class="bg-gm-red h-3 w-px"></span>
              </div>
              <p
                data-callout-text
                class="mt-2.5 font-mono text-[12.5px] leading-[1.6] text-[#ffd7dc]"
                style="text-shadow:0 2px 8px rgba(0,0,0,0.8);"
              >
                {RESTING.callout}
              </p>
            </div>
          </div>

          <div class="ia-crt" aria-hidden="true"></div>
          <div class="ia-scanline" aria-hidden="true"></div>

          <!-- HUD -->
          <div class="absolute top-4 right-4 z-[3] flex gap-2">
            <span
              data-hud-tab="0"
              class:list={[
                'rounded-sm border px-1.5 py-1 font-mono text-[8px] tracking-[0.1em] uppercase sm:px-2.5 sm:py-1.5 sm:text-[11px] sm:tracking-[0.14em]',
                RESTING.hud === 0 ? 'is-active' : '',
              ]}>01 · Cut</span
            >
            <span
              data-hud-tab="1"
              class:list={[
                'rounded-sm border px-1.5 py-1 font-mono text-[8px] tracking-[0.1em] uppercase sm:px-2.5 sm:py-1.5 sm:text-[11px] sm:tracking-[0.14em]',
                RESTING.hud === 1 ? 'is-active' : '',
              ]}>02 · Height</span
            >
          </div>
        </div>

        <!-- Caption card. Not part of the design's panel — this site's own
             narration of the same phases. Flush to the panel's own edges (the
             panel clips it to its rounded corners), so there's no dead margin
             between the scene and the copy; the stage above measures it
             (--ia-card-h) and stops at its top edge, so the story never plays
             behind it. -->
        <div
          data-caption-card
          class="absolute inset-x-0 bottom-0 z-[3] overflow-hidden border-t border-white/12 bg-black/70 p-4 backdrop-blur-md sm:p-5"
        >
          <div data-phase-bar class="bg-gm-red absolute top-0 left-0 h-[2px]" style="width: 100%;">
          </div>
          <div class="mb-2 flex items-center gap-2.5 sm:mb-2.5">
            <span
              data-phase-tag
              class="text-gm-red font-mono text-[11px] tracking-[0.2em] whitespace-nowrap uppercase"
              >{RESTING.tag}</span
            >
            <span class="h-px flex-1 bg-white/15"></span>
          </div>
          <p
            data-phase-title
            class="font-display text-gm-white text-base leading-none font-black uppercase sm:text-lg"
          >
            {RESTING.title}
          </p>
          <p data-phase-sub class="text-gm-grey-300 mt-2 text-[13px] leading-relaxed">
            {RESTING.sub}
          </p>
        </div>
      </div>
    </figure>
  </div>

  <script is:inline type="application/json" data-phases set:html={JSON.stringify(PHASES)} />
</section>

