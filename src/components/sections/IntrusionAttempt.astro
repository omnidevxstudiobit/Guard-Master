                  y1="74"
                  x2="48"
                  y2="96"
                  stroke="#2b2d38"
                  stroke-width="12"
                  stroke-linecap="round"></line>
                <line
                  x1="90"
                  y1="82"
                  x2="42"
                  y2="104"
                  stroke="#2b2d38"
                  stroke-width="12"
                  stroke-linecap="round"></line>
                <line
                  x1="46"
