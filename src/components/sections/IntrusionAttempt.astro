---
import { CTA } from '@data/nav';

/**
 * Section 2 — "Watch It Fail" (a break-in narrative).
 *
 * Adapted from a design exploration ("hero 1B" in that artifact's own
 * labelling — a different concept from the split-copy 1B this site's
 * Proof358 was built from). The user asked for it as its own section, not a
 * hero replacement — Hero.astro is untouched. It sits between Hero and
 * Proof358 on purpose: Hero makes the promise, this dramatises it (an
 * intruder tries force, then climbing, and fails both), and Proof358 gives
 * the technical version of the same claim right after — show, then tell.
 *
 * Every number in the original mockup's captions (500–650 MPa, 80% weld
 * strength, Ø3.5–5.6 mm wire) doesn't appear anywhere in businessguide.md,
 * designguide.md or seoguide.md — likely placeholders from whatever
 * reference the mockup pulled from, not vetted facts. The captions below are
 * rewritten around what IS verified: the 76.2 × 12.7 mm aperture, the 4.0 mm
 * wire (businessguide §5 / Proof358's own preset data), and spike/razor
 * topping as real optional extras (businessguide §5 "Estimator Extras").
 *
 * Architecture, adapted rather than ported wholesale:
 * - The original redraws its whole scene from scratch every frame on a
 *   <canvas>. Only the thief, the glow and the sparks actually change frame
 *   to frame — the mesh, spikes and light are static here, real SVG,
 *   drawn once. Cheaper, and the mesh is real DOM (a crawler/AT can at least
 *   tell there's a diagram here, same reasoning as Proof358's SVG pattern).
 * - Position math is in the scene's own 0–400×0–300 viewBox instead of
 *   canvas-pixel-and-devicePixelRatio math, so there's no resize handler or
 *   backing-store recalculation to keep in sync — the SVG scales itself.
 * - The glow is the same "hot" red-reveal idea as Proof358's mesh-hot layer
 *   (a moving red highlight over grey mesh), reused here as a radial instead
 *   of a linear sweep. The sparks are the exact spawn/drift/fade WAAPI
 *   pattern built for Proof358's weld sparks.
 * - Static-first: the four-phase cycle is what plays with JS + motion
 *   allowed, but the resting/no-JS/reduced-motion state is the STORY'S
 *   ENDING rendered statically (the intruder blocked at the top, stamp and
 *   callout showing) — a complete statement on its own, not a broken
 *   half-loaded scene.
 */

type Phase = {
  id: 'force' | 'forceFail' | 'climb' | 'spikeFail';
  hud: 0 | 1;
  durationMs: number;
  tag: string;
  title: string;
  sub: string;
  stamp?: string;
  callout?: string;
};

const PHASES: Phase[] = [
  {
    id: 'force',
    hud: 0,
    durationMs: 4600,
    tag: 'Attempt 01 — Force',
    title: 'A Crowbar Hits The Mesh.',
    sub: 'Under cover of night, he pries and hammers at the wire. It flexes — and holds.',
  },
  {
    id: 'forceFail',
    hud: 0,
    durationMs: 3400,
    tag: 'Attempt 01 — Denied',
    title: 'It Won’t Break.',
    sub: 'There’s no strand to pry apart, no weave to spread — just a welded grid that springs back.',
    stamp: 'WON’T BREAK',
    callout: '4.0 mm (8ga) wire · welded node-by-node, not woven',
  },
  {
    id: 'climb',
    hud: 1,
    durationMs: 4600,
    tag: 'Attempt 02 — The Climb',
    title: 'He Tries To Go Over.',
    sub: 'Fingertips barely fit the 12.7 mm gap — nothing to grip, nowhere to stand.',
  },
  {
    id: 'spikeFail',
    hud: 1,
    durationMs: 3800,
    tag: 'Attempt 02 — Denied',
    title: 'No Way Past The Top.',
    sub: 'Add spike or razor topping from the estimator, and there’s nothing left to try.',
    stamp: 'BLOCKED',
    callout: 'Optional spike & razor topping · configured in the estimator',
  },
];

// The static, no-JS / reduced-motion resting frame is the story's ending —
// phase index 3 (spikeFail) — not phase 0. See the doc comment above.
const RESTING = PHASES[3];
---

<section data-intrusion class="bg-gm-black text-gm-white relative overflow-hidden py-20 sm:py-28">
  <div
    class="mx-auto grid max-w-[1400px] items-center gap-14 px-6 lg:grid-cols-[1fr_1.05fr] lg:gap-16 lg:px-8"
  >
    <div class="min-w-0">
      <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Watch It Fail</p>
      <h2
        class="font-display text-gm-white mt-5 text-4xl leading-[0.95] font-black tracking-tight uppercase sm:text-5xl lg:text-6xl"
      >
        Two Ways In. <span class="text-gm-red">Zero Ways Through.</span>
      </h2>
      <p class="text-gm-grey-300 mt-6 max-w-xl text-base leading-relaxed">
        Force doesn't open 358 mesh. Neither does climbing it. Here's what actually happens when
        someone tries.
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href={CTA.href}
          class="tap-target bg-gm-red text-gm-white inline-flex items-center px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
        >
          {CTA.label}
        </a>
        <a
          href="#the-proof"
          class="tap-target text-gm-white hover:border-gm-white inline-flex items-center border border-white/25 px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors"
        >
          See The Full Breakdown
        </a>
      </div>
    </div>

    <!-- RIGHT — the scene -->
    <figure data-scene-figure class="m-0">
      <div
        data-scene
        class="relative overflow-hidden rounded-md border border-white/10"
        style="background: linear-gradient(180deg, #0b0d16 0%, #0d0a10 45%, #08080a 100%);"
      >
        {
          /* Night atmosphere behind the mesh — a soft moon glow and a
            handful of twinkling stars, plus a faint CRT scanline texture and
            a slow security-scanner sweep in front of everything. Pure CSS,
            the same "cheap enough to run unconditionally" exception as the
            solar light's pulse below; switched off under reduced-motion in
            the <style> block. */
        }
        <div class="ia-moon" aria-hidden="true"></div>
        <div class="ia-moon-shade" aria-hidden="true"></div>
        <div class="ia-star" style="top:38%; left:55%;" aria-hidden="true"></div>
        <div class="ia-star" style="top:18%; left:85%; animation-delay:0.6s;" aria-hidden="true">
        </div>
        <div class="ia-star" style="top:11%; left:32%; animation-delay:1.1s;" aria-hidden="true">
        </div>
        <div class="ia-star" style="top:46%; left:78%; animation-delay:0.3s;" aria-hidden="true">
        </div>
        <div class="ia-star" style="top:26%; left:8%; animation-delay:1.8s;" aria-hidden="true">
        </div>

        <div data-scene-shake class="relative">
          <svg data-scene-svg viewBox="0 0 400 300" class="block h-auto w-full" aria-hidden="true">
            <defs>
              <radialGradient id="ia-glow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#e4112a" stop-opacity="0.65"></stop>
                <stop offset="100%" stop-color="#e4112a" stop-opacity="0"></stop>
              </radialGradient>
              <radialGradient id="ia-solar" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#ffe8cd" stop-opacity="0.5"></stop>
                <stop offset="100%" stop-color="#ffe8cd" stop-opacity="0"></stop>
              </radialGradient>
            </defs>

            {/* Ground */}
            <rect x="0" y="230" width="400" height="70" fill="#0d0d10"></rect>
            <line x1="0" y1="230" x2="400" y2="230" stroke="rgba(160,163,175,0.3)" stroke-width="1"
            ></line>

            {/* Static mesh grid — real DOM, drawn once. */}
            <g stroke="rgba(175,178,188,0.26)" stroke-width="1.2">
              {
                Array.from({ length: 21 }, (_, i) => i * 20).map((x) => (
                  <line x1={x} y1="40" x2={x} y2="230" />
                ))
              }
            </g>
            <g stroke="rgba(150,153,163,0.16)" stroke-width="0.8">
              {
                Array.from({ length: 13 }, (_, i) => 40 + i * 15).map((y) => (
                  <line x1="0" y1={y} x2="400" y2={y} />
                ))
              }
            </g>
            {/* posts */}
            <g fill="#20212a">
              {[40, 140, 240, 340].map((x) => <rect x={x - 3} y="30" width="6" height="204" />)}
            </g>
            {/* top rail + spikes */}
            <rect x="0" y="34" width="400" height="6" fill="#282933"></rect>
            <g fill="#2e2f3a">
              {
                Array.from({ length: 34 }, (_, i) => i * 12).map((x) => (
                  <path d={`M${x},34 L${x + 6},14 L${x + 12},34 Z`} />
                ))
              }
            </g>

            {
              /* Solar security light — a small product tie-in, always-on ambient
              pulse, no JS needed. */
            }
            <g>
              <circle cx="340" cy="34" r="46" fill="url(#ia-solar)" class="ia-solar-pulse"></circle>
              <circle cx="340" cy="34" r="3" fill="#ffe8cd"></circle>
            </g>

            {
              /* The "hot" glow — a moving red highlight, same idea as Proof358's
              mesh-hot reveal, driven by the script (cx/cy/opacity/r each
              frame) rather than CSS, since its position genuinely moves with
              the story instead of sweeping on a fixed loop. */
            }
            <circle data-glow cx="180" cy="170" r="0" fill="url(#ia-glow)" opacity="0"></circle>

            {
              /* Sparks — populated/removed by the script, exact technique as
              Proof358's weld sparks. */
            }
            <g data-spark-layer></g>

            {
              /* The intruder. Hidden by default (no-JS / reduced-motion resting
              state shows the recoil pose, positioned statically below) —
              the script repositions and reveals it once the cycle starts. */
            }
            <g data-thief style="opacity:0" transform="translate(120,120) scale(0.42)">
              <g data-pose="force" style="opacity:1">
                <circle cx="88" cy="52" r="14" fill="#2b2d38"></circle>
                <path d="M72 52 Q84 30 104 48 L102 58 Q88 44 76 58 Z" fill="#2b2d38"></path>
