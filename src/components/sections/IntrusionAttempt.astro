<script>
  /* Port of `initHeroStory` from the Claude Design project's
     `Guard Master Site.dc.html`. See the component's frontmatter comment for
     what was carried over verbatim and the two places this deviates. */

  type Phase = {
    mode:
      | 'enter'
      | 'kneel'
      | 'drill'
      | 'fail'
      | 'hatoff'
      | 'exit'
      | 'rope'
      | 'throw'
      | 'climb'
      | 'spiked';
    dur: number;
    hud: 0 | 1;
    tag: string;
    title: string;
    sub: string;
    stamp?: string;
    callout?: string;
  };

  const section = document.querySelector<HTMLElement>('[data-intrusion]');
  const dataEl = section?.querySelector<HTMLScriptElement>('[data-phases]');
  const scene = section?.querySelector<HTMLElement>('[data-scene]');
  const cv = section?.querySelector<HTMLCanvasElement>('[data-canvas]');
  const ctx = cv?.getContext('2d') ?? null;
  const thief = section?.querySelector<HTMLElement>('[data-thief]');
  const thiefIn = section?.querySelector<HTMLElement>('[data-thief-in]');
  const card = section?.querySelector<HTMLElement>('[data-caption-card]');

  const reduce =
    typeof window !== 'undefined' && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && dataEl && scene && cv && ctx && thief && thiefIn && card && !reduce) {
    const PHASES = JSON.parse(dataEl.textContent || '[]') as Phase[];

    const q = <T extends Element>(sel: string) => section.querySelector<T>(sel);
    const restingScene = q<SVGSVGElement>('[data-resting-scene]');
    const shakeEl = q<HTMLElement>('[data-shake]');
    const poseWalk = q<SVGGElement>('[data-pose="walk"]');
    const poseKneel = q<SVGGElement>('[data-pose="kneel"]');
    const legA = q<SVGGElement>('[data-part="leg-a"]');
    const legB = q<SVGGElement>('[data-part="leg-b"]');
    const armF = q<SVGGElement>('[data-part="arm-front"]');
    const armB = q<SVGGElement>('[data-part="arm-back"]');
    const kBody = q<SVGGElement>('[data-part="k-body"]');
    const kHead = q<SVGCircleElement>('[data-part="k-head"]');
    const kArmA = q<SVGGElement>('[data-part="k-arm-a"]');
    const kArmB = q<SVGGElement>('[data-part="k-arm-b"]');
    const stampEl = q<HTMLElement>('[data-stamp]');
    const callout = q<HTMLElement>('[data-callout]');
    const calloutTxt = q<HTMLElement>('[data-callout-text]');
    const hud = [q<HTMLElement>('[data-hud-tab="0"]'), q<HTMLElement>('[data-hud-tab="1"]')];
    const barEl = q<HTMLElement>('[data-phase-bar]');
    const tagEl = q<HTMLElement>('[data-phase-tag]');
    const titleEl = q<HTMLElement>('[data-phase-title]');
    const subEl = q<HTMLElement>('[data-phase-sub]');

    // Hand off from the static resting frame to the live one.
    restingScene?.remove();
    thief.style.opacity = '1';

    const A = (a: number) => `rgba(228,17,42,${a})`;

    /* ---- viewport → design units -------------------------------------------
       Everything below is written in the design's own pixel units against a
       fixed virtual height of DESIGN_H. S maps those units onto whatever the
       panel actually measures; at S = 1 the output is the design 1:1. */
    const DESIGN_H = 760; // the design's own panel height
    const RAIL = Math.round(DESIGN_H * 0.2); // top rail, at its design height
    const GROUND = Math.round(DESIGN_H * 0.86); // ground line, ditto
    const FOREGROUND = 18; // dirt kept below the ground line
    // The design leaves ~106 units of empty foreground under its ground line
    // with nothing beneath it. Here the caption card is beneath it, and the two
    // stacked read as a gap — so the visible frame ends just past the ground
    // line. Only empty dirt is cropped; every other height is the design's.
    const VH = GROUND + FOREGROUND;
    let S = 1;
    let VW = 660;

    const fit = () => {
      const r = cv.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      cv.width = Math.max(1, Math.round(r.width * dpr));
      cv.height = Math.max(1, Math.round(r.height * dpr));
      S = Math.max(0.2, (r.height || VH) / VH);
      VW = Math.max(1, (r.width || 660) / S);
      ctx.setTransform(dpr * S, 0, 0, dpr * S, 0, 0);
      thief.style.transform = `scale(${S})`;
    };

    // The stage stops at the caption card's top edge, so the whole scene stays
    // visible above it however the card's copy wraps.
    const measureCard = () => scene.style.setProperty('--ia-card-h', card.offsetHeight + 'px');
    measureCard();
    if ('ResizeObserver' in window) new ResizeObserver(measureCard).observe(card);

    fit();

    // Scene geometry, in design units.
    const VX = 46;
    const HY = 15;
    const H = 186;
    const STRIDE = 46;
    const GRAV = 0.0021;

    let TR = 0;
    let GY = 0;
    let xs = 0;

    const layout = () => {
      TR = RAIL;
      GY = GROUND;
      const ox = (VW % VX) / 2;
      xs = ox + Math.round((VW * 0.44 - ox) / VX) * VX;

      const wpx = cv.getBoundingClientRect().width || VW * S;
      // The stamp and callout keep their design heights (0.33 of the design's
      // panel), which is a point on the fence, not a fraction of the crop.
      const stampY = DESIGN_H * 0.33;
      if (stampEl) {
        // The design switches the stamp between 26px and 19px at a 520px
        // panel; under uniform scale that same 26px rides S down, with a floor
        // so it stays legible on a phone.
        const fs = Math.round(Math.max(15, 26 * S));
        stampEl.style.fontSize = fs + 'px';
        const sw = stampEl.offsetWidth || fs * 9;
        stampEl.style.left = Math.max(12, Math.min((xs + 54) * S, wpx - sw - 12)) + 'px';
        stampEl.style.top = Math.round(stampY * S) + 'px';
      }
      if (callout) {
        const cw = Math.max(190, Math.min(300, wpx * 0.62));
        callout.style.width = cw + 'px';
        callout.style.left = Math.max(12, Math.min((xs - 140) * S, wpx - cw - 12)) + 'px';
        callout.style.top = Math.round((stampY + 76) * S) + 'px';
      }
    };
    layout();

    window.addEventListener('resize', () => {
      fit();
      layout();
      measureCard();
    });

    /* ---- captions, stamp, callout ---------------------------------------- */
    let pi = -1;
    let phaseStart = 0;

    const setCaption = (p: Phase) => {
      [tagEl, titleEl, subEl].forEach((el) => el && (el.style.opacity = '0'));
      window.setTimeout(() => {
        if (tagEl) tagEl.textContent = p.tag;
        if (titleEl) titleEl.textContent = p.title;
        if (subEl) subEl.textContent = p.sub;
        [tagEl, titleEl, subEl].forEach((el) => el && (el.style.opacity = '1'));
      }, 200);
      hud.forEach((el, i) => el?.classList.toggle('is-active', i === p.hud));
    };

    const stampShow = (txt: string) => {
      if (!stampEl) return;
      stampEl.textContent = txt;
      window.setTimeout(() => {
        stampEl.style.opacity = '1';
        stampEl.style.transform = 'scale(1) rotate(-8deg)';
        layout(); // the new word is a different width — re-clamp its position
      }, 380);
    };
    const stampHide = () => {
      if (!stampEl) return;
      stampEl.style.opacity = '0';
      stampEl.style.transform = 'scale(1.6) rotate(-14deg)';
    };
    const calloutShow = (txt: string) => {
      if (!callout) return;
      if (calloutTxt) calloutTxt.textContent = txt;
      callout.style.opacity = '1';
      callout.style.transform = 'translateY(0)';
    };
    const calloutHide = () => {
      if (!callout) return;
      callout.style.opacity = '0';
      callout.style.transform = 'translateY(10px)';
    };

    stampHide();
    calloutHide();

    /* ---- sparks ----------------------------------------------------------- */
    type Spark = { x: number; y: number; life: number; vx: number; vy: number };
    const sparks: Spark[] = [];
    const spark = (x: number, y: number, n: number, spread: number) => {
      for (let i = 0; i < n; i++) {
        sparks.push({
          x,
          y,
          life: 1,
          vx: (Math.random() - 0.5) * spread,
          vy: (Math.random() - 0.5) * spread - 1.2,
        });
      }
    };
    const drawSparks = () => {
      for (let i = sparks.length - 1; i >= 0; i--) {
        const s = sparks[i]!;
        s.x += s.vx;
        s.y += s.vy;
        s.vy += 0.12;
        s.life -= 0.04;
        if (s.life <= 0) {
          sparks.splice(i, 1);
          continue;
        }
        ctx.fillStyle = `rgba(255,${150 + s.life * 90},110,${s.life})`;
        ctx.beginPath();
        ctx.arc(s.x, s.y, 0.6 + s.life * 2.4, 0, 6.29);
        ctx.fill();
      }
    };

    /* ---- the fence -------------------------------------------------------- */
    type SceneOpt = { glow: number; glowY: number | null; spikeGlow: number };

    const drawScene = (w: number, h: number, t: number, opt: SceneOpt) => {
      const ox = (w % VX) / 2;
      for (let x = ox; x <= w; x += VX) {
        const d = Math.abs(x - xs);
        const hot = opt.glow && d < 90 ? (1 - d / 90) * opt.glow : 0;
        ctx.strokeStyle = hot > 0 ? A(0.22 + hot * 0.5) : 'rgba(175,178,188,0.26)';
        ctx.lineWidth = 2.2;
        ctx.beginPath();
        ctx.moveTo(x, TR);
        ctx.lineTo(x, GY);
        ctx.stroke();
      }
      for (let y = TR + HY; y < GY; y += HY) {
        const d = opt.glowY != null ? Math.abs(y - opt.glowY) : 999;
        const hot = opt.glow && d < 50 ? (1 - d / 50) * opt.glow : 0;
        ctx.strokeStyle = hot > 0 ? A(0.22 + hot * 0.5) : 'rgba(150,153,163,0.18)';
        ctx.lineWidth = 1.4;
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(w, y);
        ctx.stroke();
      }
      ctx.fillStyle = '#20212a';
      let lp = ox + 2 * VX;
      for (let px = ox + 2 * VX; px < w; px += 6 * VX) {
        ctx.fillRect(px - 5, TR - 14, 10, GY - TR + 14);
        if (px < w * 0.92) lp = px;
      }
      ctx.fillStyle = '#282933';
      ctx.fillRect(0, TR - 9, w, 7);
      for (let sx = 0; sx < w; sx += 16) {
        const d = Math.abs(sx + 8 - xs);
        const hot = opt.spikeGlow && d < 130 ? (1 - d / 130) * opt.spikeGlow : 0;
        ctx.fillStyle = hot > 0 ? A(0.45 + hot * 0.5) : '#2e2f3a';
        ctx.beginPath();
        ctx.moveTo(sx, TR - 9);
        ctx.lineTo(sx + 8, TR - 30);
        ctx.lineTo(sx + 16, TR - 9);
        ctx.closePath();
        ctx.fill();
      }
      // Solar security light on a post (product tie-in).
      const pulse = Math.sin(t / 900) * 0.5 + 0.5;
      const lg = ctx.createRadialGradient(lp, TR - 22, 0, lp, TR - 22, 70 + pulse * 24);
      lg.addColorStop(0, `rgba(255,222,184,${0.16 + pulse * 0.1})`);
      lg.addColorStop(1, 'rgba(255,222,184,0)');
      ctx.fillStyle = lg;
      ctx.fillRect(lp - 100, TR - 122, 200, 200);
      ctx.fillStyle = `rgba(255,232,205,${0.7 + pulse * 0.3})`;
      ctx.beginPath();
      ctx.arc(lp, TR - 22, 4, 0, 6.29);
      ctx.fill();
      // Ground.
      ctx.strokeStyle = 'rgba(160,163,175,0.30)';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(0, GY);
      ctx.lineTo(w, GY);
      ctx.stroke();
      // The falloff keeps the design's full length even though the frame crops
      // it, so the dirt reads at the design's density rather than fading out
      // over the shorter strip.
      const gg = ctx.createLinearGradient(0, GY, 0, DESIGN_H);
      gg.addColorStop(0, 'rgba(18,18,24,0.6)');
      gg.addColorStop(1, 'rgba(10,10,13,0)');
      ctx.fillStyle = gg;
      ctx.fillRect(0, GY, w, h - GY);
    };

    /* ---- easing / helpers ------------------------------------------------- */
    const easeOut = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : 1 - Math.pow(1 - x, 3));
    const easeInOut = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x * x * (3 - 2 * x));
    const easeIn = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x * x);
    const lerp = (a: number, b: number, k: number) => a + (b - a) * k;
    const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);

    /* ---- rig state & props ------------------------------------------------ */
    const worker = { x: 0, y: 0, face: 1, gait: 0, lean: 0 };
    // The flung drill, as a rigid body: gravity, ground bounce, roll to rest.
    const tool = { x: 0, y: 0, rot: -10, vx: 0, vy: 0, vr: 0, mode: 'hand' };
    const rope = {
      coil: 0,
      caught: false,
      hookX: 0,
      hookY: 0,
      hookRot: 0,
      handX: 0,
      handY: 0,
      sag: 30,
    };

    const drawHook = (hx: number, hy: number, rot: number) => {
      ctx.save();
      ctx.translate(hx, hy);
      ctx.rotate(rot);
      ctx.strokeStyle = '#b3b9c6';
      ctx.lineWidth = 3.2;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(0, 15);
      ctx.lineTo(0, -14);
      ctx.stroke();
      [-1, 1].forEach((s) => {
        ctx.beginPath();
        ctx.moveTo(0, -6);
        ctx.quadraticCurveTo(s * 14, -11, s * 12, 5);
        ctx.stroke();
      });
      ctx.beginPath();
      ctx.arc(0, 17, 3.4, 0, 6.29);
      ctx.stroke();
      ctx.restore();
    };
    const drawRope = (x1: number, y1: number, x2: number, y2: number, sag: number) => {
      ctx.strokeStyle = 'rgba(198,178,132,0.9)';
      ctx.lineWidth = 2.6;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(x1, y1);
      ctx.quadraticCurveTo((x1 + x2) / 2, (y1 + y2) / 2 + sag, x2, y2);
      ctx.stroke();
    };
    const drawTossedDrill = (x: number, y: number, rotDeg: number) => {
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate((rotDeg * Math.PI) / 180);
      ctx.lineCap = 'round';
      ctx.strokeStyle = '#454a58';
      ctx.lineWidth = 13;
      ctx.beginPath();
      ctx.moveTo(16, 0);
      ctx.lineTo(-8, 0);
      ctx.stroke();
      ctx.strokeStyle = '#F2B824';
      ctx.lineWidth = 4;
      ctx.beginPath();
      ctx.moveTo(12, -4);
      ctx.lineTo(-2, -4);
      ctx.stroke();
      ctx.strokeStyle = '#31353f';
      ctx.lineWidth = 10;
      ctx.beginPath();
      ctx.moveTo(11, 4);
      ctx.lineTo(15, 18);
      ctx.stroke();
      ctx.strokeStyle = '#8b909c';
      ctx.lineWidth = 7;
      ctx.beginPath();
      ctx.moveTo(-8, 0);
      ctx.lineTo(-14, 0);
      ctx.stroke();
      ctx.strokeStyle = '#b9bec9';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(-14, 0);
      ctx.lineTo(-30, 0);
      ctx.stroke();
      ctx.restore();
    };

    // Canvas climber: the hands really grip the rope, the feet clamp it, the
    // body hangs between them.
    type Climber = {
      ropeX: number;
      sx: number;
      sy: number;
      feetY: number;
      tuck: number;
      hipSwing?: number;
      alpha?: number;
      hands: [number, number][];
    };
    const paintClimber = (st: Climber) => {
      const { sx, sy, hands, feetY, tuck } = st;
      const hipX = sx + 6 + (st.hipSwing || 0);
      const hipY = sy + 44;
      ctx.save();
      ctx.globalAlpha = st.alpha ?? 1;
      ctx.lineCap = 'round';
      (
        [
          [-5, -3, '#23252e', '#191b22'],
          [5, 3, '#2b2d38', '#20222b'],
        ] as [number, number, string, string][]
      ).forEach(([dx, dy, col, boot]) => {
        const fx2 = st.ropeX + dx * 0.4;
        const fy2 = feetY + dy;
        const kx = hipX + 20 + tuck * 17 + dx;
        const ky = (hipY + fy2) / 2 - tuck * 12;
        ctx.strokeStyle = col;
        ctx.lineWidth = 13;
        ctx.beginPath();
        ctx.moveTo(hipX, hipY);
        ctx.quadraticCurveTo(kx, ky, fx2, fy2);
        ctx.stroke();
        ctx.fillStyle = boot;
        ctx.beginPath();
        ctx.ellipse(fx2 + 2, fy2 + 3, 9, 5, 0.3, 0, 6.29);
        ctx.fill();
      });
      ctx.strokeStyle = '#31333e';
      ctx.lineWidth = 21;
      ctx.beginPath();
      ctx.moveTo(sx, sy);
      ctx.lineTo(hipX, hipY);
      ctx.stroke();
      ctx.fillStyle = '#2b2d38';
      ctx.beginPath();
      ctx.arc(sx + 3, sy - 17, 12.5, 0, 6.29);
      ctx.fill();
      ctx.fillStyle = '#191b23';
      ctx.beginPath();
      ctx.arc(sx + 3, sy - 19, 12.5, Math.PI, 0);
      ctx.closePath();
      ctx.fill();
      hands.forEach(([hx2, hy2], idx) => {
        const shX = sx + (idx ? 5 : -5);
        const shY = sy + 2;
        const ex = (shX + hx2) / 2 + (idx ? 7 : -7);
        const ey = (shY + hy2) / 2 + 5;
        ctx.strokeStyle = idx ? '#2f313d' : '#23252e';
        ctx.lineWidth = 11;
        ctx.beginPath();
        ctx.moveTo(shX, shY);
        ctx.quadraticCurveTo(ex, ey, hx2, hy2);
        ctx.stroke();
        ctx.fillStyle = '#4a4e5c';
        ctx.beginPath();
        ctx.arc(hx2, hy2, 6, 0, 6.29);
        ctx.fill();
      });
      ctx.restore();
    };

    // local → world, respecting facing
    const wx = (lx: number) => worker.x + (worker.face < 0 ? 150 - lx : lx);
    const wy = (ly: number) => worker.y + ly;

    const setPoseMix = (kneelK: number) => {
      if (poseWalk) poseWalk.style.opacity = String(1 - kneelK);
      if (poseKneel) poseKneel.style.opacity = String(kneelK);
    };
    // Gait driven by distance travelled, so the feet never slide.
    const stepGait = (dx: number) => {
      worker.gait += (Math.abs(dx) / STRIDE) * Math.PI;
      const s = Math.sin(worker.gait);
      if (legA) legA.style.transform = `rotate(${s * 17}deg)`;
      if (legB) legB.style.transform = `rotate(${-s * 17}deg)`;
      if (armF) armF.style.transform = `rotate(${-s * 13}deg)`;
      if (armB) armB.style.transform = `rotate(${s * 13}deg)`;
      return Math.abs(Math.cos(worker.gait)) * -2.2; // vertical bob at mid-stride
    };
    const placeWorker = (bob: number) => {
      thief.style.left = worker.x * S + 'px';
      thief.style.top = (worker.y + (bob || 0)) * S + 'px';
      // Mirrored space negates rotation, so the lean flips to keep him leaning
      // into the pull.
      const f = worker.face < 0 ? -1 : 1;
      thiefIn.style.transform = `scaleX(${worker.face}) rotate(${f * worker.lean}deg)`;
    };
    const setKneelDroop = (k: number) => {
      // 0 = working posture, 1 = defeated
      if (kBody) kBody.style.transform = `rotate(${k * 7}deg)`;
      if (kHead) kHead.style.transform = `translate(${k * -3}px, ${k * 6}px)`;
      if (kArmA) kArmA.style.transform = `rotate(${k * 26}deg)`;
      if (kArmB) kArmB.style.transform = `rotate(${k * 30}deg)`;
    };

    const setScene = (p: Phase, idx: number) => {
      stampHide();
      calloutHide();
      thief.style.opacity = '1';
      if (idx === 0) {
        tool.mode = 'hand';
        tool.rot = 0;
      }
      if (p.stamp) stampShow(p.stamp);
      if (p.callout) calloutShow(p.callout);
    };

    /* ---- the loop --------------------------------------------------------- */
    let clock = 0;
    let last = 0;
    let rafId = 0;
    let running = false;

    const loop = (now: number) => {
      if (!running) return;
      const dt = last ? Math.min(64, now - last) : 16;
      last = now;
      clock += dt;
      const t = clock;

      if (pi < 0 || t - phaseStart > PHASES[pi]!.dur) {
        pi = (pi + 1) % PHASES.length;
        phaseStart = t;
        setCaption(PHASES[pi]!);
        setScene(PHASES[pi]!, pi);
      }
      const p = PHASES[pi]!;
      const local = t - phaseStart;
      const prog = Math.min(1, local / p.dur);
      if (barEl) barEl.style.width = (prog * 100).toFixed(1) + '%';

      const w = VW;
      const h = VH;
      ctx.clearRect(0, 0, w, h);
      let shakeX = 0;
      let shakeY = 0;

      const groundTop = GY - H;
      const standX = xs - 30; // kneeling puts his hands on the wire
      const anchorX = xs;
      const anchorY = TR - 4;
      const throwX = xs + 46;
      const prevX = worker.x;
      worker.y = groundTop;
      let kneelK = 0;
      let bob = 0;
      let droop = 0;
      let climber: Climber | null = null;
      let drillOn = 0;
      let glow = 0.2;
      let glowY: number | null = null;
      let spikeGlow = 0;

      if (p.mode === 'enter') {
        // Walks in from the right, drill in hand.
        const k = easeInOut(clamp01(local / 4200));
        worker.face = 1;
        worker.x = lerp(w + 80, standX, k);
        worker.lean = 0;
        bob = stepGait(worker.x - prevX);
      } else if (p.mode === 'kneel') {
        worker.x = standX;
        worker.face = 1;
        worker.lean = 0;
        kneelK = easeInOut(clamp01(local / 1500));
        glow = 0.25;
      } else if (p.mode === 'drill') {
        worker.x = standX;
        worker.face = 1;
        kneelK = 1;
        // Three deliberate attempts with pauses between.
        const bursts: [number, number][] = [
          [600, 2000],
          [2500, 3900],
          [4300, 5700],
        ];
        const active = bursts.find(([a, b]) => local >= a && local <= b);
        const ramp = active
          ? Math.min(1, (local - active[0]) / 260) * Math.min(1, (active[1] - local) / 260)
          : 0;
        drillOn = ramp;
        const kick = ramp * (0.6 + 0.4 * Math.sin(t / 42));
        worker.lean = -kick * 1.6; // braces back against the tool
        if (kArmA) kArmA.style.transform = `rotate(${kick * -3}deg)`;
        if (kArmB) kArmB.style.transform = `rotate(${kick * -2}deg)`;
        if (kBody) kBody.style.transform = `translateX(${kick * 3}px)`;
        glow = 0.4 + ramp * 0.6;
        glowY = wy(122);
        shakeX = Math.sin(t / 27) * ramp * 1.8;
        shakeY = Math.cos(t / 34) * ramp * 1.1;
      } else if (p.mode === 'fail') {
        worker.x = standX;
        worker.face = 1;
        worker.lean = 0;
        kneelK = 1;
        droop = easeOut(clamp01((local - 300) / 1200));
        setKneelDroop(droop);
        glow = 0.22 + Math.sin(t / 260) * 0.1;
        glowY = wy(122);
      } else if (p.mode === 'hatoff') {
        worker.x = standX;
        worker.face = 1;
        worker.lean = 0;
        kneelK = 1;
        setKneelDroop(1);
        if (tool.mode !== 'free' && tool.mode !== 'rest') {
          // Winds the drill back over his shoulder and hurls it behind him.
          const windup = easeInOut(clamp01(local / 480));
          if (kArmA) kArmA.style.transform = `rotate(${windup * -40}deg)`;
          if (kArmB) kArmB.style.transform = `rotate(${windup * -26}deg)`;
          tool.x = wx(33) + windup * 18;
          tool.y = wy(118) - windup * 42;
          tool.rot = windup * 52;
          if (local > 480) {
            tool.mode = 'free';
            tool.vx = 0.24;
            tool.vy = -0.34;
            tool.vr = 0.42;
          }
        } else {
          const ret = easeInOut(clamp01((local - 480) / 900));
          if (kArmA) kArmA.style.transform = `rotate(${lerp(-40, 26, ret)}deg)`;
          if (kArmB) kArmB.style.transform = `rotate(${lerp(-26, 30, ret)}deg)`;
        }
        droop = easeOut(clamp01((local - 900) / 1100));
        setKneelDroop(droop);
        glow = 0.2;
        glowY = wy(122);
      } else if (p.mode === 'exit') {
        // Stands up, then walks off to the left.
        const up = easeInOut(clamp01(local / 1300));
        kneelK = 1 - up;
        setKneelDroop(1 - up);
        const walkK = easeIn(clamp01((local - 1300) / 3100));
        worker.face = 1;
        worker.x = lerp(standX, -220, walkK);
        worker.lean = 0;
        bob = stepGait(worker.x - prevX);
        glow = 0.2;
      } else if (p.mode === 'rope') {
        // Walks back in from the left with a coil and a grapple.
        kneelK = 0;
        setKneelDroop(0);
        worker.face = -1;
        const k = easeOut(clamp01((local - 600) / 3900));
        worker.x = lerp(-230, throwX, k);
        worker.lean = 0;
        bob = stepGait(worker.x - prevX);
        rope.coil = 1;
        rope.caught = false;
        rope.handX = wx(56);
        rope.handY = wy(112) + bob;
        rope.hookX = rope.handX;
        rope.hookY = rope.handY + 10;
        rope.hookRot = -0.4;
        glow = 0.24;
      } else if (p.mode === 'throw') {
        // Turns to the fence, swings, releases the hook.
        const turn = easeInOut(clamp01(local / 500));
        worker.face = lerp(-1, 1, turn);
        worker.x = throwX;
        worker.lean = 0;
        const swing = clamp01((local - 500) / 700);
        const fly = clamp01((local - 1200) / 700);
        const catchT = clamp01((local - 1900) / 500);
        rope.coil = fly > 0 ? 0 : 1;
        rope.caught = false;
        if (armF) {
          armF.style.transform = `rotate(${
            swing < 1 ? -Math.sin(swing * Math.PI) * 70 : lerp(-70, 26, easeOut(fly))
          }deg)`;
        }
        const hx0 = wx(56);
        const hy0 = wy(112);
        if (fly <= 0) {
          rope.hookX = hx0 - swing * 8;
          rope.hookY = hy0 - swing * 30;
          rope.hookRot = -0.5 - swing * 1.4;
          rope.sag = 6;
        } else if (fly < 1) {
          rope.hookX = lerp(hx0, anchorX, fly);
          rope.hookY = lerp(hy0 - 30, anchorY, fly) - Math.sin(fly * Math.PI) * 110; // ballistic arc
          rope.hookRot = -1.9 + fly * 2.2;
          rope.sag = 20 + fly * 14;
        } else {
          // The grapple bites with a little elastic wobble; the slack whips
          // once, then settles.
          rope.hookX = anchorX;
          rope.hookY = anchorY;
          rope.hookRot = 0.16 + Math.exp(-3 * catchT) * Math.cos(catchT * 10) * 0.8;
          rope.sag = 12 + Math.exp(-2.6 * catchT) * Math.cos(catchT * 7) * 22;
          if (catchT < 0.3 && Math.random() > 0.55) spark(anchorX, anchorY - 4, 3, 5);
        }
        rope.handX = hx0;
        rope.handY = hy0;
        glow = 0.26;
        spikeGlow = fly >= 1 ? 0.4 + catchT * 0.2 : 0;
      } else if (p.mode === 'climb') {
        // Real technique: grip high, knees up, feet clamp, press and pull.
        worker.face = 1;
        rope.caught = true;
        rope.hookX = anchorX;
        rope.hookY = anchorY;
        rope.hookRot = 2.6;
        const grab = easeInOut(clamp01(local / 800));
        const k = clamp01((local - 800) / 5400);
        worker.x = lerp(throwX, anchorX - 72, grab);
        const startSh = groundTop + 62;
        const endSh = TR + 44;
        const PULLS = 6;
        const h2 = (startSh - endSh) / PULLS;
        const seg = k * PULLS;
        const i = Math.min(PULLS - 1, Math.floor(seg));
        const f = seg - i;
        const tuckE = f < 0.42 ? easeInOut(f / 0.42) : 1;
        const driveE = f < 0.42 ? 0 : easeInOut(Math.min(1, (f - 0.42) / 0.4));
        const Si = startSh - i * h2;
        const sink = f < 0.42 ? tuckE * 4 : (1 - driveE) * 4;
        const sy = k <= 0 ? startSh : Si - h2 * driveE + sink;
        worker.y = sy - 62;
        // He reaches for the line and the rig crossfades onto it — no pop.
        const alphaIn = k > 0 ? 1 : clamp01((grab - 0.68) / 0.32);
        thief.style.opacity = String(1 - alphaIn);
        if (k <= 0) {
          rope.caught = false;
          rope.coil = 0;
          rope.hookX = anchorX;
          rope.hookY = anchorY;
          rope.hookRot = 0.16;
          rope.handX = lerp(wx(56), anchorX, grab);
          rope.handY = lerp(wy(112), startSh - 46, grab);
          rope.sag = lerp(12, 2, grab);
          if (alphaIn > 0) {
            climber = {
              ropeX: anchorX,
              sx: anchorX + 8,
              sy: startSh,
              feetY: startSh + 104,
              tuck: 0,
              hipSwing: 0,
              alpha: alphaIn,
              hands: [
                [anchorX, startSh - 20],
                [anchorX, startSh - 46],
              ],
            };
          }
        }
        if (k > 0) {
          // The feet clamp the rope in world space and stay put while the body
          // rises past them.
          const feetY = f < 0.42 ? lerp(Si + 104, Si + 52, tuckE) : Si + 52;
          // Hand over hand: the low hand crosses over high (big reach), then
          // the other shifts up.
          const m1 = f < 0.62 ? 0 : f < 0.8 ? easeInOut((f - 0.62) / 0.18) : 1;
          const m2 = f < 0.8 ? 0 : easeInOut((f - 0.8) / 0.2);
          const lowY = lerp(Si - 20, Si - h2 - 46, m1);
          const highY = lerp(Si - 46, Si - h2 - 20, m2);
          const lowX = anchorX + Math.sin(m1 * Math.PI) * 8;
          const highX = anchorX + Math.sin(m2 * Math.PI) * 7;
          const even = i % 2 === 0;
          climber = {
            ropeX: anchorX,
            sx: anchorX + 8,
            sy,
            feetY,
            tuck: tuckE * (f < 0.42 ? 1 : 1 - driveE),
            hipSwing: Math.sin(seg * Math.PI) * 2.2,
            hands: even
              ? [
                  [lowX, lowY],
                  [highX, highY],
                ]
              : [
                  [highX, highY],
                  [lowX, lowY],
                ],
          };
          if (driveE > 0.2 && driveE < 0.9 && Math.random() > 0.85) {
            spark(anchorX + (Math.random() - 0.5) * 14, feetY + 4, 2, 3);
          }
        }
        glow = 0.3 + k * 0.25;
        spikeGlow = k > 0.6 ? (k - 0.6) * 2.4 : 0;
      } else {
        // spiked — reaches over the top, the spikes bite, he slides back down.
        worker.face = 1;
        rope.caught = true;
        rope.hookX = anchorX;
        rope.hookY = anchorY;
        rope.hookRot = 2.6;
        const topSh = TR + 44;
        if (local < 1600) {
          const cyc = Math.sin(clamp01(local / 1600) * Math.PI * 2.2);
          const bite = Math.max(0, cyc);
          const sy = topSh + bite * 3;
          worker.x = anchorX - 72;
          worker.y = sy - 62;
          thief.style.opacity = '0';
          // One hand keeps the rope, the free hand goes for the top — and
          // meets the spikes.
          const reachX = anchorX + 20 * bite;
          const reachY = lerp(topSh - 20, TR - 26, bite);
          climber = {
            ropeX: anchorX,
            sx: anchorX + 8 + bite * 3,
            sy,
            feetY: topSh + 52,
            tuck: 0.35,
            hipSwing: cyc * 2,
            hands: [
              [anchorX, topSh - 46],
              [reachX, reachY],
            ],
          };
          if (bite > 0.72 && Math.random() > 0.4) spark(reachX, TR - 18, 5, 7);
          shakeX = Math.sin(t / 22) * 2 * bite;
          shakeY = Math.cos(t / 27) * 1.2 * bite;
          glow = 0.45 + bite * 0.3;
          glowY = TR + 14;
          spikeGlow = 0.7 + bite * 0.3;
        } else if (local < 3100) {
          const k = clamp01((local - 1600) / 1500);
          const slide = easeIn(k); // lets the rope run, friction-braked
          const sy = lerp(topSh, groundTop + 62, slide);
          worker.x = anchorX - 72;
          worker.y = sy - 62;
          thief.style.opacity = '0';
          climber = {
            ropeX: anchorX,
            sx: anchorX + 8,
            sy,
            feetY: sy + 96 + slide * 8,
            tuck: 0.1,
            hipSwing: Math.sin(t / 140) * 1.4,
            hands: [
              [anchorX, sy - 40],
              [anchorX + 2, sy - 22],
            ],
          };
          if (k > 0.08 && k < 0.98 && Math.random() > 0.6) {
            sparks.push({
              x: anchorX + (Math.random() - 0.5) * 8,
              y: sy - 30,
              life: 0.4,
              vx: (Math.random() - 0.5) * 0.5,
              vy: -Math.random() * 0.3,
            });
          }
          glow = 0.28;
          glowY = TR + 14;
          spikeGlow = Math.max(0, 1 - k * 1.8);
        } else {
          // On the ground, beaten — back to the flesh-and-blood rig, slumped.
          kneelK = 1;
          setKneelDroop(1);
          worker.x = anchorX - 72;
          worker.y = groundTop;
          thief.style.opacity = '1';
          glow = 0.26;
          glowY = TR + 14;
          spikeGlow = 0;
        }
        rope.handX = wx(72);
        rope.handY = wy(14);
      }

      // Flung-drill rigid body: gravity, ground collision, bounce, roll to rest.
      if (tool.mode === 'free') {
        tool.vy += GRAV * dt;
        tool.x += tool.vx * dt;
        tool.y += tool.vy * dt;
        tool.rot += tool.vr * dt;
        const restY = GY - 8;
        if (tool.y >= restY) {
          tool.y = restY;
          tool.vy = -tool.vy * 0.36;
          tool.vx *= 0.62;
          tool.vr *= 0.4;
          if (Math.abs(tool.vy) < 0.05) {
            tool.vy = 0;
            tool.vx = 0;
            tool.vr = 0;
            tool.mode = 'rest';
            tool.y = restY;
          }
        }
      } else if (tool.mode === 'rest') {
        tool.rot = lerp(tool.rot, -13, 0.1);
        tool.y = GY - 8;
      }

      setPoseMix(kneelK);
      if (p.mode === 'enter' || p.mode === 'kneel') setKneelDroop(0);
      placeWorker(bob);
      drawScene(w, h, t, { glow, glowY, spikeGlow });

      // Rope and grapple hook.
      if (p.mode === 'rope' || p.mode === 'throw' || p.mode === 'climb' || p.mode === 'spiked') {
        if (rope.caught) {
          const sway = Math.sin(t / 760) * 2.2;
          drawRope(anchorX, anchorY, anchorX + sway, GY, sway * 3);
        } else if (rope.coil > 0) {
          ctx.strokeStyle = 'rgba(198,178,132,0.9)';
          ctx.lineWidth = 2.3;
          [13, 9.5, 6].forEach((r) => {
            ctx.beginPath();
            ctx.ellipse(rope.handX, rope.handY + 12, r, r * 0.66, 0, 0, 6.29);
            ctx.stroke();
          });
        } else {
          drawRope(rope.handX, rope.handY, rope.hookX, rope.hookY, rope.sag);
        }
        drawHook(rope.hookX, rope.hookY, rope.hookRot);
      }
      if (climber) paintClimber(climber);

      // The flung drill: windup in hand, then ballistic, then in the dirt.
      if (
        (p.mode === 'hatoff' && tool.mode === 'hand') ||
        tool.mode === 'free' ||
        tool.mode === 'rest'
      ) {
        drawTossedDrill(tool.x, tool.y, tool.rot);
      }

      // The drill in his hands, bit on the weld.
      if (kneelK > 0.5 && (p.mode === 'kneel' || p.mode === 'drill' || p.mode === 'fail')) {
        const hxw = wx(33);
        const hyw = wy(122) + (drillOn ? Math.sin(t / 30) * 1.2 : 0);
        const axis = hyw - 2;
        ctx.lineCap = 'round';
        ctx.strokeStyle = '#31353f';
        ctx.lineWidth = 13;
        ctx.beginPath();
        ctx.moveTo(hxw + 20, axis + 22);
        ctx.lineTo(hxw + 13, axis + 2);
        ctx.stroke();
        ctx.strokeStyle = '#454a58';
        ctx.lineWidth = 17;
        ctx.beginPath();
        ctx.moveTo(hxw + 22, axis);
        ctx.lineTo(hxw - 10, axis);
        ctx.stroke();
        ctx.strokeStyle = '#F2B824';
        ctx.lineWidth = 5;
        ctx.beginPath();
        ctx.moveTo(hxw + 16, axis - 5);
        ctx.lineTo(hxw - 4, axis - 5);
        ctx.stroke();
        ctx.strokeStyle = '#8b909c';
        ctx.lineWidth = 9;
        ctx.beginPath();
        ctx.moveTo(hxw - 10, axis);
        ctx.lineTo(hxw - 18, axis);
        ctx.stroke();
        ctx.strokeStyle = drillOn ? '#d7dbe4' : '#9aa0ac';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(hxw - 18, axis);
        ctx.lineTo(xs, axis);
        ctx.stroke();
        if (drillOn > 0.2) {
          ctx.strokeStyle = A(0.35 + drillOn * 0.5);
          ctx.lineWidth = 2.2;
          ctx.beginPath();
          ctx.arc(xs, axis, 7 + drillOn * 7, 0, 6.29);
          ctx.stroke();
          if (Math.random() > 0.42) spark(xs, axis, 4, 7);
        }
      }

      if (shakeEl) shakeEl.style.transform = `translate(${shakeX * S}px,${shakeY * S}px)`;
      drawSparks();
      rafId = requestAnimationFrame(loop);
    };

    // Only run while the section is on screen. `last` is cleared on stop so a
    // resumed loop doesn't swallow the off-screen time as one giant frame.
    const start = () => {
      if (running) return;
      running = true;
      last = 0;
      rafId = requestAnimationFrame(loop);
    };
    const stop = () => {
      running = false;
      last = 0;
      cancelAnimationFrame(rafId);
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? start() : stop()));
      },
      { rootMargin: '0px 0px -12% 0px' },
    );
    io.observe(section);
  }
</script>
