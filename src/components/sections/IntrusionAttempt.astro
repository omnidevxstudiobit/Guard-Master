                  stroke="#8b909c"
                  stroke-width="5"
                  stroke-linecap="round"></line>
                <path
                  d="M10 112 Q4 114 8 120"
                  stroke="#8b909c"
                  stroke-width="5"
                  stroke-linecap="round"
                  fill="none"></path>
                <line
                  x1="94"
                  y1="118"
                  x2="120"
                  y2="140"
                  stroke="#2b2d38"
                  stroke-width="14"
                  stroke-linecap="round"></line>
                <line
                  x1="120"
                  y1="140"
                  x2="114"
                  y2="176"
                  stroke="#2b2d38"
                  stroke-width="13"
                  stroke-linecap="round"></line>
                <line
                  x1="90"
                  y1="120"
                  x2="66"
                  y2="150"
                  stroke="#2b2d38"
                  stroke-width="14"
                  stroke-linecap="round"></line>
                <line
                  x1="66"
                  y1="150"
                  x2="72"
                  y2="180"
                  stroke="#2b2d38"
                  stroke-width="13"
                  stroke-linecap="round"></line>
                <line
                  x1="106"
                  y1="178"
                  x2="122"
                  y2="178"
                  stroke="#242631"
                  stroke-width="9"
                  stroke-linecap="round"></line>
                <line
                  x1="66"
                  y1="182"
                  x2="82"
                  y2="182"
                  stroke="#242631"
                  stroke-width="9"
                  stroke-linecap="round"></line>
              </g>
              <g data-pose="climb" style="opacity:0">
                <circle cx="75" cy="26" r="13" fill="#2b2d38"></circle>
                <line
                  x1="75"
                  y1="42"
                  x2="75"
                  y2="96"
                  stroke="#2b2d38"
                  stroke-width="22"
                  stroke-linecap="round"></line>
                <line
                  x1="70"
                  y1="50"
                  x2="38"
                  y2="16"
                  stroke="#2b2d38"
                  stroke-width="12"
                  stroke-linecap="round"></line>
                <line
                  x1="80"
                  y1="50"
                  x2="112"
                  y2="16"
                  stroke="#2b2d38"
                  stroke-width="12"
                  stroke-linecap="round"></line>
                <circle cx="36" cy="14" r="6" fill="#2b2d38"></circle>
                <circle cx="114" cy="14" r="6" fill="#2b2d38"></circle>
                <line
                  x1="70"
                  y1="96"
                  x2="44"
                  y2="132"
                  stroke="#2b2d38"
                  stroke-width="14"
                  stroke-linecap="round"></line>
                <line
                  x1="44"
                  y1="132"
                  x2="50"
                  y2="164"
                  stroke="#2b2d38"
                  stroke-width="12"
                  stroke-linecap="round"></line>
                <line
                  x1="80"
                  y1="96"
                  x2="106"
                  y2="132"
                  stroke="#2b2d38"
                  stroke-width="14"
                  stroke-linecap="round"></line>
                <line
                  x1="106"
                  y1="132"
                  x2="100"
                  y2="164"
                  stroke="#2b2d38"
                  stroke-width="12"
                  stroke-linecap="round"></line>
              </g>
              <g data-pose="recoil" style="opacity:0">
                <circle cx="60" cy="48" r="13" fill="#2b2d38"></circle>
                <line
                  x1="66"
                  y1="62"
                  x2="84"
                  y2="112"
                  stroke="#2b2d38"
                  stroke-width="22"
                  stroke-linecap="round"></line>
                <line
                  x1="66"
                  y1="66"
                  x2="30"
                  y2="42"
                  stroke="#2b2d38"
                  stroke-width="12"
                  stroke-linecap="round"></line>
                <line
                  x1="76"
                  y1="68"
                  x2="52"
                  y2="20"
                  stroke="#2b2d38"
                  stroke-width="12"
                  stroke-linecap="round"></line>
                <line
                  x1="86"
                  y1="112"
                  x2="114"
                  y2="136"
                  stroke="#2b2d38"
                  stroke-width="14"
                  stroke-linecap="round"></line>
                <line
                  x1="114"
                  y1="136"
                  x2="124"
                  y2="168"
                  stroke="#2b2d38"
                  stroke-width="13"
                  stroke-linecap="round"></line>
                <line
                  x1="82"
                  y1="116"
                  x2="92"
                  y2="152"
                  stroke="#2b2d38"
                  stroke-width="14"
                  stroke-linecap="round"></line>
                <line
                  x1="92"
                  y1="152"
                  x2="88"
                  y2="180"
                  stroke="#2b2d38"
                  stroke-width="13"
                  stroke-linecap="round"></line>
              </g>
            </g>

            {
              /* Static resting illustration — visible only until the script
              arms the section (no-JS / reduced-motion: stays forever). The
              story's ending, not its start: blocked at the top. */
            }
            <g data-resting-thief transform="translate(72,20) scale(0.42) rotate(14)">
              <circle cx="60" cy="48" r="13" fill="#2b2d38"></circle>
              <line
                x1="66"
                y1="62"
                x2="84"
                y2="112"
                stroke="#2b2d38"
                stroke-width="22"
                stroke-linecap="round"></line>
              <line
                x1="66"
                y1="66"
                x2="30"
                y2="42"
                stroke="#2b2d38"
                stroke-width="12"
                stroke-linecap="round"></line>
              <line
                x1="76"
                y1="68"
                x2="52"
                y2="20"
                stroke="#2b2d38"
                stroke-width="12"
                stroke-linecap="round"></line>
              <line
                x1="86"
                y1="112"
                x2="114"
                y2="136"
                stroke="#2b2d38"
                stroke-width="14"
                stroke-linecap="round"></line>
              <line
                x1="114"
                y1="136"
                x2="124"
                y2="168"
                stroke="#2b2d38"
                stroke-width="13"
                stroke-linecap="round"></line>
              <line
                x1="82"
                y1="116"
                x2="92"
                y2="152"
                stroke="#2b2d38"
                stroke-width="14"
                stroke-linecap="round"></line>
              <line
                x1="92"
                y1="152"
                x2="88"
                y2="180"
                stroke="#2b2d38"
                stroke-width="13"
                stroke-linecap="round"></line>
            </g>
          </svg>

          <svg class="mesh-hot-ia" viewBox="0 0 400 300" aria-hidden="true">
            {
              /* A red duplicate of the grid lines and spikes, revealed only
                inside a soft circular mask that follows the glow — the fence
                lights up right where the intruder is actually touching it,
                instead of a red blob floating over an unreactive grey grid.
                --glow-x/-y/-r are written every frame by the script below,
                the same loop that positions the thief and the glow circle.
                Same masked-reveal technique as Proof358's scan band. */
            }
            <g stroke="#ff4257" stroke-width="1.2" opacity="0.9">
              {
                Array.from({ length: 21 }, (_, i) => i * 20).map((x) => (
                  <line x1={x} y1="40" x2={x} y2="230" />
                ))
              }
            </g>
            <g stroke="#ff4257" stroke-width="0.8" opacity="0.7">
              {
                Array.from({ length: 13 }, (_, i) => 40 + i * 15).map((y) => (
                  <line x1="0" y1={y} x2="400" y2={y} />
                ))
              }
            </g>
            <g fill="#ff4257">
              {
                Array.from({ length: 34 }, (_, i) => i * 12).map((x) => (
                  <path d={`M${x},34 L${x + 6},14 L${x + 12},34 Z`} />
                ))
              }
            </g>
          </svg>
        </div>

        <div class="ia-crt" aria-hidden="true"></div>
        <div class="ia-scanline" aria-hidden="true"></div>

        <!-- HUD -->
        <div data-hud class="absolute top-4 right-4 z-[3] flex gap-2">
          <span
            data-hud-tab="0"
            class:list={[
              'rounded-sm border px-1.5 py-1 font-mono text-[8px] tracking-[0.1em] uppercase sm:px-2.5 sm:py-1.5 sm:text-[10px] sm:tracking-[0.14em]',
              RESTING.hud === 0 ? 'is-active' : '',
            ]}>01 · Break</span
          >
          <span
            data-hud-tab="1"
            class:list={[
              'rounded-sm border px-1.5 py-1 font-mono text-[8px] tracking-[0.1em] uppercase sm:px-2.5 sm:py-1.5 sm:text-[10px] sm:tracking-[0.14em]',
              RESTING.hud === 1 ? 'is-active' : '',
            ]}>02 · Climb</span
          >
        </div>

        <!-- Stamp. Revealed by default: the resting/no-JS/reduced-motion
             state is the story's ending, so RESTING.stamp should already be
             showing, not waiting on JS that (under reduced motion) never
             runs. The animated cycle's stampHide() resets this back to
             hidden the instant it starts.

             Below `sm` the panel is single-column *and* short — full
             container width but only a 4:3 viewBox's worth of height, so a
             desktop-sized stamp positioned at 30% down collides with both
             the HUD above it and the caption card below it. It gets a
             smaller, higher-up position instead of the original past that
             breakpoint, where the panel has enough height (wide single-
             column, or the split 2-column desktop layout) to take it. -->
        <div
          data-stamp
          class="border-gm-red font-display text-gm-red pointer-events-none absolute top-[10%] left-[6%] z-[3] border-2 bg-black/55 px-2 py-0.5 text-[10px] font-black tracking-[0.03em] whitespace-nowrap uppercase sm:top-[30%] sm:left-[34%] sm:px-4 sm:py-2 sm:text-lg"
          style="transform: scale(1) rotate(-8deg); transition: transform 0.3s cubic-bezier(.2,1.5,.35,1), opacity 0.25s ease;"
        >
          {RESTING.stamp}
        </div>

        <!-- Callout — hidden below `xl`. Not just the single-column range:
             the split 2-column layout starts at `lg` (1024px) with the
             panel at its narrowest (~1.05fr of a ~960px container), which
             is exactly as cramped as the single-column case and collides
             with the caption card the same way. The panel only clears
             enough by ~1280px (`xl`) for stamp + callout + caption card to
             coexist. The callout's spec detail isn't lost either way — the
             same facts are in the caption sub-copy and, in more depth, in
             the Proof358 section right after this one. -->
        <div
          data-callout
          class="pointer-events-none absolute top-[52%] left-[6%] z-[3] hidden max-w-[220px] xl:block"
          style="transform: translateY(0); transition: opacity 0.5s ease, transform 0.5s ease;"
        >
          <div class="flex items-center gap-1">
            <span class="bg-gm-red h-3 w-px"></span><span class="bg-gm-red h-px flex-1"></span><span
              class="bg-gm-red h-3 w-px"></span>
          </div>
          <p
            data-callout-text
            class="mt-2.5 font-mono text-[11px] leading-relaxed text-[#ffd7dc]"
            style="text-shadow: 0 2px 8px rgba(0,0,0,.8);"
          >
            {RESTING.callout}
          </p>
        </div>

        <!-- Caption card -->
        <div
          class="absolute inset-x-3 bottom-3 z-[3] overflow-hidden rounded border border-white/12 bg-black/70 p-3 backdrop-blur-md sm:inset-x-5 sm:bottom-5 sm:p-5"
        >
          <div data-phase-bar class="bg-gm-red absolute top-0 left-0 h-[2px]" style="width: 100%;">
          </div>
          <div class="mb-2 flex items-center gap-2.5 sm:mb-2.5">
            <span
              data-phase-tag
              class="text-gm-red font-mono text-[11px] tracking-[0.2em] whitespace-nowrap uppercase"
              >{RESTING.tag}</span
            >
            <span class="h-px flex-1 bg-white/15"></span>
          </div>
          <p
            data-phase-title
            class="font-display text-gm-white text-base leading-none font-black uppercase sm:text-lg"
          >
            {RESTING.title}
          </p>
          <p data-phase-sub class="text-gm-grey-300 mt-2 text-[13px] leading-relaxed">
            {RESTING.sub}
          </p>
        </div>
      </div>
    </figure>
  </div>

  <script is:inline type="application/json" data-phases set:html={JSON.stringify(PHASES)} />
</section>

<style>
  [data-intrusion] .ia-solar-pulse {
    animation: ia-solar-pulse 3.4s ease-in-out infinite;
  }
  @keyframes ia-solar-pulse {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 1;
    }
  }

  /* Night atmosphere — moon, stars, CRT texture, scanner sweep. All static
     DOM, pure CSS; the reveal happens once regardless of JS/motion state, so
     there's nothing here for a no-JS visitor to miss. */
  [data-intrusion] .ia-moon {
    position: absolute;
    top: 12%;
    left: 9%;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #e8e9f0;
    box-shadow: 0 0 70px 20px rgba(232, 233, 240, 0.14);
    opacity: 0.9;
    pointer-events: none;
  }
  [data-intrusion] .ia-moon-shade {
    position: absolute;
    top: 12.6%;
    left: 7.8%;
    width: 38px;
    height: 40px;
    border-radius: 50%;
    background: #0b0d16;
    opacity: 0.55;
    pointer-events: none;
  }
  [data-intrusion] .ia-star {
    position: absolute;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: #cfd2de;
    pointer-events: none;
    animation: ia-star-pulse 3.6s ease-in-out infinite;
  }
  @keyframes ia-star-pulse {
    0%,
    100% {
      opacity: 0.3;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.25);
    }
  }
  [data-intrusion] .ia-crt {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      0deg,
      rgba(255, 255, 255, 0.02) 0 1px,
      transparent 1px 4px
    );
    opacity: 0.4;
  }
  [data-intrusion] .ia-scanline {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 12%;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(228, 17, 42, 0.12), transparent);
    animation: ia-scanline-sweep 6s linear infinite;
  }
  @keyframes ia-scanline-sweep {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(900%);
    }
  }

  /* The red "hot" mesh — a duplicate of the grid lines and spikes, revealed
     only inside a soft circle that tracks the glow (--glow-x/-y/-r, written
     every frame by the script). Same masked-reveal idea as Proof358's scan
     band, just following a point instead of sweeping a fixed band. */
  [data-intrusion] .mesh-hot-ia {
    position: absolute;
    inset: 0;
    pointer-events: none;
    filter: drop-shadow(0 0 4px rgba(255, 66, 87, 0.6));
    /* circle()'s explicit radius must be a <length>, not a <percentage> — a
       percentage here is an invalid value, which makes the whole
       mask-image computed-value invalid and falls back to "no mask"
       (fully revealed) instead of "fully hidden". The script measures the
       scene's rendered width and writes --glow-r in px for exactly that
       reason. */
    mask-image: radial-gradient(
      circle var(--glow-r, 0px) at var(--glow-x, 50%) var(--glow-y, 50%),
      #000 55%,
      transparent 100%
    );
    -webkit-mask-image: radial-gradient(
      circle var(--glow-r, 0px) at var(--glow-x, 50%) var(--glow-y, 50%),
      #000 55%,
      transparent 100%
    );
  }

  [data-intrusion] [data-hud-tab] {
    border-color: #2b2b33;
    color: #6a6a72;
    background: transparent;
    transition:
      border-color 0.25s ease,
      color 0.25s ease,
      background 0.25s ease;
  }
  [data-intrusion] [data-hud-tab].is-active {
    border-color: var(--color-gm-red);
    color: #ff5069;
    background: rgba(228, 17, 42, 0.14);
  }

  [data-intrusion] [data-scene] {
    isolation: isolate;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-intrusion] .ia-solar-pulse {
      animation: none;
      opacity: 0.8;
    }
    [data-intrusion] .ia-star,
    [data-intrusion] .ia-scanline {
      animation: none;
    }
    [data-intrusion] .ia-scanline {
      opacity: 0;
    }
    [data-intrusion] .mesh-hot-ia {
      display: none;
    }
  }
</style>

<script>
  type Phase = {
    id: 'force' | 'forceFail' | 'climb' | 'spikeFail';
    hud: 0 | 1;
    durationMs: number;
    tag: string;
    title: string;
    sub: string;
    stamp?: string;
    callout?: string;
  };

  const section = document.querySelector<HTMLElement>('[data-intrusion]');
  const dataEl = section?.querySelector<HTMLScriptElement>('[data-phases]');
  if (!section || !dataEl) {
    // no-op — the section
  } else {
    const PHASES = JSON.parse(dataEl.textContent || '[]') as Phase[];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const scene = section.querySelector<HTMLElement>('[data-scene]');
    const thief = section.querySelector<SVGGElement>('[data-thief]');
    const restingThief = section.querySelector<SVGGElement>('[data-resting-thief]');
    const poses = {
      force: section.querySelector<SVGGElement>('[data-pose="force"]'),
      climb: section.querySelector<SVGGElement>('[data-pose="climb"]'),
      recoil: section.querySelector<SVGGElement>('[data-pose="recoil"]'),
    };
    const glow = section.querySelector<SVGCircleElement>('[data-glow]');
    const sparkLayer = section.querySelector<SVGGElement>('[data-spark-layer]');
    const sceneShake = section.querySelector<HTMLElement>('[data-scene-shake]');
    const stamp = section.querySelector<HTMLElement>('[data-stamp]');
    const callout = section.querySelector<HTMLElement>('[data-callout]');
    const calloutText = section.querySelector<HTMLElement>('[data-callout-text]');
    const hudTabs = Array.from(section.querySelectorAll<HTMLElement>('[data-hud-tab]'));
    const bar = section.querySelector<HTMLElement>('[data-phase-bar]');
    const tagEl = section.querySelector<HTMLElement>('[data-phase-tag]');
    const titleEl = section.querySelector<HTMLElement>('[data-phase-sub]')
      ? section.querySelector<HTMLElement>('[data-phase-title]')
      : null;
    const subEl = section.querySelector<HTMLElement>('[data-phase-sub]');

    if (!reduce && scene && thief && glow) {
      // Hand off from the static resting illustration to the animated one.
      restingThief?.setAttribute('style', 'display:none');
      thief.setAttribute('style', 'opacity:1');

      const setPose = (name: 'force' | 'climb' | 'recoil') => {
        (Object.keys(poses) as Array<keyof typeof poses>).forEach((k) => {
          poses[k]?.setAttribute('style', `opacity:${k === name ? 1 : 0}`);
        });
      };

      const setCaption = (p: Phase) => {
        [tagEl, titleEl, subEl].forEach((el) => el && (el.style.opacity = '0'));
        window.setTimeout(() => {
          if (tagEl) tagEl.textContent = p.tag;
          if (titleEl) titleEl.textContent = p.title;
          if (subEl) subEl.textContent = p.sub;
          [tagEl, titleEl, subEl].forEach((el) => el && (el.style.opacity = '1'));
        }, 180);
        hudTabs.forEach((el) =>
          el.classList.toggle('is-active', Number(el.dataset.hudTab) === p.hud),
        );
      };

      const stampShow = (text: string) => {
        if (!stamp) return;
        stamp.textContent = text;
        window.setTimeout(() => {
          stamp.style.opacity = '1';
          stamp.style.transform = 'scale(1) rotate(-8deg)';
        }, 320);
      };
      const stampHide = () => {
        if (!stamp) return;
        stamp.style.opacity = '0';
        stamp.style.transform = 'scale(1.6) rotate(-14deg)';
      };
      const calloutShow = (text: string) => {
        if (!callout) return;
        if (calloutText) calloutText.textContent = text;
        callout.style.opacity = '1';
        callout.style.transform = 'translateY(0)';
      };
      const calloutHide = () => {
        if (!callout) return;
        callout.style.opacity = '0';
        callout.style.transform = 'translateY(10px)';
      };

      // Scene geometry, in the SVG's own 0–400×0–300 viewBox units.
      const ATTACK_X = 180;
      const GROUND_Y = 168; // thief anchor y when standing at ground level
      const TOP_Y = 40; // thief anchor y when at the top rail

      const sparks: { el: SVGCircleElement }[] = [];
      const spawnSpark = (x: number, y: number) => {
        if (!sparkLayer || sparks.length > 14) return;
        const el = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        el.setAttribute('cx', String(x));
        el.setAttribute('cy', String(y));
        el.setAttribute('r', '1.8');
        el.setAttribute('fill', '#ffcf8a');
        sparkLayer.appendChild(el);
        sparks.push({ el });
        const dx = (Math.random() - 0.5) * 22;
        const dy = Math.random() * 14 + 4;
        const anim = el.animate(
          [
            { transform: 'scale(1)', opacity: 0.95 },
            { transform: `translate(${dx}px, ${dy}px) scale(0.2)`, opacity: 0 },
          ],
          { duration: 340 + Math.random() * 160, easing: 'ease-out' },
        );
        anim.onfinish = () => {
          el.remove();
          const i = sparks.findIndex((s) => s.el === el);
          if (i >= 0) sparks.splice(i, 1);
        };
      };
      // A trigger moment (a jab landing, an impact) throws a small cluster
      // of sparks, not one at a time — matches the reference's particle
      // bursts instead of reading as a single ember drifting off.
      const spawnSparkBurst = (x: number, y: number, count: number) => {
        for (let i = 0; i < count; i++) {
          spawnSpark(x + (Math.random() - 0.5) * 10, y + (Math.random() - 0.5) * 10);
        }
      };

      // Shakes the mesh + thief together on impact (not the HUD/stamp/
      // callout/caption overlay, which sit outside this wrapper) — matches
      // the reference's #gm-shake, which wraps only the canvas + thief.
      const setShake = (x: number, y: number) => {
        if (sceneShake) sceneShake.style.transform = `translate(${x}px, ${y}px)`;
      };

      const easeOut = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : 1 - Math.pow(1 - x, 3));
      const easeInOut = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x * x * (3 - 2 * x));
      const easeIn = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x * x);

      // The mesh-hot mask's circle radius must be a real <length>, not a
      // <percentage> (CSS only allows percentages for an explicit ellipse
      // size, not a circle) — so the glow's viewBox-unit radius is converted
      // to px against the scene's actual rendered width, re-measured on
      // resize.
      let sceneWidthPx = scene.getBoundingClientRect().width || 600;
      window.addEventListener('resize', () => {
        sceneWidthPx = scene.getBoundingClientRect().width || sceneWidthPx;
      });

      const setGlow = (x: number, y: number, r: number, o: number) => {
        glow.setAttribute('cx', String(x));
        glow.setAttribute('cy', String(y));
        glow.setAttribute('r', String(r));
        glow.setAttribute('opacity', String(o));
        // Drives the red mesh-hot mask too, so the grid lights up right
        // where the glow sits instead of staying inert under it.
        scene.style.setProperty('--glow-x', (x / 400) * 100 + '%');
        scene.style.setProperty('--glow-y', (y / 300) * 100 + '%');
        scene.style.setProperty(
          '--glow-r',
          o > 0 ? ((r * 1.4) / 400) * sceneWidthPx + 'px' : '0px',
        );
      };
      const setThiefPos = (x: number, y: number, extraTransform = '') => {
        thief.setAttribute('transform', `translate(${x},${y}) scale(0.42) ${extraTransform}`);
      };

      let pi = -1;
      let phaseStart = 0;
      let rafId = 0;
      let running = false;

      const frame = (t: number) => {
        if (!running) return;
        if (pi < 0 || t - phaseStart > PHASES[pi].durationMs) {
          pi = (pi + 1) % PHASES.length;
          phaseStart = t;
          const p = PHASES[pi];
          setCaption(p);
          stampHide();
          calloutHide();
          if (p.stamp) stampShow(p.stamp);
          if (p.callout) calloutShow(p.callout);
        }
        const p = PHASES[pi];
        const local = t - phaseStart;

        if (bar) bar.style.width = Math.min(1, local / p.durationMs) * 100 + '%';

        if (p.id === 'force') {
          setPose('force');
          const appear = easeOut(Math.min(1, local / 700));
          const bx = ATTACK_X - 40 + (1 - appear) * 120;
          const striking = local > 900;
          const cycle = striking ? ((local - 900) % 1100) / 1100 : 1;
          const jab = striking && cycle < 0.14 ? Math.sin((cycle / 0.14) * Math.PI) : 0;
          setThiefPos(bx, GROUND_Y, `translate(${-jab * 10} 0)`);
          setGlow(ATTACK_X, GROUND_Y - 20, 26 + jab * 20, 0.35 + jab * 0.5);
          if (jab > 0.7) {
            setShake(Math.sin(t / 23) * 2.6 * jab, Math.cos(t / 29) * 1.4 * jab);
            if (Math.random() > 0.5) {
              spawnSparkBurst(ATTACK_X, GROUND_Y - 20, 2 + Math.floor(Math.random() * 3));
            }
          } else {
            setShake(0, 0);
          }
        } else if (p.id === 'forceFail') {
          setPose('force');
          const back = easeOut(Math.min(1, local / 800));
          setThiefPos(ATTACK_X - 40 + back * 20, GROUND_Y);
          const pulse = Math.sin(t / 240) * 0.5 + 0.5;
          setGlow(ATTACK_X, GROUND_Y - 20, 30, 0.2 + pulse * 0.25);
          setShake(0, 0);
        } else if (p.id === 'climb') {
          setPose('climb');
          const k = easeInOut(Math.min(1, local / 4200));
          const y = GROUND_Y - k * (GROUND_Y - TOP_Y);
          setThiefPos(ATTACK_X - 32, y, `translate(${Math.sin(t / 300) * 2} 0)`);
          setGlow(ATTACK_X, y + 40, 32, 0.5);
          setShake(0, 0);
          if (k > 0.15 && k < 0.97 && Math.random() > 0.88) {
            spawnSparkBurst(
              ATTACK_X + (Math.random() - 0.5) * 30,
              y + 60,
              1 + Math.floor(Math.random() * 2),
            );
          }
        } else {
          setPose(local < 260 ? 'climb' : 'recoil');
          if (local < 700) {
            setThiefPos(ATTACK_X - 32, TOP_Y);
            setGlow(ATTACK_X, TOP_Y + 10, 34, 0.55);
            setShake(Math.sin(t / 22) * 1.8, 0);
            if (local < 360 && Math.random() > 0.45) {
              spawnSparkBurst(
                ATTACK_X + (Math.random() - 0.5) * 26,
                TOP_Y,
                2 + Math.floor(Math.random() * 2),
              );
            }
          } else {
            const fk = easeIn(Math.min(1, (local - 700) / 900));
            const y = TOP_Y + fk * (GROUND_Y - TOP_Y);
            setThiefPos(ATTACK_X - 32 + fk * 26, y, `rotate(${fk * 14})`);
            setGlow(ATTACK_X, TOP_Y + 10, 34 * (1 - fk), 0.4 * (1 - fk));
            setShake(0, 0);
          }
        }

        rafId = requestAnimationFrame(frame);
      };

      const start = () => {
        if (running) return;
        running = true;
        pi = -1;
        rafId = requestAnimationFrame(frame);
      };
      const stop = () => {
        running = false;
        cancelAnimationFrame(rafId);
      };

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => (e.isIntersecting ? start() : stop()));
        },
        { rootMargin: '0px 0px -12% 0px' },
      );
      io.observe(section);
    }
  }
</script>
