---
/**
 * Section — "Get in Touch with Our Team".
 *
 * Straight from the client's own homepage: the same three contact routes
 * (general line, plus Giuliano and Fabian on direct numbers), the same
 * factory, and the same eleven enquiry types their contact form offers. The
 * two names are the real named contacts on fencing-supplier.com — no invented
 * job titles are attached to either, only the label the reference site itself
 * uses them under.
 *
 * **There is no backend.** quote-estimator.astro already establishes the house
 * rule for that — build the real form, and be honest at the point of submit
 * rather than posting into a void. This section takes the honest route one
 * step further and never pretends to submit at all: the enquiry-type control
 * composes a `mailto:` with a pre-filled subject line, so choosing "Installation
 * & Site Survey Request" opens the visitor's own mail client with that in the
 * subject. It genuinely works, today, with no server.
 *
 * With JS off, the select is inert but the email button is still a plain,
 * working `mailto:` with a generic subject — and every phone number and
 * address on the page is a real `tel:`/`address` either way. Nothing here is a
 * dead control that silently does nothing.
 *
 * Light section, before CtaBand (dark).
 */

const GENERAL_EMAIL = 'info@fencing-supplier.com';

const CONTACTS = [
  {
    label: 'General Enquiries',
    name: null,
    tel: '+27 11 437 8903',
    href: 'tel:+27114378903',
    email: null,
  },
  {
    label: 'Direct Line',
    name: 'Giuliano',
    tel: '+27 82 659 0301',
    href: 'tel:+27826590301',
    email: 'info@fencing-supplier.com',
  },
  {
    label: 'Direct Line',
    name: 'Fabian',
    tel: '+27 82 542 3670',
    href: 'tel:+27825423670',
    email: 'fabian@fencing-supplier.com',
  },
];

/** The reference site's own enquiry-type list, in its own order. */
const ENQUIRY_TYPES = [
  'Clear View Fencing (Panels, Posts & Gates)',
  'Guard Master High-Security Fencing',
  'Double Mesh / High-Security Fencing',
  'Projects',
  'Razor Wire Mesh & Posts',
  'Concertina Razor Wire',
  'Rapid Deployment / Mobile Security Barriers',
  'Installation & Site Survey Request',
  'Bulk / Trade / Export Enquiry',
  'General Enquiry',
  'Other',
];

const FALLBACK_SUBJECT = 'Fencing enquiry';
const FALLBACK_MAILTO = `mailto:${GENERAL_EMAIL}?subject=${encodeURIComponent(FALLBACK_SUBJECT)}`;
---

<section id="contact" data-contact class="bg-gm-white text-gm-black py-20 sm:py-28">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
    <div class="grid gap-14 lg:grid-cols-[1fr_1fr] lg:gap-20">
      <div>
        <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Get In Touch</p>
        <h2
          class="font-display text-gm-black mt-5 text-4xl leading-[0.95] font-black tracking-tight uppercase sm:text-5xl"
        >
          Talk To The People <span class="text-gm-red">Who Make It.</span>
        </h2>
        <p class="text-gm-grey-600 mt-6 max-w-xl text-base leading-relaxed">
          A question about products, pricing, installation or a custom project goes straight to a
          specialist — not a call centre. Tell us the site, the products and the quantities you're
          working with and we'll come back with a tailored quotation.
        </p>

        <dl class="border-gm-grey-200 mt-10 border-t">
          {
            CONTACTS.map((contact) => (
              <div class="border-gm-grey-200 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b py-5">
                <dt class="min-w-0">
                  <span class="text-gm-grey-500 block font-mono text-[10px] tracking-[0.2em] uppercase">
                    {contact.label}
                  </span>
                  {contact.name && (
                    <span class="font-display text-gm-black mt-1 block text-lg font-bold tracking-tight uppercase">
                      {contact.name}
                    </span>
                  )}
                </dt>
                <dd class="flex flex-col items-start gap-1 sm:items-end">
                  <a
                    href={contact.href}
                    class="tap-target text-gm-black hover:text-gm-red inline-flex items-center font-mono text-base font-bold transition-colors"
                  >
                    {contact.tel}
                  </a>
                  {contact.email && (
                    <a
                      href={`mailto:${contact.email}`}
                      class="tap-target text-gm-grey-600 hover:text-gm-black inline-flex items-center text-[13px] transition-colors"
                    >
                      {contact.email}
                    </a>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>

        <p class="text-gm-grey-500 mt-6 text-[13px] leading-relaxed">
          Factory: 10 Burnley Street, Benoni South Extn., Gauteng 1501, South Africa.
        </p>
      </div>

      <!-- Enquiry composer. Picks the subject line, hands off to the visitor's
           own mail client — no server, no silent drop. -->
      <div class="border-gm-grey-200 bg-gm-grey-50 border p-6 sm:p-8">
        <p class="text-gm-grey-500 font-mono text-[11px] tracking-[0.2em] uppercase">
          Start An Enquiry
        </p>
        <h3
          class="font-display text-gm-black mt-4 text-2xl leading-tight font-bold tracking-tight uppercase"
        >
          What Are You Enquiring About?
        </h3>

        <label
          for="enquiry-type"
          class="text-gm-grey-600 mt-6 block font-mono text-[11px] tracking-[0.14em] uppercase"
        >
          Enquiry type
        </label>
        <select
          id="enquiry-type"
          data-enquiry-type
          class="tap-target border-gm-grey-300 bg-gm-white text-gm-black focus-visible:outline-gm-red mt-2 w-full border px-3 py-3 text-sm focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          {ENQUIRY_TYPES.map((type) => <option value={type}>{type}</option>)}
        </select>

        <p class="text-gm-grey-600 mt-6 text-[13px] leading-relaxed">
          Include your project, the products and quantities you need, the site location, and any
          specific requirements — the more detail, the faster the quote comes back.
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <a
            data-enquiry-mail
            href={FALLBACK_MAILTO}
            class="tap-target bg-gm-red text-gm-white inline-flex items-center px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors hover:bg-[#c50e24]"
          >
            Email This Enquiry
          </a>
          <a
            href="/clear-fencing-estimator"
            class="tap-target border-gm-grey-300 text-gm-black hover:border-gm-black inline-flex items-center border px-6 text-[13px] font-bold tracking-[0.08em] uppercase transition-colors"
          >
            Or Build An Estimate
          </a>
        </div>

        <p class="text-gm-grey-500 mt-5 text-[11px] leading-relaxed">
          Opens in your own email app, addressed to {GENERAL_EMAIL} with the subject filled in.
        </p>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ GENERAL_EMAIL }}>
  const section = document.querySelector('[data-contact]');
  if (section) {
    const select = section.querySelector('[data-enquiry-type]');
    const mail = section.querySelector('[data-enquiry-mail]');

    if (select && mail) {
      const sync = () => {
        const subject = `Enquiry — ${select.value}`;
        mail.href = `mailto:${GENERAL_EMAIL}?subject=${encodeURIComponent(subject)}`;
      };
      sync();
      select.addEventListener('change', sync);
    }
  }
</script>
