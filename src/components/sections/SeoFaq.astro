---
/**
 * Section 8 — SEO content block + FAQ.
 *
 * seoguide.md §1's own homepage H2 outline lists "SEO content block" and
 * "FAQ" as two of the page's H2s, with the content block's H3s named
 * explicitly: "what clear-view fencing is · 358 mesh explained ·
 * applications · finishes · US shipping" — the five H3s below are exactly
 * that list, not an invented structure.
 *
 * seoguide.md §5 requires FAQPage JSON-LD whose `text` is "identical to the
 * answer already in the DOM" and never JS-injected. FAQS is defined once
 * below and used for both the rendered <details> answers and the JSON-LD via
 * JSON.stringify, so the two can't drift out of sync. Two of the six
 * questions ("What is 358 mesh fencing?" / "Do you ship across the United
 * States?") are seoguide.md Appendix B3's own example queries, kept as the
 * target questions — but their answers are deliberately NOT the appendix's
 * example wording verbatim, because that wording just re-derives facts the
 * explainer block above already states (aperture size, "direct from the
 * manufacturer"). Answering the same literal query from a different angle
 * (welded-vs-chain-link, no-reseller/no-customs-wait) keeps the FAQ from
 * reading as the explainer restated in accordion form.
 *
 * FAQ accordion: unlike BuiltFor's exclusive one-at-a-time (matching how
 * five *alternative* buyer segments should behave — picking one deselects
 * the others), FAQ answers are independent facts a visitor may want to
 * compare, so several can stay open at once. Same JS height-animation
 * technique as BuiltFor, just without the "close the others" step.
 *
 * Light section, closing out the rhythm from designguide.md §4.
 */

type Faq = { question: string; answer: string };

const FAQS: Faq[] = [
  {
    question: 'What is 358 mesh fencing?',
    answer:
      "358 mesh is Guard Master's flagship security panel — a rigid steel grid welded at every intersection rather than woven like chain-link, which is what makes it something you can see through but not climb or cut through.",
  },
  {
    question: 'Do you ship across the United States?',
    answer:
      "Yes — every system ships direct from the manufacturer to your site across the continental US. There's no reseller markup and no overseas import sitting in a customs queue in between.",
  },
  {
    question: 'How long is the warranty?',
    answer:
      'Warranty length depends on finish. Our Plascoat finish — the top of the finish ladder — carries a 10-year warranty; Hot-Dip Galvanised and Powder Coated finishes are covered too, at shorter terms. Full coverage details are on the warranties page.',
  },
  {
    question: 'Can I add gates or security toppings to my order?',
    answer:
      'Yes — gates, razor and spike toppings, and solar post caps are all configurable extras in the instant estimator, priced alongside your core panel-and-post system.',
  },
  {
    question: 'Do you install the fencing, or just supply it?',
    answer:
      "We manufacture, supply and install the engineered system — panels, posts, fixings and accessories — direct from the factory. Prefer your own contractor instead? Every system still ships with full installation guidance and our team's support through the build.",
  },
  {
    question: 'How do I get a firm price?',
    answer:
      'Start with the instant estimator for a bill of materials and a price range. Every completed estimate reaches our team, who confirm a firm quote once your finish, toppings and site details are set.',
  },
];
---

<section data-seo-faq class="bg-gm-white text-gm-black relative overflow-hidden py-20 sm:py-28">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
    <!-- SEO content block — deliberately NOT another bordered divider-row
         list: the FAQ sits right below this in the same section, and giving
         both the same "header + top rule + stacked bordered rows" shape
         read as the same component twice in a row. This is a 2-column grid
         of numbered spec entries instead — a different silhouette (grid,
         no rules, number-over-heading-over-copy per cell) so the two halves
         of this section stay visually distinct from each other, not just
         differently labelled. Every H3/paragraph pair from seoguide.md §1's
         required list is still real, static DOM either way — nothing here
         needs JS to be complete or crawlable. -->
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">
        Clear View Fencing, Explained
      </p>
      <h2
        class="font-display text-gm-black mt-5 text-3xl leading-[1.05] font-black tracking-tight uppercase sm:text-4xl"
      >
        What Guard Master Actually Builds
      </h2>
    </div>

    <!-- Technical cutaway — this block was the flattest thing on the page:
         five facts as plain text with no visual anchor, while every sibling
         section (SystemAssembly's
         connected-parts diagram, FinishLadder's staircase) earns its place
         with something to actually look at. This draws the same 76.2 × 12.7
         mm aperture and welded node that fact 02's copy already states in
         words — same real numbers, same `patternUnits` technique the panel
         drawings
         uses for its own mesh grid (a tile sized to the true mm dimensions,
         not a stylised approximation) — so the diagram and the copy can't
         drift out of sync with each other. Geometry only in the SVG; the
         three labels are real HTML text absolutely positioned over it, so
         they stay legible instead of scaling down with the artwork. Hidden
         below `lg`: at that width the wide aspect ratio compresses enough
         that the labels would start crowding their own leader lines, and
         the text grid below already carries the full content on its own. -->
    <div class="relative mx-auto mt-12 hidden aspect-[620/280] w-full max-w-3xl lg:mt-14 lg:block">
      <svg
        viewBox="0 0 620 280"
        class="h-full w-full"
        role="img"
        aria-label="Cutaway of a post and 358 mesh panel, with one aperture dimensioned at 76.2 by 12.7 millimetres and a welded node called out"
      >
        <defs>
          <pattern id="explainer-mesh" patternUnits="userSpaceOnUse" width="76.2" height="12.7">
            <line x1="0" y1="0" x2="0" y2="12.7" stroke="#bababa" stroke-width="1.6"></line>
            <line x1="0" y1="0" x2="76.2" y2="0" stroke="#bababa" stroke-width="1.6"></line>
            <circle cx="0" cy="0" r="2" fill="#e4112a"></circle>
          </pattern>
        </defs>

        <!-- post + cap -->
        <rect
          x="20"
          y="20"
          width="48"
          height="16"
          rx="2"
          fill="#f7f7f7"
          stroke="#161616"
          stroke-width="2"></rect>
        <rect x="34" y="36" width="20" height="200" fill="#f7f7f7" stroke="#161616" stroke-width="2"
        ></rect>

        <!-- panel: 5 columns × 10 rows of the real 76.2×12.7mm tile -->
        <rect
          x="90"
          y="60"
          width="381"
          height="127"
          fill="url(#explainer-mesh)"
          stroke="#d6d6d6"
          stroke-width="1.5"></rect>

        <!-- one aperture, called out -->
        <rect
          x="242.4"
          y="110.8"
          width="76.2"
          height="12.7"
          fill="rgba(228,17,42,0.07)"
          stroke="#e4112a"
          stroke-width="2"></rect>

        <!-- weld-node leader -->
        <path d="M242.4 110.8 L 190 78" fill="none" stroke="#9a9a9a" stroke-width="1.4"></path>
        <circle cx="242.4" cy="110.8" r="3" fill="#e4112a"></circle>

        <!-- width dimension (76.2mm) -->
        <path
          d="M242.4 123.5 V 210 M318.6 123.5 V 210"
          fill="none"
          stroke="#c9c9c9"
          stroke-width="1"
          stroke-dasharray="3 3"></path>
        <path d="M242.4 202 V 210 H 318.6 V 202" fill="none" stroke="#6e6e6e" stroke-width="1.4"
        ></path>

        <!-- height dimension (12.7mm) -->
        <path
          d="M318.6 110.8 H 400 M318.6 123.5 H 400"
          fill="none"
          stroke="#c9c9c9"
          stroke-width="1"
          stroke-dasharray="3 3"></path>
        <path d="M392 110.8 H 400 V 123.5 H 392" fill="none" stroke="#6e6e6e" stroke-width="1.4"
        ></path>
      </svg>

      <p
        class="text-gm-grey-600 absolute font-mono text-[10px] tracking-[0.16em] uppercase"
        style="left: 15%; top: 20%;"
        aria-hidden="true"
      >
        Welded node
      </p>
      <p
        class="text-gm-red absolute font-mono text-[10px] font-bold tracking-[0.1em] uppercase"
        style="left: 45%; top: 79%; transform: translateX(-50%);"
        aria-hidden="true"
      >
        76.2 mm
      </p>
      <p
        class="text-gm-red absolute font-mono text-[10px] font-bold tracking-[0.1em] uppercase"
        style="left: 66%; top: 41%;"
        aria-hidden="true"
      >
        12.7 mm
      </p>
    </div>

    <div
      data-explainer
      class="border-gm-grey-200 mt-10 grid gap-x-10 gap-y-10 border-t pt-10 sm:mt-12 sm:grid-cols-2 sm:gap-x-14 sm:gap-y-12 sm:pt-12"
    >
      <div data-explainer-row class="group">
        <span
          class="text-gm-grey-300 group-hover:text-gm-red font-mono text-3xl font-black transition-colors duration-300 sm:text-4xl"
          aria-hidden="true">01</span
        >
        <h3
          class="font-display text-gm-black mt-3 text-lg font-bold tracking-tight uppercase sm:text-xl"
        >
          What Is Clear View Fencing?
        </h3>
        <p class="text-gm-grey-600 mt-2.5 text-sm leading-relaxed sm:text-base">
          Clear view fencing is a welded mesh perimeter you can see straight through — unlike a
          solid privacy fence, it keeps sightlines open for cameras, lighting and security patrols,
          while the mesh itself stops anyone from climbing or cutting through it.
        </p>
      </div>

      <div data-explainer-row class="group">
        <span
          class="text-gm-grey-300 group-hover:text-gm-red font-mono text-3xl font-black transition-colors duration-300 sm:text-4xl"
          aria-hidden="true">02</span
        >
        <h3
          class="font-display text-gm-black mt-3 text-lg font-bold tracking-tight uppercase sm:text-xl"
        >
          358 Mesh Explained
        </h3>
        <p class="text-gm-grey-600 mt-2.5 text-sm leading-relaxed sm:text-base">
          358 mesh takes its name from its dimensions — a welded steel grid with a 76.2 × 12.7 mm
          aperture, 4 mm wire and a welded node at every intersection, engineered so a fingertip, a
          foothold or a bolt-cutter's jaw simply doesn't fit.
        </p>
      </div>

      <div data-explainer-row class="group">
        <span
          class="text-gm-grey-300 group-hover:text-gm-red font-mono text-3xl font-black transition-colors duration-300 sm:text-4xl"
          aria-hidden="true">03</span
        >
        <h3
          class="font-display text-gm-black mt-3 text-lg font-bold tracking-tight uppercase sm:text-xl"
        >
          Where It's Used
        </h3>
        <p class="text-gm-grey-600 mt-2.5 text-sm leading-relaxed sm:text-base">
          Commercial and industrial sites, utility and solar assets, government and institutional
          perimeters, and high-security residential properties — see{' '}
          <a href="#built-for" class="text-gm-red underline underline-offset-2">who we protect</a>{
            ' '
          }for the full breakdown by sector.
        </p>
      </div>

      <div data-explainer-row class="group">
        <span
          class="text-gm-grey-300 group-hover:text-gm-red font-mono text-3xl font-black transition-colors duration-300 sm:text-4xl"
          aria-hidden="true">04</span
        >
        <h3
          class="font-display text-gm-black mt-3 text-lg font-bold tracking-tight uppercase sm:text-xl"
        >
          Finishes Available
        </h3>
        <p class="text-gm-grey-600 mt-2.5 text-sm leading-relaxed sm:text-base">
          Plain Galvanised, Hot-Dip Galvanised, Powder Coated and Plascoat/PVC — a good/better/best
          ladder, with the top tier carrying our{' '}
          <a href="/warranties-and-guarantees" class="text-gm-red underline underline-offset-2"
            >10-year warranty</a
          >.
        </p>
      </div>

      <div data-explainer-row class="group sm:col-span-2">
        <span
          class="text-gm-grey-300 group-hover:text-gm-red font-mono text-3xl font-black transition-colors duration-300 sm:text-4xl"
          aria-hidden="true">05</span
        >
        <h3
          class="font-display text-gm-black mt-3 text-lg font-bold tracking-tight uppercase sm:text-xl"
        >
          Shipping Across the US
        </h3>
        <p class="text-gm-grey-600 mt-2.5 max-w-2xl text-sm leading-relaxed sm:text-base">
          Guard Master manufactures and ships direct across the continental United States — imperial
          units, US specs, US support, not an overseas order dropped at your door with no one to
          call.
        </p>
      </div>
    </div>

    <!-- FAQ -->
    <div id="faq" class="mt-20 lg:mt-24">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">FAQ</p>
        <h2
          class="font-display text-gm-black mt-5 text-3xl leading-[1.05] font-black tracking-tight uppercase sm:text-4xl"
        >
          Questions We Get Asked
        </h2>
      </div>

      <div class="border-gm-grey-200 mx-auto mt-10 max-w-3xl border-t">
        {
          FAQS.map((f) => (
            <details data-faq-row class="border-gm-grey-200 border-b">
              <summary class="tap-target flex cursor-pointer list-none items-center justify-between gap-5 py-5 marker:content-none [&::-webkit-details-marker]:hidden">
                <span class="text-gm-black text-[15px] font-bold sm:text-base">{f.question}</span>
                <svg
                  data-faq-chevron
                  viewBox="0 0 24 24"
                  class="text-gm-grey-400 h-5 w-5 shrink-0 transition-transform duration-300"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M6 9l6 6 6-6"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </summary>
              <div data-faq-panel>
                <p class="text-gm-grey-600 max-w-2xl pb-6 text-sm leading-relaxed">{f.answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

{
  /* seoguide.md Appendix B3 — text values are generated from FAQS above, so
    they can never drift from what's actually rendered in the DOM. */
}
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  })}
/>

<style>
  [data-seo-faq] summary {
    -webkit-tap-highlight-color: transparent;
  }
  [data-seo-faq] summary::marker {
    content: '';
  }
  [data-seo-faq] details[open] > summary [data-faq-chevron] {
    transform: rotate(180deg);
    color: var(--color-gm-red);
  }

  /* Same explicit height:0/auto pair as BuiltFor — see that component for
     why this can't be left to a CSS-only grid-rows trick or to the browser's
     own closed-<details> hiding. */
  [data-seo-faq] [data-faq-panel] {
    overflow: hidden;
    height: 0;
    transition: height 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  [data-seo-faq] details[open] > [data-faq-panel] {
    height: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-seo-faq] [data-faq-panel],
    [data-seo-faq] [data-faq-chevron] {
      transition: none;
    }
  }

  /* Explainer ledger — a one-shot fade-up stagger on scroll-in, same
     technique as BuiltFor's row reveal: not a scroll-scrub, since these five
     rows are parallel facts rather than a sequence with real order/hierarchy
     between them. */
  [data-seo-faq].is-armed [data-explainer-row] {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.5s ease,
      transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  [data-seo-faq].is-armed.explainer-in [data-explainer-row] {
    opacity: 1;
    transform: none;
  }
  [data-seo-faq].is-armed.explainer-in [data-explainer-row]:nth-of-type(1) {
    transition-delay: 0s;
  }
  [data-seo-faq].is-armed.explainer-in [data-explainer-row]:nth-of-type(2) {
    transition-delay: 0.06s;
  }
  [data-seo-faq].is-armed.explainer-in [data-explainer-row]:nth-of-type(3) {
    transition-delay: 0.12s;
  }
  [data-seo-faq].is-armed.explainer-in [data-explainer-row]:nth-of-type(4) {
    transition-delay: 0.18s;
  }
  [data-seo-faq].is-armed.explainer-in [data-explainer-row]:nth-of-type(5) {
    transition-delay: 0.24s;
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-seo-faq]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && !reduce) {
    section.classList.add('is-armed');
    const explainer = section.querySelector<HTMLElement>('[data-explainer]');
    if (explainer) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              section.classList.add('explainer-in');
              io.disconnect();
            }
          });
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      io.observe(explainer);
    }
  }

  if (section && !reduce) {
    /* Independent accordion — several answers can stay open at once, unlike
       BuiltFor's exclusive one-row rule. No native `name` grouping here in
       the first place, so there's no exclusivity to fight. */
    const rows = Array.from(section.querySelectorAll<HTMLDetailsElement>('[data-faq-row]'));

    const closePanel = (details: HTMLDetailsElement) => {
      const panel = details.querySelector<HTMLElement>('[data-faq-panel]');
      if (!panel) return;
      panel.style.height = panel.scrollHeight + 'px';
      panel.getBoundingClientRect();
      requestAnimationFrame(() => {
        panel.style.height = '0px';
      });
      const onEnd = (e: TransitionEvent) => {
        if (e.propertyName !== 'height') return;
        panel.removeEventListener('transitionend', onEnd);
        details.removeAttribute('open');
        panel.style.height = '';
      };
      panel.addEventListener('transitionend', onEnd);
    };

    const openPanel = (details: HTMLDetailsElement) => {
      details.setAttribute('open', '');
      const panel = details.querySelector<HTMLElement>('[data-faq-panel]');
      if (!panel) return;
      const target = panel.scrollHeight;
      panel.style.height = '0px';
      panel.getBoundingClientRect();
      requestAnimationFrame(() => {
        panel.style.height = target + 'px';
      });
      const onEnd = (e: TransitionEvent) => {
        if (e.propertyName !== 'height') return;
        panel.removeEventListener('transitionend', onEnd);
        panel.style.height = '';
      };
      panel.addEventListener('transitionend', onEnd);
    };

    rows.forEach((details) => {
      const summary = details.querySelector('summary');
      summary?.addEventListener('click', (e) => {
        e.preventDefault();
        if (details.open) closePanel(details);
        else openPanel(details);
      });
    });
  }
</script>
