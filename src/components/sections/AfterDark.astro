---
import { AFTER_DARK_IMAGES } from '@data/products';
import RevealFrame from '@components/ui/RevealFrame.astro';

/**
 * Section — the sightline argument, after dark.
 *
 * The rest of the panels page *asserts* that you can see through a 358
 * perimeter: the medallions say "CCTV Optimised", the copy says "keeps
 * sightlines open for cameras, lighting and security patrols". None of it
 * shows you. These three renders do, and they do it in the hardest possible
 * condition — night, on a home, where a solid wall is what most people
 * picture. Every frame is composed so the lit garden, the driveway and the
 * house read *through* the mesh.
 *
 * The frames and their hover behaviour live in ui/RevealFrame.astro, shared
 * with /projects/clear-fencing. What stays here is what is specific to this
 * argument: which three images, and what each one is claiming.
 *
 * Layout is deliberately not a three-up grid (governing rule #1): the lead
 * render runs full width because it is the one composition where the fence
 * crosses the whole frame, and the other two sit under it as a pair.
 */

const [lead, ...rest] = AFTER_DARK_IMAGES;

/** The claim each frame is carrying. Written per image, against what is
    actually visible in it — not three rewordings of one caption. */
const NOTES: Record<string, { kicker: string; title: string; body: string }> = {
  'clear-view-residential-boundary-after-dark': {
    kicker: '01 · Driveway',
    title: 'Lit, And Still Watched',
    body: 'The car, the door and the whole approach stay in view from inside the boundary. A solid wall at this height would hand an intruder the one thing they want — somewhere to work unseen.',
  },
  'clear-view-residential-sightline-through-mesh-dusk': {
    kicker: '02 · Sightline',
    title: 'The Mesh Disappears',
    body: 'Read along the line and the 76 × 12.7 mm aperture stops being a screen. Planting, uplighting and the house behind come through it — the aperture is too narrow to climb and too fine to hide behind.',
  },
  'clear-view-residential-frontage-dusk': {
    kicker: '03 · Frontage',
    title: 'Security Without The Fortress',
    body: 'The full frontage, unobstructed. The perimeter is continuous and anti-climb across every metre of it, and the house is still the thing you see.',
  },
};

const noteFor = (id: string) => NOTES[id] ?? {};
---

{
  lead && (
    <section class="bg-gm-black text-gm-white py-20 sm:py-28">
      <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
        <div class="max-w-2xl">
          <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">After Dark</p>
          <h2 class="font-display text-gm-white mt-5 text-3xl leading-[1.02] font-black tracking-tight uppercase sm:text-4xl lg:text-5xl">
            The Perimeter You <span class="text-gm-red">Can See Past.</span>
          </h2>
          <p class="text-gm-grey-400 mt-6 text-base leading-relaxed">
            Night is when a boundary either works or gets in the way. Every frame here is a home
            behind 358 mesh — the planting lit, the approach visible, the fence doing its job
            without taking the view away.
          </p>
        </div>

        {/* Lead frame — full width, and the only one cropped, and only from
            1024px up: at twice the width of the pair below it a native
            1.75:1 would run 750 px tall on a desktop, where 21:9 keeps it a
            band. On a phone it stays native — the frame is already narrow
            there, so cropping it would only throw the composition away.
            The desktop crop was checked against the render before shipping:
            it takes sky and foreground and leaves the fence line, the house
            and the lighting intact. */}
        <RevealFrame
          image={lead}
          {...noteFor(lead.id)}
          sizes="(min-width: 1400px) 1336px, 100vw"
          ratioLg="21 / 9"
          class="mt-12 sm:mt-16"
        />

        <div class="mt-6 grid gap-6 lg:grid-cols-2">
          {rest.map((image) => (
            <RevealFrame
              image={image}
              {...noteFor(image.id)}
              sizes="(min-width: 1024px) 660px, 100vw"
            />
          ))}
        </div>

        <p class="text-gm-grey-500 mt-8 max-w-2xl text-[11px] leading-relaxed">
          Renders, not photographs — shown to demonstrate sightlines at night. Panel aperture,
          height and finish are specified from the tables above.
        </p>
      </div>
    </section>
  )
}
