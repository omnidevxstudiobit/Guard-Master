---
import { CTA } from '@data/nav';

/**
 * Daylight hero — a pinned headline swap, with the subhead and CTAs
 * always on screen.
 *
 *   Panel 1  Keyword H1, centred over the clouds.
 *   Panel 2  The hook line, swapped in over panel 1.
 *   Tail     Subhead + both CTAs — static, never hidden, never part of the swap.
 *
 * The swap is *triggered*, not scrubbed: the moment the user scrolls, panel 1
 * leaves and panel 2 arrives at their own pace. Tying it to scroll progress
 * made the two crawl past each other, which read as sluggish.
 *
 * Earlier version scoped the swap to the whole lower half of the hero —
 * hook line, subhead *and* both CTAs all lived inside panel 2, hidden
 * (opacity 0, translated off-screen) until the visitor scrolled. That meant
 * a visitor who loaded the page and never scrolled saw the primary "Request
 * a Quote" CTA disappear the instant JS finished enhancing — first paint
 * (static HTML/CSS, JS off) showed it; the JS-enhanced resting state hid it.
 * Real bug, not a design choice: the CTA must not require a scroll gesture
 * to become visible. The swap is now scoped to just the two headline
 * variants (H1 ⇄ hook line) — comparable in size, so overlaying them to
 * slide one out/one in doesn't collide — while the subhead and CTAs sit
 * outside the swap entirely, always rendered, identical before and after JS.
 *
 * Clouds sit behind the type (z-0) and are the only scroll-scrubbed layer,
 * along with the image parallax — those genuinely should track the scroll.
 *
 * Clouds are SVG ellipse clusters run through blur → fractal-noise
 * displacement. A plain blur alone renders white blobs; displacing the already
 * blurred shape with turbulence is what gives a feathered edge.
 *
 * Two constraints hold throughout:
 *
 * 1. First paint is static HTML + CSS and readable with JS off — both
 *    headline panels simply stack and flow, subhead and CTAs sit below.
 *    GSAP adds `.headline-stack--js` to overlay just the two headline
 *    panels, so a visitor without JS gets the plain hero rather than a
 *    hidden one, and a visitor with JS gets the same content, just with
 *    the headline able to swap.
 * 2. Nothing animates before LCP; only transform/opacity/filter are animated
 *    (animationguide.md §3). The subhead/CTA entrance is CSS-only for the
 *    same reason animationguide.md's own kicker row is CSS-only — it must
 *    render whether or not JS ever loads.
 *
 * Deviation from the brief: §4.1 specifies a dark hero. The daylight treatment
 * is the client's choice, so designguide.md §4's light/dark order shifts with it.
 */

const CLOUDS = [
  { cls: 'cloud--a', drift: 'left' },
  { cls: 'cloud--b', drift: 'right' },
  { cls: 'cloud--c', drift: 'left' },
  { cls: 'cloud--d', drift: 'right' },
  { cls: 'cloud--e', drift: 'up' },
  { cls: 'cloud--f', drift: 'right' },
];

const P1_LEAD = ['The', 'Industry', 'Standard', 'in'];
const P1_MAIN = ['Clear', 'View', 'Security', 'Fencing.'];
const P2_LEAD = ['See', 'Through', 'It.'];
const P2_MAIN = ['Never', 'Get', 'Through', 'It.'];
---

<section data-hero class="relative isolate min-h-svh overflow-hidden">
  <div class="hero-sky absolute inset-0 -z-30" aria-hidden="true"></div>
  <div class="hero-sun absolute -z-30" aria-hidden="true"></div>

  <!-- LCP element (brief §4.1). The sky shows through the mesh apertures. -->
  <img
    data-hero-image
    src="/hero-fence.svg"
    alt="Clear view 358 anti-climb mesh fencing panels with galvanized posts against a daylight sky"
    fetchpriority="high"
    decoding="async"
    width="1600"
    height="900"
    class="absolute inset-x-0 bottom-0 -z-20 h-[74%] w-full object-cover object-bottom"
  />

  {
    /* Legibility scrim. The mesh runs dense vertical lines straight through the
      copy, and small text over that pattern is hard to read no matter what the
      contrast ratio says. This lifts a soft white veil over the middle and
      lower bands where the copy and trust strip sit, while leaving the top of
      the sky and the fence itself clearly visible. */
  }
  <div class="hero-scrim absolute inset-0 -z-10" aria-hidden="true"></div>

  <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
    <defs>
      <filter
        id="gm-cloud"
        x="-35%"
        y="-45%"
        width="170%"
        height="190%"
        color-interpolation-filters="sRGB"
      >
        <feGaussianBlur in="SourceGraphic" stdDeviation="7" result="soft"></feGaussianBlur>
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.019"
          numOctaves="4"
          seed="8"
          result="noise"></feTurbulence>
        <feDisplacementMap
          in="soft"
          in2="noise"
          scale="78"
          xChannelSelector="R"
          yChannelSelector="G"></feDisplacementMap>
      </filter>
    </defs>
  </svg>

  <!-- Clouds sit *behind* the type -->
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    {
      CLOUDS.map((c) => (
        <svg
          class={`cloud ${c.cls}`}
          data-cloud
          data-drift={c.drift}
          viewBox="0 0 320 170"
          fill="#fff"
        >
          <g filter="url(#gm-cloud)">
            <ellipse cx="96" cy="112" rx="66" ry="34" />
            <ellipse cx="158" cy="84" rx="56" ry="44" />
            <ellipse cx="218" cy="108" rx="60" ry="33" />
            <ellipse cx="160" cy="126" rx="112" ry="27" />
          </g>
        </svg>
      ))
    }
  </div>

  <!-- The stage always stacks: swappable headline, then the static subhead
       and CTAs below it. Only the inner headline-stack ever becomes a
       GSAP-driven overlay — the tail never hides, JS or not. -->
  <div class="stage absolute inset-0 z-10 flex flex-col items-center px-6" data-stage>
    <!-- Both headline panels live in this stack. Without JS they simply
         stack and read normally, one above the other; GSAP adds
         `headline-stack--js`, which overlays them in a single grid cell so
         panel 1 can slide out as panel 2 slides in. -->
    <div class="headline-stack" data-headline-stack>
      <div class="panel" data-panel-1>
        <h1 class="headline">
          <span class="headline__lead">
            {
              P1_LEAD.map((w, i) => (
                <>
                  <span class="w">
                    <span class="w__i" data-w1>
                      {w}
                    </span>
                  </span>
                  {i < P1_LEAD.length - 1 ? ' ' : ''}
                </>
              ))
            }
          </span>{
            /* real space so the two block lines do not concatenate into
          "…Standard inClear View…" in textContent, which is what a crawler and a
          screen reader read. It is a block boundary, so it costs nothing visually. */
          }
          {' '}
          <span class="headline__main">
            {
              P1_MAIN.map((w, i) => (
                <>
                  <span class="w">
                    <span class="w__i" data-w1>
                      {w}
                    </span>
                  </span>
                  {i < P1_MAIN.length - 1 ? ' ' : ''}
                </>
              ))
            }
          </span>
        </h1>
      </div>

      <div class="panel" data-panel-2>
        <p class="headline">
          <span class="headline__lead">
            {
              P2_LEAD.map((w, i) => (
                <>
                  <span class="w">
                    <span class="w__i" data-w2>
                      {w}
                    </span>
                  </span>
                  {i < P2_LEAD.length - 1 ? ' ' : ''}
                </>
              ))
            }
          </span>{
            /* real space so the two block lines do not concatenate into
          "…Standard inClear View…" in textContent, which is what a crawler and a
          screen reader read. It is a block boundary, so it costs nothing visually. */
          }
          {' '}
          <span class="headline__main">
            {
              P2_MAIN.map((w, i) => (
                <>
                  <span class="w">
                    <span class="w__i" data-w2>
                      {w}
                    </span>
                  </span>
                  {i < P2_MAIN.length - 1 ? ' ' : ''}
                </>
              ))
            }
          </span>
        </p>
      </div>
    </div>

    <!-- Subhead + both CTAs — static content, identical whether JS ever
         runs or not. Never part of the panel swap, never hidden behind a
         scroll gesture; the reveal below is a one-shot CSS entrance only. -->
    <p
      class="on-photo text-gm-grey-800 mx-auto mt-7 max-w-xl text-[15px] leading-relaxed font-medium sm:text-base"
      data-hero-tail
    >
      {/* Placeholder copy — the real subhead is a content-writer deliverable. */}
      Manufacturer-direct 358 anti-climb mesh panels, posts and fixings, engineered for commercial,
      industrial, utility and government perimeters.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3" data-hero-tail>
      <a
        href={CTA.href}
        class="tap-target bg-gm-red text-gm-white inline-flex items-center px-7 text-[12px] font-bold tracking-[0.12em] uppercase transition-colors hover:bg-[#c50e24]"
      >
        Request a Quote
      </a>
      <a
        href="/clear-view-fencing-panels"
        class="tap-target border-gm-black/25 text-gm-black hover:border-gm-black hover:bg-gm-black hover:text-gm-white inline-flex items-center border px-7 text-[12px] font-bold tracking-[0.12em] uppercase transition-colors"
      >
        Build Your Fence
      </a>
    </div>
  </div>

  <ul
    class="on-photo text-gm-black absolute inset-x-0 bottom-8 z-20 mx-auto flex w-full max-w-[1400px] flex-wrap justify-center gap-x-8 gap-y-2 px-6 text-[12px] font-bold tracking-[0.16em] uppercase"
  >
    <li>ISO Certified</li>
    <li>10-Year Warranty</li>
    <li>In-House Manufacturing</li>
    <li>Global Shipping</li>
  </ul>
</section>

<style>
  .hero-sky {
    background: linear-gradient(to bottom, #6db2e8 0%, #9ccdf0 38%, #cfe6f6 68%, #eef4f7 100%);
  }

  .hero-sun {
    top: -12%;
    right: 8%;
    width: min(42vw, 560px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgb(255 250 230 / 0.9) 0%,
      rgb(255 244 205 / 0.5) 42%,
      transparent 70%
    );
  }

  .hero-scrim {
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgb(255 255 255 / 0.42) 24%,
      rgb(255 255 255 / 0.72) 48%,
      rgb(255 255 255 / 0.64) 76%,
      rgb(255 255 255 / 0.8) 100%
    );
  }

  /* Small text sitting over the mesh. The problem is not contrast — it measures
     11:1 — it is that the panels put dense vertical lines directly behind the
     glyphs, and no amount of dimming the whole image fixes that without
     erasing the image. A white halo clears the pattern in the few pixels
     around each letter instead, so the type separates and the fence survives. */
  .on-photo {
    text-shadow:
      0 0 8px rgb(255 255 255 / 0.98),
      0 0 18px rgb(255 255 255 / 0.92),
      0 0 34px rgb(255 255 255 / 0.75);
  }

  .cloud {
    position: absolute;
    width: clamp(150px, 22vw, 340px);
    height: auto;
    opacity: 0.94;
  }

  .cloud--a {
    top: 14%;
    left: 4%;
  }
  .cloud--b {
    top: 8%;
    right: 10%;
    width: clamp(180px, 26vw, 400px);
  }
  .cloud--c {
    top: 62%;
    left: 20%;
    opacity: 0.78;
  }
  .cloud--d {
    top: 22%;
    right: 28%;
    width: clamp(130px, 18vw, 280px);
    opacity: 0.85;
  }
  .cloud--e {
    top: 70%;
    right: 8%;
    width: clamp(120px, 16vw, 250px);
    opacity: 0.72;
  }
  .cloud--f {
    top: 6%;
    left: 34%;
    width: clamp(140px, 20vw, 300px);
    opacity: 0.7;
  }

  /* display/flex-direction/align-items live as Tailwind classes on the
     element itself — .stage never switches layout mode (only the nested
     .headline-stack does), so there's nothing conditional left to keep here. */
  .stage {
    justify-content: center;
    text-align: center;
  }

  /* Baseline: the two headline panels flow one after another and both read
     fine with JS off. */
  .headline-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    width: 100%;
  }

  /* GSAP swaps this in and the panels share one grid cell, so panel 1 can
     slide out as panel 2 slides in. Scoped to just the headline — the
     subhead and CTAs below are siblings of .headline-stack, not inside it,
     so they're never part of this overlay and never get hidden by it. */
  .headline-stack--js {
    display: grid;
    place-items: center;
    gap: 0;
  }

  .headline-stack--js .panel {
    grid-area: 1 / 1;
  }

  .panel {
    width: 100%;
    max-width: 1180px;
  }

  /* Typography: a two-weight composition rather than one uniform block —
     a wide-tracked lead line over a tight, oversized main line. */
  .headline {
    display: block;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .headline__lead {
    display: block;
    font-size: clamp(0.85rem, 1.5vw, 1.35rem);
    font-weight: 500;
    letter-spacing: 0.34em;
    color: var(--color-gm-grey-700);
    margin-bottom: 0.55em;
  }

  .headline__main {
    display: block;
    font-size: clamp(2.1rem, 6.4vw, 5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    /* The tight tracking above also squeezes the space character, so the words
       ran together visually. word-spacing opens the gaps back up without
       loosening the letterforms. */
    word-spacing: 0.16em;
    line-height: 0.92;
    color: var(--color-gm-black);
  }

  [data-panel-2] .headline__main {
    color: var(--color-gm-red);
  }

  /* Word mask. The separating space is a real text node *between* the clipped
     spans, not inside one and not a margin: a space inside `.w` is cut off by
     the overflow (that produced "SEETHROUGHIT.NEVER"), while a margin spaces
     the words visually but leaves textContent as one run-together string —
     which is what a crawler and a screen reader actually read. */
  .w {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
  }

  .w__i {
    display: inline-block;
    will-change: transform;
  }

  /* Subhead + CTAs get one CSS-only entrance beat on load — never JS-gated
     and never tied to scroll, so it plays identically whether or not JS
     ever runs. animationguide.md calls for the kicker's own entrance to be
     CSS-only for the same reason; this extends that same treatment to the
     content sitting below it, so it arrives instead of just popping in,
     without ever depending on GSAP to be visible at all. */
  [data-hero-tail] {
    animation: hero-tail-in 0.7s 0.4s both cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @keyframes hero-tail-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .w__i {
      transform: none !important;
    }

    [data-hero-tail] {
      animation: none;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  const enhance = async () => {
    if (!hero) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const [{ gsap }, { ScrollTrigger }] = await Promise.all([
      import('gsap'),
      import('gsap/ScrollTrigger'),
    ]);
    gsap.registerPlugin(ScrollTrigger);

    const headlineStack = hero.querySelector<HTMLElement>('[data-headline-stack]');
    const panel2 = hero.querySelector<HTMLElement>('[data-panel-2]');
    const image = hero.querySelector('[data-hero-image]');
    const clouds = gsap.utils.toArray<HTMLElement>('[data-cloud]');

    /* Overlay just the two headline panels now, so the no-JS rendering keeps
       everything stacked and legible. The subhead and CTAs below are never
       touched here — they're outside headline-stack entirely, so there's
       nothing to hide and nothing that needs re-revealing later. */
    headlineStack?.classList.add('headline-stack--js');
    gsap.set('[data-w2]', { yPercent: 115 });
    gsap.set(panel2, { pointerEvents: 'none' });
    gsap.set(image, { scale: 1.1, yPercent: -4 });

    /* The swap plays at its own speed the moment the user scrolls — it is not
       scrubbed, so panel 1 leaves and panel 2 arrives crisply instead of the
       two inching past each other. */
    const swap = gsap
      .timeline({ paused: true, defaults: { ease: 'power3.inOut' } })
      .to('[data-w1]', { yPercent: -115, duration: 0.42, stagger: 0.035 }, 0)
      .to('[data-w2]', { yPercent: 0, duration: 0.5, stagger: 0.04 }, 0.24)
      .set(panel2, { pointerEvents: 'auto' });

    /* One ScrollTrigger drives everything. Three separate triggers sharing the
       same range did not work: the pinned one inserts a spacer, which moves the
       element the other two measure against, and none of them updated. This
       single trigger pins, scrubs the layers that should track the scroll, and
       fires the swap through onUpdate. */
    const scrubbed = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: {
        trigger: hero,
        start: 'top top',
        /* Resolved to pixels: pinning grows the document and a percentage end
           is measured against that, so the two feed each other and it drifts. */
        end: () => '+=' + Math.round(window.innerHeight * 1.1),
        pin: true,
        scrub: 0.4,
        anticipatePin: 1,
        invalidateOnRefresh: true,
        onUpdate: (self) => {
          if (self.progress > 0.04) swap.play();
          else swap.reverse();
        },
      },
    });

    clouds.forEach((cloud, i) => {
      const drift = cloud.dataset.drift;
      const to =
        drift === 'left'
          ? { xPercent: -150, yPercent: -14 }
          : drift === 'right'
            ? { xPercent: 150, yPercent: -10 }
            : { yPercent: -200 };

      scrubbed.to(cloud, { ...to, opacity: 0, duration: 1 }, i * 0.02);
    });

    scrubbed.to(image, { scale: 1, yPercent: 6, duration: 1 }, 0);
  };

  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => void enhance(), { timeout: 2000 });
  } else {
    setTimeout(() => void enhance(), 300);
  }
</script>
