---
/**
 * The full Clear View specification, as one labelled engineering drawing.
 *
 * Replaces the "Three Apertures. One Panel." configurator that used to sit in
 * this slot. That section could only ever show one aperture at a time and
 * needed a click to show the other two; a spec drawing shows the whole product
 * at once, which is what someone specifying a perimeter actually wants — and
 * the three apertures are still here, drawn side by side at their true
 * relative pitch, where they can be *compared* instead of toggled between.
 *
 * Built in the same language as the post cutaway in SystemAssembly.astro:
 * geometry in SVG, labels as absolutely positioned HTML. That split matters —
 * SVG `<text>` scales with the artwork, so on a narrow screen the labels stop
 * being legible well before the drawing stops being useful. HTML labels hold
 * their size and the drawing shrinks around them.
 *
 * **One source of truth for the callouts.** `CALLOUTS` drives the leader lines,
 * the desktop labels *and* the mobile list. The desktop drawing is hidden below
 * `lg` for the same reason the post cutaway is — ten labels and their leaders
 * crowd into each other long before that — so the same specification is
 * rendered as a plain list there rather than being dropped. Editing a spec in
 * one place changes both.
 *
 * Every number is already established elsewhere in this codebase and traceable
 * to the client's own spec sheet and reference diagram: the 358 aperture and
 * its tolerance, wire diameter and tensile range, the 80% weld strength, the
 * four finishes, the 3 000 mm panel width and post centres, and the six named
 * post features. Nothing here was invented to fill a leader line — a callout
 * with no verified fact behind it simply isn't drawn.
 *
 * **Geometry is drawn to the real ratio.** Horizontal wires sit at a 12-unit
 * pitch against 72-unit verticals: exactly 6:1, which is 76.2 ÷ 12.7. The
 * highlighted aperture is a real cell of that grid, and the welded-node callout
 * points at a real intersection of a drawn horizontal and a drawn vertical.
 *
 * Motion is the site's usual static-first arrangement: default CSS renders the
 * finished drawing, the script adds `is-armed` (which is what *hides* it) and
 * `is-in` on scroll. No JS and reduced motion both get the complete drawing.
 */

/* ---------- geometry ---------- */
const POST = { x: 300, w: 30, capX: 292, capW: 46, capY: 112, capH: 28, top: 140 };
const PANEL = { x0: 330, x1: 762, y0: 170, y1: 554, hPitch: 12, vPitch: 72 };
const GROUND = 566;
const DIM_Y = 604;

const rows = Array.from(
  { length: (PANEL.y1 - PANEL.y0) / PANEL.hPitch + 1 },
  (_, i) => PANEL.y0 + i * PANEL.hPitch,
);
const cols = Array.from(
  { length: (PANEL.x1 - PANEL.x0) / PANEL.vPitch + 1 },
  (_, i) => PANEL.x0 + i * PANEL.vPitch,
);
/** Mesh securing teeth down the post's panel-side edge. */
const teeth = [200, 262, 324, 386, 448, 510];
/** One real cell of the grid above, called out in the accent. */
const CELL = { x: 618, y: 278, w: PANEL.vPitch, h: PANEL.hPitch };
/** A real intersection of a drawn vertical and a drawn horizontal. */
const NODE = { x: 690, y: 350 };
const hatch = Array.from({ length: 25 }, (_, i) => 80 + i * 40);

/* ---------- callouts ----------
   `ax` is where the leader touches the drawing; `y` is the height it runs at.
   Left leaders end at x = 252, right leaders at x = 836. */
type Callout = {
  side: 'left' | 'right';
  ax: number;
  y: number;
  title: string;
  note?: string;
};

const CALLOUTS: Callout[] = [
  { side: 'left', ax: 292, y: 126, title: 'Solar Cap', note: 'Front & back lights' },
  { side: 'left', ax: 288, y: 206, title: 'Anti-Tamper Protection Lip' },
  { side: 'left', ax: 342, y: 262, title: 'Mesh Securing Teeth' },
  { side: 'left', ax: 303, y: 336, title: 'Clamp Securing Slots' },
  { side: 'left', ax: 315, y: 412, title: 'Reinforcing Rib', note: 'Fold-over design' },
  { side: 'left', ax: 288, y: 486, title: 'Anti-Push System Lip' },
  { side: 'right', ax: 690, y: 284, title: '358 Aperture', note: '76.2 × 12.7 mm ± 1.0 mm' },
  {
    side: 'right',
    ax: 690,
    y: 350,
    title: 'Welded Every Intersection',
    note: '80% of parent material',
  },
  /* The manufacturer's own dimensioned drawing labels these directly —
     "ø3mm horizontal wires, ø4mm vertical wires" — and their estimator sells
     the panel in exactly two wire sizes, Ø3 × Ø4 and Ø4 × Ø4. An earlier pass
     carried "Ø 3.5 – 5.6 mm" off a general spec sheet, which is the range for
     the wider product family, not what this panel is actually made from. */
  { side: 'right', ax: 700, y: 422, title: 'Wire', note: 'Ø 3 mm horiz. · Ø 4 mm vert.' },
  {
    side: 'right',
    ax: 762,
    y: 494,
    title: 'Four Finishes',
    note: 'Plain galv → HDG → powder → Plascoat',
  },
];

const LEADER_LEFT = 252;
const LEADER_RIGHT = 836;
const VB = { w: 1120, h: 700 };
const pct = (v: number, of: number): string => `${((v / of) * 100).toFixed(3)}%`;

/* ---------- the three apertures, drawn side by side ----------
   Each detail is drawn at its own true aspect ratio: 76 ÷ 12.7 = 6.0,
   76 ÷ 25 = 3.04, 76 ÷ 50 = 1.52. Sharing one grid and just resizing a
   highlight would imply the three options come off one weld tooling with wires
   skipped, which is a manufacturing claim this build has never confirmed. */
const D = { w: 200, h: 120, vPitch: 60, x0: 10, y0: 8 };
const detailCols = [10, 70, 130, 190];

const APERTURES = [
  {
    size: '76 × 12.7 mm',
    label: '358 Standard',
    ratio: 76 / 12.7,
    note: 'A fingertip, toe-hold or bolt-cutter jaw doesn’t fit.',
  },
  {
    size: '76 × 25 mm',
    label: 'Wide Sightline',
    ratio: 76 / 25,
    note: 'Wider sightline where the tightest aperture isn’t the deciding factor.',
  },
  {
    size: '76 × 50 mm',
    label: 'Open Weave',
    ratio: 76 / 50,
    note: 'The most open weave in the range, for lower-risk perimeters.',
  },
].map((a) => {
  const pitch = D.vPitch / a.ratio;
  const detailRows: number[] = [];
  for (let y = D.y0; y <= D.h - 6; y += pitch) detailRows.push(Math.round(y * 100) / 100);
  /* Highlight the first full cell below the detail's mid-height, so the red
     cell lands at roughly the same place in all three and they read as a row. */
  const k = Math.max(
    0,
    detailRows.findIndex((r) => r >= 40),
  );
  return { ...a, detailRows, cell: { y: detailRows[k], h: detailRows[k + 1] - detailRows[k] } };
});
---

<section class="bg-gm-grey-50 text-gm-black py-20 sm:py-28">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-gm-red font-mono text-xs tracking-[0.34em] uppercase">Engineering Drawing</p>
      <h2
        class="font-display text-gm-black mt-5 text-3xl leading-[1.02] font-black tracking-tight uppercase sm:text-4xl lg:text-5xl"
      >
        The Whole Panel, <span class="text-gm-red">Drawn To Spec.</span>
      </h2>
      <p class="text-gm-grey-600 mt-6 text-base leading-relaxed">
        Post, panel, aperture and finish on one sheet — every feature named and every dimension the
        one we manufacture to, not a stylised impression of a fence.
      </p>
    </div>

    <!-- Desktop: the drawing. Hidden below lg — ten labels and their leader
         lines crowd into each other long before that width, exactly as the
         post cutaway in SystemAssembly does. The list below carries the same
         specification for narrow screens. -->
    <div data-spec-drawing class="psd mt-14 hidden lg:mt-16 lg:block">
      <div class="relative mx-auto aspect-[1120/700] w-full max-w-[1120px]">
        <svg
          viewBox="0 0 1120 700"
          class="h-full w-full"
          role="img"
          aria-label="Engineering drawing of a Clear View 358 mesh panel fixed to a Guard Master post, with the solar cap, anti-tamper lip, mesh securing teeth, clamp securing slots, reinforcing rib and anti-push lip labelled on the post, and the aperture, welded intersections, wire gauge and finish options labelled on the panel."
        >
          <!-- ground -->
          <line
            class="psd-draw psd-faint"
            pathLength="100"
            style="--d:0s"
            x1="60"
            y1={GROUND}
            x2="1060"
            y2={GROUND}></line>
          {
            hatch.map((x, i) => (
              <path
                class="psd-draw psd-faint"
                pathLength="100"
                style={`--d:${(0.02 + i * 0.008).toFixed(3)}s`}
                d={`M${x} ${GROUND} L${x - 12} ${GROUND + 12}`}
              />
            ))
          }

          <!-- panel: mesh at a true 6:1 -->
          <g class="psd-mesh">
            {
              rows.map((y, i) => (
                <line
                  class="psd-draw psd-wire"
                  pathLength="100"
                  style={`--d:${(0.34 + i * 0.009).toFixed(3)}s`}
                  x1={PANEL.x0}
                  y1={y}
                  x2={PANEL.x1}
                  y2={y}
                />
              ))
            }
            {
              cols.map((x, i) => (
                <line
                  class="psd-draw psd-mid"
                  pathLength="100"
                  style={`--d:${(0.4 + i * 0.04).toFixed(3)}s`}
                  x1={x}
                  y1={PANEL.y0}
                  x2={x}
                  y2={PANEL.y1}
                />
              ))
            }
            <rect
              class="psd-draw psd-edge"
              pathLength="100"
              style="--d:0.3s"
              x={PANEL.x0}
              y={PANEL.y0}
              width={PANEL.x1 - PANEL.x0}
              height={PANEL.y1 - PANEL.y0}></rect>
          </g>

          <!-- post: drawn over the panel, because it is what the panel is fixed to -->
          <g class="psd-pop" style="--d:0.06s">
            <rect
              class="psd-solid"
              x={POST.capX}
              y={POST.capY}
              width={POST.capW}
              height={POST.capH}
              rx="3"></rect>
            <circle class="psd-led" cx="306" cy="126" r="3"></circle>
            <circle class="psd-led" cx="324" cy="126" r="3"></circle>
            <rect
              class="psd-solid"
              x={POST.x}
              y={POST.top}
              width={POST.w}
              height={GROUND - POST.top}></rect>
            <line class="psd-mid" x1="315" y1="152" x2="315" y2="556"></line>
            <line class="psd-wire" x1="308" y1="152" x2="308" y2="556"></line>
            <path class="psd-heavy" d="M300 198 H288 V214 H300"></path>
            <path class="psd-heavy" d="M300 478 H288 V494 H300"></path>
            <rect class="psd-mid" x="303" y="332" width="18" height="9" rx="1"></rect>
            {
              teeth.map((y) => (
                <path class="psd-tooth" d={`M330 ${y - 7} L344 ${y} L330 ${y + 7} Z`} />
              ))
            }
          </g>

          <!-- the one aperture called out, and one welded node -->
          <rect
            class="psd-draw psd-accent"
            pathLength="100"
            style="--d:0.86s"
            x={CELL.x}
            y={CELL.y}
            width={CELL.w}
            height={CELL.h}></rect>
          <circle class="psd-node" cx={NODE.x} cy={NODE.y} r="5"></circle>

          <!-- leader lines -->
          {
            CALLOUTS.map((c, i) => (
              <path
                class="psd-leader"
                style={`--d:${(0.95 + i * 0.05).toFixed(2)}s`}
                d={`M${c.ax} ${c.y} H${c.side === 'left' ? LEADER_LEFT : LEADER_RIGHT}`}
              />
            ))
          }

          <!-- panel width dimension -->
          <g class="psd-dim" style="--d:1.5s">
            <path
              class="psd-faint"
              d={`M${PANEL.x0} ${GROUND} V${DIM_Y + 14} M${PANEL.x1} ${GROUND} V${DIM_Y + 14}`}
            ></path>
            <path class="psd-mid" d={`M${PANEL.x0} ${DIM_Y} H${PANEL.x1}`}></path>
            <path
              class="psd-mid"
              d={`M${PANEL.x0 + 9} ${DIM_Y - 5} L${PANEL.x0} ${DIM_Y} L${PANEL.x0 + 9} ${DIM_Y + 5}
                  M${PANEL.x1 - 9} ${DIM_Y - 5} L${PANEL.x1} ${DIM_Y} L${PANEL.x1 - 9} ${DIM_Y + 5}`}
            ></path>
          </g>
        </svg>

        {
          CALLOUTS.map((c, i) => (
            <p
              class:list={[
                'psd-label',
                c.side === 'left' ? 'psd-label--left' : 'psd-label--right',
                'text-gm-grey-600 absolute max-w-[13rem] font-mono text-[10px] leading-tight tracking-[0.08em] uppercase',
              ]}
              style={[
                `top:${pct(c.y, VB.h)}`,
                c.side === 'left'
                  ? `right:${pct(VB.w - (LEADER_LEFT - 8), VB.w)}; text-align:right`
                  : `left:${pct(LEADER_RIGHT + 8, VB.w)}; text-align:left`,
                `--d:${(1.15 + i * 0.05).toFixed(2)}s`,
              ].join('; ')}
              aria-hidden="true"
            >
              <span class="text-gm-black font-bold">{c.title}</span>
              {c.note && <span class="text-gm-grey-500 mt-0.5 block normal-case">{c.note}</span>}
            </p>
          ))
        }

        <p
          class="psd-label text-gm-grey-600 absolute font-mono text-[10px] tracking-[0.12em] whitespace-nowrap uppercase"
          style={`top:${pct(DIM_Y + 30, VB.h)}; left:${pct((PANEL.x0 + PANEL.x1) / 2, VB.w)}; --d:1.6s`}
          aria-hidden="true"
        >
          <span class="text-gm-black font-bold">3 000 mm panel width</span>
        </p>
      </div>
    </div>

    <!-- Same specification, for widths the drawing can't hold. -->
    <dl
      class="border-gm-grey-200 mt-12 grid gap-x-10 gap-y-0 border-t sm:grid-cols-2 lg:hidden"
      aria-label="Clear View panel and post specification"
    >
      {
        CALLOUTS.map((c) => (
          <div class="border-gm-grey-200 border-b py-3.5">
            <dt class="text-gm-black font-mono text-[11px] font-bold tracking-[0.1em] uppercase">
              {c.title}
            </dt>
            <dd class="text-gm-grey-600 mt-1 text-[13px] leading-snug">{c.note ?? 'Standard'}</dd>
          </div>
        ))
      }
      <div class="border-gm-grey-200 border-b py-3.5">
        <dt class="text-gm-black font-mono text-[11px] font-bold tracking-[0.1em] uppercase">
          Panel Size
        </dt>
        <dd class="text-gm-grey-600 mt-1 text-[13px] leading-snug">
          3 000 mm wide × 1 800 – 3 000 mm high
        </dd>
      </div>
    </dl>

    <!-- Detail views: the three apertures, drawn at their own true pitch. -->
    <div class="mt-16 sm:mt-20">
      <p class="text-gm-grey-500 font-mono text-[11px] tracking-[0.2em] uppercase">
        Detail · Three Apertures, One Panel
      </p>
      <div class="mt-6 grid gap-6 sm:grid-cols-3 sm:gap-8">
        {
          APERTURES.map((a, i) => (
            <figure data-spec-drawing class="psd border-gm-grey-200 border bg-white p-5">
              <div class="aspect-[200/120] w-full">
                <svg viewBox="0 0 200 120" class="h-full w-full" aria-hidden="true">
                  {a.detailRows.map((y, r) => (
                    <line
                      class="psd-draw psd-wire"
                      pathLength="100"
                      style={`--d:${(0.06 + i * 0.1 + r * 0.02).toFixed(3)}s`}
                      x1="4"
                      y1={y}
                      x2="196"
                      y2={y}
                    />
                  ))}
                  {detailCols.map((x, c) => (
                    <line
                      class="psd-draw psd-mid"
                      pathLength="100"
                      style={`--d:${(0.12 + i * 0.1 + c * 0.05).toFixed(3)}s`}
                      x1={x}
                      y1="2"
                      x2={x}
                      y2="118"
                    />
                  ))}
                  <rect
                    class="psd-draw psd-accent"
                    pathLength="100"
                    style={`--d:${(0.42 + i * 0.1).toFixed(2)}s`}
                    x="70"
                    y={a.cell.y}
                    width="60"
                    height={a.cell.h}
                  />
                </svg>
              </div>
              <figcaption class="mt-5">
                <p class="text-gm-black font-mono text-sm font-bold">{a.size}</p>
                <p class="text-gm-red mt-1 font-mono text-[10px] tracking-[0.2em] uppercase">
                  {a.label}
                </p>
                <p class="text-gm-grey-600 mt-2.5 text-[13px] leading-relaxed">{a.note}</p>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>

    <p class="text-gm-grey-500 mt-10 font-mono text-[11px] leading-relaxed tracking-[0.08em]">
      Panels 3 000 mm wide (3 013 mm overall across the posts) × 1 800 / 2 100 / 2 400 / 3 000 mm
      high · posts 2 400 / 2 700 / 3 000 / 3 600 mm to suit · wire Ø 3 mm × Ø 4 mm or Ø 4 mm × Ø 4
      mm · welded 80% of parent material, 500 – 650 MPa · aperture tolerance ± 1.0 mm.
    </p>
  </div>
</section>

<style>
  /* Stroke defaults per class, not as a blanket `.psd rect { fill: none }` —
     any CSS rule outranks an SVG presentation attribute, so a blanket reset
     erases intentional fills (and, in `<defs>`, breaks masks outright). */
  .psd .psd-faint,
  .psd .psd-wire,
  .psd .psd-mid,
  .psd .psd-heavy,
  .psd .psd-edge,
  .psd .psd-leader {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .psd .psd-faint {
    stroke: #d8d8d8;
    stroke-width: 1;
  }
  .psd .psd-wire {
    stroke: #c2c2c2;
    stroke-width: 1;
  }
  .psd .psd-mid {
    stroke: #8a8a8a;
    stroke-width: 1.4;
  }
  .psd .psd-heavy {
    stroke: #161616;
    stroke-width: 1.8;
  }
  .psd .psd-edge {
    stroke: #161616;
    stroke-width: 2;
  }
  .psd .psd-leader {
    stroke: #c9c9c9;
    stroke-width: 1;
  }
  .psd .psd-accent {
    fill: rgba(228, 17, 42, 0.12);
    stroke: #e4112a;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .psd .psd-node,
  .psd .psd-led {
    fill: #e4112a;
    stroke: none;
  }
  .psd .psd-tooth {
    fill: #161616;
    stroke: none;
  }
  /* The post is a solid object standing in front of the panel it carries. */
  .psd .psd-solid {
    fill: #ffffff;
    stroke: #161616;
    stroke-width: 2;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  /* --- motion ---
     Default is the finished drawing; `is-armed` is what hides it. */
  .psd .psd-draw {
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
  }
  .psd.is-armed .psd-draw {
    stroke-dashoffset: 100;
  }
  .psd.is-armed.is-in .psd-draw {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.8s ease-out;
    transition-delay: var(--d, 0s);
  }

  .psd.is-armed .psd-pop,
  .psd.is-armed .psd-dim {
    opacity: 0;
  }
  .psd.is-armed .psd-pop {
    transform: translateY(-14px);
  }
  .psd.is-armed.is-in .psd-pop,
  .psd.is-armed.is-in .psd-dim {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.5s ease-out,
      transform 0.6s cubic-bezier(0.2, 0.8, 0.3, 1);
    transition-delay: var(--d, 0s);
  }

  /* Leaders extend out of the drawing toward their label. */
  .psd .psd-leader {
    stroke-dasharray: 400;
    stroke-dashoffset: 0;
  }
  .psd.is-armed .psd-leader {
    stroke-dashoffset: 400;
  }
  .psd.is-armed.is-in .psd-leader {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.55s ease-out;
    transition-delay: var(--d, 0s);
  }

  /* The -50% lives in CSS, not the inline style: an inline `transform` would
     outrank the rules below and the labels could never animate. */
  .psd .psd-label {
    transform: translateY(-50%);
  }
  .psd .psd-label:not(.psd-label--left):not(.psd-label--right) {
    transform: translate(-50%, -50%);
  }
  .psd.is-armed .psd-label {
    opacity: 0;
  }
  .psd.is-armed .psd-label--left {
    transform: translateY(-50%) translateX(-14px);
  }
  .psd.is-armed .psd-label--right {
    transform: translateY(-50%) translateX(14px);
  }
  .psd.is-armed.is-in .psd-label {
    opacity: 1;
    transition:
      opacity 0.4s ease-out,
      transform 0.5s cubic-bezier(0.2, 0.8, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .psd.is-armed.is-in .psd-label--left,
  .psd.is-armed.is-in .psd-label--right {
    transform: translateY(-50%);
  }

  .psd.is-armed.is-in .psd-node {
    animation: psd-pulse 2.8s ease-in-out 1.8s infinite;
  }
  @keyframes psd-pulse {
    0%,
    100% {
      opacity: 1;
      r: 5;
    }
    50% {
      opacity: 0.45;
      r: 8;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .psd .psd-node {
      animation: none;
    }
  }
</style>

<script>
  const drawings = Array.from(document.querySelectorAll<HTMLElement>('[data-spec-drawing]'));

  if (drawings.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    drawings.forEach((drawing) => drawing.classList.add('is-armed'));

    /* Flush the armed state before anything can add `is-in`, or a drawing
       already on screen gets both classes in one frame and skips the draw. */
    void document.documentElement.offsetHeight;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.2 },
    );

    drawings.forEach((drawing) => observer.observe(drawing));
  }
</script>
