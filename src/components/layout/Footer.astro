---
import Logo from '@components/ui/Logo.astro';
import { NAV_LINKS, CTA } from '@data/nav';

/**
 * The "fat footer" — seoguide.md §6: "Top nav = six product/content items +
 * red 'Get a Quote'; everything else lives in the footer — deliberately for
 * internal link equity." This is that everything-else: the same six nav
 * items again as real crawlable links, plus the on-page anchors (who we
 * protect, instant estimate, FAQ) and two legal placeholders.
 *
 * Phone, email and address are all real, and all come from the client's own
 * reference site (fencing-supplier.com). This footer used to lead with
 * +1 (954) 756-5216 / export@fencing-supplier.com — that site's
 * "International / Export Sales" line — and deliberately withheld the street
 * address, on the reasoning that a US-market site shouldn't present a South
 * African factory as "the" address. That reasoning is retired: the site is
 * now built for the business as it actually trades, a Benoni manufacturer
 * quoting in rand, so the general SA line and the factory address lead, and
 * the +1 number stays on as what it always was — the export line. Social
 * links are still omitted; no real profiles were found, and inventing one
 * reads as fact the moment a search engine indexes it.
 *
 * Lives in BaseLayout.astro (rendered on every page), not per-page — same
 * reasoning as the nav.
 */

const year = new Date().getFullYear();

/* The four product destinations. Reads off NAV_LINKS — the flattened nav —
   rather than NAV_ITEMS, which is now the *grouped* bar (Products, Gallery,
   Projects, Warranties) and whose first four entries are no longer products
   at all. Flattening keeps this column in step with the nav automatically. */
const productLinks = NAV_LINKS.slice(0, 4);
const companyLinks = [
  { label: 'Gallery', href: '/gallery' },
  { label: 'Warranties', href: '/warranties-and-guarantees' },
  { label: 'Projects', href: '/projects' },
  { label: 'Who We Protect', href: '/#built-for' },
];
/* '/#instant-estimate' and '/#faq' used to live here. Both anchors are gone
   from the homepage — EstimatorTeaser and SeoFaq moved off it, to be remounted
   per-product — so these now point at targets that actually exist: the full
   estimator page, and the homepage's own contact section. */
const getStartedLinks = [
  { label: 'Get a Quote', href: CTA.href },
  { label: 'Instant Estimate', href: '/clear-fencing-estimator' },
  { label: 'Contact Us', href: '/#contact' },
];
const legalLinks = [
  { label: 'Privacy Policy', href: '/privacy-policy' },
  { label: 'Terms of Service', href: '/terms-of-service' },
];

const TRUST = [
  'ISO Certified',
  '10-Year Warranty',
  'In-House Manufacturing',
  'Nationwide & Export Delivery',
];
---

<footer class="bg-gm-black text-gm-grey-300 border-t border-white/10">
  <div class="mx-auto max-w-[1400px] px-6 py-16 lg:px-8 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_1fr_1fr_1fr_1fr]">
      <div class="max-w-xs">
        <a href="/" class="text-gm-white inline-flex" aria-label="Guard Master — home">
          <Logo variant="sub" class="h-8 w-auto" />
        </a>
        <p class="text-gm-grey-400 mt-4 text-sm leading-relaxed">
          Manufacturer-direct clear view 358 anti-climb security fencing, razor wire and rapid
          deployment barriers — made in Benoni, Gauteng.
        </p>
        <address class="text-gm-grey-400 mt-4 text-sm leading-relaxed not-italic">
          10 Burnley Street<br />
          Benoni South Extn.<br />
          Gauteng 1501, South Africa
        </address>
        <div class="mt-5 space-y-1.5">
          <a
            href="tel:+27114378903"
            class="tap-target text-gm-grey-300 hover:text-gm-white flex items-center text-sm transition-colors"
          >
            +27 11 437 8903
          </a>
          <a
            href="mailto:info@fencing-supplier.com"
            class="tap-target text-gm-grey-300 hover:text-gm-white flex items-center text-sm transition-colors"
          >
            info@fencing-supplier.com
          </a>
          <a
            href="tel:+19547565216"
            class="tap-target text-gm-grey-500 hover:text-gm-white flex items-center text-sm transition-colors"
          >
            +1 (954) 756-5216 <span class="ml-2 text-xs">· International / Export</span>
          </a>
        </div>
      </div>

      <nav aria-label="Products">
        <p class="text-gm-grey-500 font-mono text-[11px] tracking-[0.18em] uppercase">Products</p>
        <ul class="mt-4 space-y-3">
          {
            productLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="tap-target text-gm-grey-300 hover:text-gm-white inline-flex items-center text-sm transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Company">
        <p class="text-gm-grey-500 font-mono text-[11px] tracking-[0.18em] uppercase">Company</p>
        <ul class="mt-4 space-y-3">
          {
            companyLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="tap-target text-gm-grey-300 hover:text-gm-white inline-flex items-center text-sm transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Get started">
        <p class="text-gm-grey-500 font-mono text-[11px] tracking-[0.18em] uppercase">
          Get Started
        </p>
        <ul class="mt-4 space-y-3">
          {
            getStartedLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="tap-target text-gm-grey-300 hover:text-gm-white inline-flex items-center text-sm transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Legal">
        <p class="text-gm-grey-500 font-mono text-[11px] tracking-[0.18em] uppercase">Legal</p>
        <ul class="mt-4 space-y-3">
          {
            legalLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="tap-target text-gm-grey-300 hover:text-gm-white inline-flex items-center text-sm transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <ul class="mt-14 flex flex-wrap gap-x-8 gap-y-3 border-t border-white/10 pt-8">
      {
        TRUST.map((t) => (
          <li class="text-gm-grey-400 flex items-center gap-2 text-xs">
            <span class="text-gm-red" aria-hidden="true">
              ✓
            </span>
            {t}
          </li>
        ))
      }
    </ul>

    <div
      class="text-gm-grey-500 mt-8 flex flex-col gap-2 border-t border-white/10 pt-8 text-xs sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} Guard Master. All rights reserved.</p>
      <p>Wire Ventures CC t/a Guard Master Fencing Solutions</p>
    </div>
  </div>
</footer>
