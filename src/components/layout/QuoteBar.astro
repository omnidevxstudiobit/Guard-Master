---
/**
 * The floating basket indicator.
 *
 * Every calculator on the site writes into one basket (src/lib/quote-cart.ts),
 * and that basket lives across three product pages — so it needs a fixed
 * anchor, not a control inside whichever section you happen to be reading.
 *
 * Hidden until there is something in it. An empty basket badge is noise on
 * every page of a site most visitors will never add anything on, and it can't
 * be rendered server-side anyway: the basket is in localStorage, so the true
 * state isn't known until the client says so. Rendering it hidden and revealing
 * it on the first `gm:cart` event is both correct and avoids a count flashing
 * from 0.
 *
 * With no JS it never appears, which is right — with no JS nothing can be added
 * to it either.
 */
---

<a
  data-quote-bar
  href="/quote"
  class="quote-bar bg-gm-red text-gm-white font-display fixed right-5 bottom-5 z-50 hidden items-center gap-3 px-5 py-3 text-[12px] font-bold tracking-[0.1em] uppercase shadow-lg transition-colors hover:bg-[#c50e24]"
>
  <span>View Quote</span>
  <span
    data-quote-count
    class="bg-gm-white text-gm-red inline-flex min-w-6 items-center justify-center rounded-full px-2 py-0.5 font-mono text-[11px] tabular-nums"
    >0</span
  >
</a>

<style>
  .quote-bar {
    /* Above the fold on mobile it would sit on the CTA row; keep it clear of
       the very bottom edge where browser chrome lives. */
    padding-bottom: max(0.75rem, env(safe-area-inset-bottom));
  }
  [data-quote-bar].is-shown {
    display: inline-flex;
  }
</style>

<script>
  import { read, count, onChange } from '@/lib/quote-cart';

  const bar = document.querySelector<HTMLElement>('[data-quote-bar]');
  const badge = document.querySelector<HTMLElement>('[data-quote-count]');

  if (bar && badge) {
    const paint = () => {
      const n = count(read());
      badge.textContent = String(n);
      bar.classList.toggle('is-shown', n > 0);
      bar.setAttribute('aria-label', `View quote — ${n} item${n === 1 ? '' : 's'}`);
    };
    onChange(paint);
    paint();
  }
</script>
