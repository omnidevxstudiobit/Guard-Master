---
import type { NavItem } from '@data/nav';

/**
 * One desktop nav item — a plain link, or a link that also opens a flyout.
 *
 * **It is a link first.** The trigger is an `<a href>`, not a button: with JS
 * off, on a browser that never fires hover, or for a crawler, "Products" still
 * goes to the panels page. The menu is an enhancement layered on top, exactly
 * the way animationguide.md §1 asks for.
 *
 * **Opened by CSS, not script.** `:hover` and `:focus-within` on the wrapper
 * both open it, which means a keyboard user tabbing into the group gets the
 * same menu a mouse user gets — no JS, no aria-expanded to keep in sync with a
 * state variable, nothing to go stale. The cost of that is `aria-expanded`
 * can't be truthful, so it isn't claimed at all; the panel is an ordinary
 * `<ul>` of links, which is what a screen reader will read out anyway.
 *
 * **The bridge matters.** The panel sits below the bar with a gap, and a gap
 * is a place for the pointer to leave the group and close the menu mid-travel.
 * `.flyout::before` covers that gap so the diagonal from trigger to first item
 * never passes over dead space.
 *
 * Motion is `transform`/`opacity` only, and skipped entirely under
 * `prefers-reduced-motion` — the panel still opens, it just arrives.
 */
interface Props {
  item: NavItem;
}
const { item } = Astro.props;
---

{
  item.children ? (
    <div class="group/nav nav-group relative">
      <a
        href={item.href}
        data-nav-item
        class="group text-gm-grey-200 hover:text-gm-white relative flex items-center gap-1.5 text-[13px] font-semibold tracking-[0.14em] uppercase transition-colors"
      >
        {item.label}
        <svg
          class="chev h-2.5 w-2.5 opacity-60"
          viewBox="0 0 10 6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <path d="M1 1l4 4 4-4" />
        </svg>
        <span class="bg-gm-red absolute -bottom-1.5 left-0 h-px w-full origin-left scale-x-0 transition-transform duration-300 group-hover:scale-x-100" />
      </a>

      {/* Left-aligned to its trigger, not centred on it. Centring put the
          panel's midpoint over "Products" — which sits at the far left of the
          bar — and pushed its first column, the Clear View group, off the
          left edge of the window entirely. */}
      <div class="flyout absolute top-full left-0 z-50 pt-4">
        {/* Solid, not translucent. At 95% + blur the white breadcrumb bar
            underneath still read through the panel and the menu labels sat on
            top of ghosted page text. A menu is chrome — it should occlude. */}
        <div class="border-gm-grey-800 bg-gm-black flex gap-8 border p-6 shadow-2xl">
          {item.children.map((group) => (
            <div class="min-w-[11rem]">
              <p class="text-gm-red font-mono text-[10px] font-bold tracking-[0.22em] uppercase">
                {group.label}
              </p>
              <ul class="mt-3 space-y-1">
                {group.items.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class="tap-target text-gm-grey-300 hover:text-gm-white flex items-center text-[13px] font-semibold tracking-[0.06em] whitespace-nowrap uppercase transition-colors"
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  ) : (
    <a
      href={item.href}
      data-nav-item
      class="group text-gm-grey-200 hover:text-gm-white relative text-[13px] font-semibold tracking-[0.14em] uppercase transition-colors"
    >
      {item.label}
      <span class="bg-gm-red absolute -bottom-1.5 left-0 h-px w-full origin-left scale-x-0 transition-transform duration-300 group-hover:scale-x-100" />
    </a>
  )
}

<style>
  .flyout {
    /* Closed by default. `visibility` is what keeps it out of the tab order
       while closed — opacity alone would leave every link in it focusable
       behind an invisible panel. Never wider than the window, so a group
       added later can't push a column off-screen. */
    max-width: calc(100vw - 2rem);
    transform: translate3d(0, -0.4rem, 0);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.22s ease,
      transform 0.28s cubic-bezier(0.16, 0.84, 0.24, 1),
      visibility 0s linear 0.28s;
  }

  /* The pointer has to cross the `pt-4` gap between trigger and panel. This
     covers it, so the menu doesn't close halfway down the diagonal. */
  .flyout::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1.25rem;
  }

  .nav-group:hover .flyout,
  .nav-group:focus-within .flyout {
    opacity: 1;
    visibility: visible;
    transform: translate3d(0, 0, 0);
    transition-delay: 0s;
  }

  .chev {
    transition: transform 0.28s cubic-bezier(0.16, 0.84, 0.24, 1);
  }
  .nav-group:hover .chev,
  .nav-group:focus-within .chev {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .flyout,
    .chev {
      transition: none;
    }
  }
</style>
