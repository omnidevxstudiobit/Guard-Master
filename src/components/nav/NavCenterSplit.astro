---
import Logo from '@components/ui/Logo.astro';
import { NAV_ITEMS, NAV_LINKS, CTA } from '@data/nav';
import NavLink from '@components/nav/NavLink.astro';

/**
 * Variant A — centre logo, nav split left/right.
 *
 * Renders as plain server HTML and stays usable with JS off: real <a> links,
 * and the mobile overlay opens from a checkbox + label rather than script.
 * GSAP is never on the critical path — it is imported on idle and only layers
 * decoration on top (animationguide.md §2–§4).
 *
 * Structure note: the overlay panel is a SIBLING of <header>. The bar takes
 * `backdrop-filter` once scrolled, and that establishes a containing block for
 * fixed-position descendants — a panel nested inside it stops resolving
 * against the viewport and collapses to the bar's box.
 *
 * `assumeDarkBg`: the unscrolled palette below (`--nav-fg`/`--nav-fg-strong`
 * defaulting to dark greys/black) exists specifically for the homepage,
 * where the bar starts transparent over Hero's light daylight sky and needs
 * dark type to read. `<main>`'s own background on every other page is
 * `--color-gm-black` (BaseLayout.astro's `pt-16`/`lg:pt-20` header-clearance
 * padding sits directly on the black `<body>`), so that same "unscrolled"
 * dark-on-transparent state renders the logo wordmark at a 1:1 (invisible)
 * contrast ratio and nav links at 2.5:1 — both fail against a black backdrop
 * that was never accounted for. BaseLayout passes `assumeDarkBg={true}` for
 * every page except the homepage, which renders `data-scrolled` on the bar
 * from first paint (no flash while JS loads) and skips the scroll listener
 * that would otherwise toggle it off near the top of the page.
 */
interface Props {
  assumeDarkBg?: boolean;
}
const { assumeDarkBg = false } = Astro.props;

/* Two a side. The split was 3/3 when there were six flat items; with four it
   balances either side of the centre logo instead of stacking three against
   one. */
const left = NAV_ITEMS.slice(0, 2);
const right = NAV_ITEMS.slice(2);
---

<input id="nav-toggle" type="checkbox" class="peer sr-only" aria-label="Toggle menu" />

<header data-nav class="fixed inset-x-0 top-0 z-50">
  {
    /* Translucent blur only appears once scrolled — brief §4.1. Driven by a data
      attribute so the transition is pure CSS and costs nothing on first paint. */
  }
  <div
    class="data-[scrolled]:bg-gm-black/70 border-b border-transparent transition-[background-color,backdrop-filter,border-color] duration-300 data-[scrolled]:border-white/10 data-[scrolled]:backdrop-blur-xl"
    data-nav-bar
    data-scrolled={assumeDarkBg ? '' : undefined}
    data-force-dark={assumeDarkBg ? '' : undefined}
  >
    <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
      <div class="grid h-16 grid-cols-[1fr_auto_1fr] items-center gap-4 lg:h-20">
        <!-- LEFT — desktop links / mobile menu trigger -->
        <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
          {left.map((item) => <NavLink item={item} />)}
        </nav>

        <label
          for="nav-toggle"
          class="tap-target text-gm-white flex cursor-pointer items-center justify-start lg:hidden"
        >
          <span class="sr-only">Open menu</span>
          <span class="flex flex-col gap-[5px]" aria-hidden="true">
            <span class="block h-0.5 w-6 bg-current"></span>
            <span class="block h-0.5 w-6 bg-current"></span>
            <span class="block h-0.5 w-4 bg-current"></span>
          </span>
        </label>

        <!-- CENTRE — Sub Main Logo on desktop, Icon mark on mobile (brief §2, §4.8) -->
        <a
          href="/"
          class="text-gm-white justify-self-center"
          data-nav-logo
          aria-label="Guard Master — home"
        >
          <Logo variant="sub" class="hidden h-8 w-auto lg:block" />
          <Logo variant="icon" class="h-9 w-9 lg:hidden" />
        </a>

        <!-- RIGHT — desktop links + CTA. On mobile the brief keeps the bar to
             just the icon logo, so the CTA lives inside the overlay. -->
        <div class="flex items-center justify-end gap-7">
          <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
            {right.map((item) => <NavLink item={item} />)}
          </nav>
          <a
            href={CTA.href}
            data-nav-item
            data-nav-cta
            class="tap-target bg-gm-red text-gm-white hidden items-center px-5 text-[12px] font-bold tracking-[0.12em] uppercase transition-colors hover:bg-[#c50e24] lg:inline-flex"
          >
            {CTA.label}
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Full-screen overlay (brief §4.8), sibling of <header> so `fixed` resolves
     against the viewport even once the bar is blurred. -->
<div
  data-menu-panel
  class="bg-gm-black fixed inset-0 z-40 hidden flex-col px-6 pt-24 pb-10 peer-checked:flex lg:!hidden"
>
  <label
    for="nav-toggle"
    class="tap-target text-gm-white absolute top-4 right-5 flex cursor-pointer items-center justify-center"
  >
    <span class="sr-only">Close menu</span>
    <svg
      viewBox="0 0 24 24"
      class="h-6 w-6"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path d="M5 5l14 14M19 5L5 19"></path>
    </svg>
  </label>

  <nav class="flex flex-col" aria-label="Mobile">
    {
      NAV_LINKS.map((item) => (
        <a
          href={item.href}
          data-menu-link
          class="tap-target font-display text-gm-white flex items-center border-b border-white/10 py-4 text-2xl font-bold tracking-tight uppercase"
        >
          {item.label}
        </a>
      ))
    }
  </nav>
  <a
    href={CTA.href}
    data-menu-link
    class="tap-target bg-gm-red text-gm-white mt-8 flex items-center justify-center px-6 text-sm font-bold tracking-[0.12em] uppercase"
  >
    {CTA.label}
  </a>
</div>

<style>
  /* The hero is a daylight scene, so the un-scrolled bar sits over a light sky
     and needs dark type. Once the dark translucent bar fades in on scroll the
     type flips back to light. The red CTA keeps its own colours throughout. */
  /* The palette flips on the bar itself and the children just inherit it, so
     each element is coloured by exactly one rule. Swapping colours per element
     instead needs a second, more specific rule per element, and those did not
     reliably win here — one variable avoids the contest entirely. */
  [data-nav-bar] {
    --nav-fg: var(--color-gm-grey-600);
    --nav-fg-strong: var(--color-gm-black);
  }

  [data-nav-bar][data-scrolled] {
    --nav-fg: var(--color-gm-grey-200);
    --nav-fg-strong: var(--color-gm-white);
  }

  [data-nav-bar] [data-nav-item]:not([data-nav-cta]) {
    color: var(--nav-fg);
  }

  [data-nav-bar] [data-nav-item]:not([data-nav-cta]):hover,
  [data-nav-bar] [data-nav-logo],
  [data-nav-bar] label[for='nav-toggle'] {
    color: var(--nav-fg-strong);
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-nav-bar]');
  const toggle = document.querySelector<HTMLInputElement>('#nav-toggle');

  // `data-force-dark` pages (every page but the homepage — see this
  // component's own doc comment) render `data-scrolled` from SSR and stay
  // that way regardless of scroll position; there's no light hero for the
  // "unscrolled" palette to accommodate, so nothing here should ever remove
  // it.
  if (bar && !bar.hasAttribute('data-force-dark')) {
    /* Scroll state is functional, not decorative, so it runs without GSAP —
       one passive listener flipping a single attribute; CSS does the rest. */
    const onScroll = () => {
      if (window.scrollY > 8) bar.setAttribute('data-scrolled', '');
      else bar.removeAttribute('data-scrolled');
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  /* Opening/closing is pure CSS; JS only stops the page scrolling behind the
     open overlay. */
  toggle?.addEventListener('change', () => {
    document.body.style.overflow = toggle.checked ? 'hidden' : '';
  });

  /* Decorative motion only, loaded after idle so GSAP never touches LCP/FCP —
     animationguide.md §0 rule 3 and §2. */
  const enhance = async () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const { gsap } = await import('gsap');

    gsap.from('[data-nav-item], [data-nav-logo]', {
      y: -10,
      opacity: 0,
      duration: 0.5,
      ease: 'power2.out',
      stagger: 0.04,
    });

    toggle?.addEventListener('change', () => {
      if (!toggle.checked) return;
      gsap.from('[data-menu-link]', {
        y: 18,
        opacity: 0,
        duration: 0.4,
        ease: 'power2.out',
        stagger: 0.05,
      });
    });
  };

  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => void enhance(), { timeout: 2000 });
  } else {
    setTimeout(() => void enhance(), 200);
  }
</script>
