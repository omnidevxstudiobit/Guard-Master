---
/**
 * The order tracker — five stages, drawn and animated.
 *
 * **The timeline is a simulation, and the component says so on screen.** There
 * is no backend behind this build: nothing is watching a warehouse, so nothing
 * can know that a quote has been packed. Each stage advances on a three-second
 * timer because that is what was asked for, and the badge above the track reads
 * "Preview" and the note below it says the stages are a demonstration until the
 * ordering system is connected. A tracker that silently reports "Delivered"
 * fifteen seconds after an enquiry is not a stylistic choice, it is a lie told
 * to a customer, and the two lines of copy are what keep this the former.
 *
 * Every icon is drawn in the same line language as the rest of the site rather
 * than pulled from an icon set — a clipboard, a handset, a calendar, a carton, a
 * truck — and the completion mark is a small run of fence, which is the one
 * icon that could only belong to this company.
 *
 * Motion, in order: the connector fills from the completed node toward the next,
 * the arriving node's ring draws, its icon strokes in, then a tick draws over it
 * once the stage is behind us. The active node pulses while it waits. On
 * completion the fence draws itself and the panel arrives.
 *
 * `prefers-reduced-motion` is honoured by skipping straight to the finished
 * state — every stage complete, no timers, no pulse — because the information
 * here is the state, not the animation.
 */

interface Props {
  /** Seconds each stage holds before the next begins. */
  step?: number;
}

const { step = 3 } = Astro.props;

const STAGES = [
  {
    id: 'received',
    label: 'Received',
    note: 'Your quote is with our sales desk.',
  },
  {
    id: 'contacted',
    label: 'Contacted',
    note: 'We’ve spoken to you and confirmed the spec.',
  },
  {
    id: 'arranging',
    label: 'Arranging',
    note: 'Stock allocated and production slotted.',
  },
  {
    id: 'packing',
    label: 'Packing',
    note: 'Panels, posts and fixings bundled for dispatch.',
  },
  {
    id: 'delivered',
    label: 'Delivered',
    note: 'On site and signed for.',
  },
];
---

<div data-tracker data-step={step} class="qt">
  <div class="qt-head">
    <p class="qt-eyebrow">Order Progress</p>
    <span class="qt-badge">Preview</span>
  </div>

  <ol class="qt-track" role="list">
    {
      STAGES.map((stage, i) => (
        <li data-stage={stage.id} data-index={i} class="qt-stage">
          {i > 0 && (
            <span class="qt-link" aria-hidden="true">
              <span class="qt-link-fill" />
            </span>
          )}

          <span class="qt-node" aria-hidden="true">
            <svg viewBox="0 0 48 48" class="qt-ring">
              <circle class="qt-ring-track" cx="24" cy="24" r="21" />
              <circle class="qt-ring-draw" pathLength="100" cx="24" cy="24" r="21" />
            </svg>

            <svg viewBox="0 0 48 48" class="qt-icon">
              {stage.id === 'received' && (
                <g>
                  <rect
                    class="qt-draw"
                    pathLength="100"
                    x="15"
                    y="12"
                    width="18"
                    height="24"
                    rx="2"
                  />
                  <path class="qt-draw" pathLength="100" d="M20 10 H28 V15 H20 Z" />
                  <path class="qt-draw" pathLength="100" d="M19 22 H29 M19 27 H29 M19 32 H25" />
                </g>
              )}
              {stage.id === 'contacted' && (
                <g>
                  <path
                    class="qt-draw"
                    pathLength="100"
                    d="M17 13 C15 13, 13 15, 13 18 C13 27, 21 35, 30 35 C33 35, 35 33, 35 31 L30 28 L27 31 C24 29, 19 24, 17 21 L20 18 Z"
                  />
                </g>
              )}
              {stage.id === 'arranging' && (
                <g>
                  <rect
                    class="qt-draw"
                    pathLength="100"
                    x="12"
                    y="15"
                    width="24"
                    height="21"
                    rx="2"
                  />
                  <path class="qt-draw" pathLength="100" d="M12 22 H36 M18 12 V18 M30 12 V18" />
                  <path class="qt-draw" pathLength="100" d="M19 28 H23 M27 28 H31" />
                </g>
              )}
              {stage.id === 'packing' && (
                <g>
                  <path
                    class="qt-draw"
                    pathLength="100"
                    d="M12 18 L24 12 L36 18 V32 L24 38 L12 32 Z"
                  />
                  <path class="qt-draw" pathLength="100" d="M12 18 L24 24 L36 18 M24 24 V38" />
                </g>
              )}
              {stage.id === 'delivered' && (
                <g>
                  <path class="qt-draw" pathLength="100" d="M11 16 H26 V30 H11 Z" />
                  <path class="qt-draw" pathLength="100" d="M26 21 H32 L37 26 V30 H26 Z" />
                  <circle class="qt-draw" pathLength="100" cx="17" cy="33" r="3" />
                  <circle class="qt-draw" pathLength="100" cx="32" cy="33" r="3" />
                </g>
              )}
            </svg>

            <svg viewBox="0 0 48 48" class="qt-tick">
              <path class="qt-tick-draw" pathLength="100" d="M15 24 L21 30 L33 18" />
            </svg>
          </span>

          <span class="qt-label">{stage.label}</span>
          <span class="qt-note">{stage.note}</span>
        </li>
      ))
    }
  </ol>

  <div data-tracker-done class="qt-done" hidden>
    {/* The one icon that could only be this company. */}
    <svg viewBox="0 0 120 64" class="qt-fence" aria-hidden="true">
      <line class="qt-fd" pathLength="100" x1="4" y1="56" x2="116" y2="56"></line>
      <rect class="qt-fd qt-fd--post" pathLength="100" x="14" y="14" width="7" height="42"></rect>
      <rect class="qt-fd qt-fd--post" pathLength="100" x="99" y="14" width="7" height="42"></rect>
      {
        Array.from({ length: 11 }, (_, i) => 21 + i * 7.8).map((x) => (
          <line class="qt-fd qt-fd--wire" pathLength="100" x1={x} y1="20" x2={x} y2="56" />
        ))
      }
      {
        [20, 29, 38, 47, 56].map((y) => (
          <line class="qt-fd qt-fd--wire" pathLength="100" x1="21" y1={y} x2="99" y2={y} />
        ))
      }
      <rect class="qt-fd qt-fd--cap" pathLength="100" x="11" y="9" width="13" height="5"></rect>
      <rect class="qt-fd qt-fd--cap" pathLength="100" x="96" y="9" width="13" height="5"></rect>
    </svg>
    <p class="qt-done-title">Order Received</p>
    <p class="qt-done-note">
      Your perimeter is on its way. We’ll confirm the delivery window by phone.
    </p>
  </div>

  <p class="qt-disclaimer">
    These stages are a demonstration of how your order will be tracked. Until our ordering system is
    connected, the timeline advances on its own and does not reflect the real state of your quote —
    a member of our team will contact you directly.
  </p>
</div>

<style>
  .qt {
    --qt-line: rgb(255 255 255 / 0.14);
    --qt-done: var(--color-gm-red);
  }

  .qt-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .qt-eyebrow {
    color: var(--color-gm-red);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 10px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }
  .qt-badge {
    padding: 0.15rem 0.5rem;
    border: 1px solid rgb(255 255 255 / 0.25);
    color: var(--color-gm-grey-400);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .qt-track {
    display: grid;
    gap: 2rem;
    margin-top: 2.25rem;
  }
  @media (min-width: 900px) {
    .qt-track {
      grid-template-columns: repeat(5, 1fr);
      gap: 0;
    }
  }

  .qt-stage {
    position: relative;
    display: grid;
    grid-template-columns: 56px 1fr;
    grid-template-rows: auto auto;
    column-gap: 1rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .qt-stage {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
      justify-items: center;
      text-align: center;
      padding: 0 0.5rem;
    }
  }

  /* The connector. Vertical on mobile (it runs back up to the node above),
     horizontal from 900px. */
  .qt-link {
    position: absolute;
    background: var(--qt-line);
  }
  .qt-link-fill {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--qt-done);
    transform-origin: top;
    transform: scaleY(0);
    transition: transform 0.6s cubic-bezier(0.3, 0.7, 0.3, 1);
  }
  .qt-stage {
    /* Mobile: the link sits above the node. */
  }
  .qt-link {
    top: -2rem;
    left: 27px;
    width: 2px;
    height: 2rem;
  }
  @media (min-width: 900px) {
    .qt-link {
      top: 27px;
      left: calc(-50% + 28px);
      width: calc(100% - 56px);
      height: 2px;
    }
    .qt-link-fill {
      transform-origin: left;
      transform: scaleX(0);
    }
  }
  .qt-stage.is-linked .qt-link-fill {
    transform: scaleY(1);
  }
  @media (min-width: 900px) {
    .qt-stage.is-linked .qt-link-fill {
      transform: scaleX(1);
    }
  }

  .qt-node {
    position: relative;
    grid-row: 1 / 3;
    width: 56px;
    height: 56px;
  }
  @media (min-width: 900px) {
    .qt-node {
      grid-row: auto;
    }
  }
  .qt-node svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .qt-ring-track {
    fill: #0e0e11;
    stroke: var(--qt-line);
    stroke-width: 2;
  }
  .qt-ring-draw {
    fill: none;
    stroke: var(--qt-done);
    stroke-width: 2;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transform: rotate(-90deg);
    transform-origin: center;
    transition: stroke-dashoffset 0.7s ease-out;
  }
  .qt-stage.is-active .qt-ring-draw,
  .qt-stage.is-done .qt-ring-draw {
    stroke-dashoffset: 0;
  }

  .qt-icon .qt-draw {
    fill: none;
    stroke: var(--color-gm-grey-500);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transition:
      stroke-dashoffset 0.6s ease-out,
      stroke 0.3s ease;
  }
  .qt-stage.is-active .qt-icon .qt-draw,
  .qt-stage.is-done .qt-icon .qt-draw {
    stroke-dashoffset: 0;
  }
  .qt-stage.is-active .qt-icon .qt-draw {
    stroke: var(--color-gm-white);
  }
  .qt-icon {
    transition: opacity 0.35s ease;
  }
  .qt-stage.is-done .qt-icon {
    opacity: 0;
  }

  .qt-tick {
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .qt-tick-draw {
    fill: none;
    stroke: var(--qt-done);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 0.45s ease-out 0.1s;
  }
  .qt-stage.is-done .qt-tick {
    opacity: 1;
  }
  .qt-stage.is-done .qt-tick-draw {
    stroke-dashoffset: 0;
  }

  /* The stage we're waiting on keeps a heartbeat. */
  .qt-stage.is-active .qt-node::after {
    content: '';
    position: absolute;
    inset: -4px;
    border: 2px solid var(--qt-done);
    border-radius: 50%;
    opacity: 0;
    animation: qt-pulse 1.8s ease-out infinite;
  }
  @keyframes qt-pulse {
    0% {
      opacity: 0.7;
      transform: scale(0.9);
    }
    100% {
      opacity: 0;
      transform: scale(1.25);
    }
  }

  .qt-label {
    color: var(--color-gm-grey-500);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }
  @media (min-width: 900px) {
    .qt-label {
      margin-top: 1rem;
    }
  }
  .qt-stage.is-active .qt-label,
  .qt-stage.is-done .qt-label {
    color: var(--color-gm-white);
  }

  .qt-note {
    color: var(--color-gm-grey-600);
    font-size: 12px;
    line-height: 1.5;
    max-width: 22ch;
    transition:
      color 0.3s ease,
      opacity 0.3s ease;
    opacity: 0.55;
  }
  .qt-stage.is-active .qt-note,
  .qt-stage.is-done .qt-note {
    opacity: 1;
    color: var(--color-gm-grey-400);
  }
  @media (min-width: 900px) {
    .qt-note {
      margin-top: 0.4rem;
    }
  }

  .qt-done {
    margin-top: 3rem;
    padding: 2rem;
    border: 1px solid var(--color-gm-red);
    text-align: center;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.5s ease-out,
      transform 0.6s cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  .qt-done.is-in {
    opacity: 1;
    transform: none;
  }
  .qt-fence {
    width: 132px;
    height: auto;
    margin: 0 auto;
  }
  .qt-fd {
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 0.7s ease-out;
  }
  .qt-fd--wire {
    stroke: rgb(255 255 255 / 0.45);
    stroke-width: 1;
  }
  .qt-fd--post,
  .qt-fd--cap {
    stroke: var(--color-gm-white);
    stroke-width: 2;
  }
  .qt-fence line:first-of-type {
    stroke: rgb(255 255 255 / 0.25);
    stroke-width: 1;
  }
  .qt-done.is-in .qt-fd {
    stroke-dashoffset: 0;
  }
  .qt-done-title {
    margin-top: 1.25rem;
    color: var(--color-gm-white);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .qt-done-note {
    margin-top: 0.5rem;
    color: var(--color-gm-grey-400);
    font-size: 13px;
  }

  .qt-disclaimer {
    margin-top: 2.5rem;
    color: var(--color-gm-grey-600);
    font-size: 11px;
    line-height: 1.6;
    max-width: 62ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .qt-link-fill,
    .qt-ring-draw,
    .qt-icon .qt-draw,
    .qt-tick,
    .qt-tick-draw,
    .qt-done,
    .qt-fd,
    .qt-label,
    .qt-note {
      transition: none;
    }
    .qt-stage.is-active .qt-node::after {
      animation: none;
    }
  }
</style>

<script>
  const tracker = document.querySelector<HTMLElement>('[data-tracker]');

  if (tracker) {
    const stages = Array.from(tracker.querySelectorAll<HTMLElement>('[data-stage]'));
    const done = tracker.querySelector<HTMLElement>('[data-tracker-done]');
    const stepMs = (Number(tracker.dataset.step) || 3) * 1000;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /** Mark everything up to `i` complete, `i` active, the rest pending. */
    const paint = (i: number) => {
      stages.forEach((stage, n) => {
        stage.classList.toggle('is-done', n < i);
        stage.classList.toggle('is-active', n === i);
        /* The connector belongs to the stage it arrives at, so it fills once
           the stage before it is behind us. */
        stage.classList.toggle('is-linked', n <= i && n > 0);
      });
    };

    const finish = () => {
      stages.forEach((stage) => {
        stage.classList.add('is-done', 'is-linked');
        stage.classList.remove('is-active');
      });
      if (done) {
        done.hidden = false;
        /* Let the browser see `hidden` removed before the class that animates
           it in, or the transition is skipped and it just appears. */
        void done.offsetHeight;
        done.classList.add('is-in');
      }
    };

    if (reduce) {
      /* The state is the information; the animation is not. Show it complete. */
      finish();
    } else {
      paint(0);
      let i = 0;
      const tick = () => {
        i += 1;
        if (i >= stages.length) {
          finish();
          return;
        }
        paint(i);
        window.setTimeout(tick, stepMs);
      };
      window.setTimeout(tick, stepMs);
    }
  }
</script>
