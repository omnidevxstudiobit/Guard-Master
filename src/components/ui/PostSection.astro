---
/**
 * Post cross-sections — one drawing per profile in the range.
 *
 * The four posts differ in exactly one way a buyer can see: their section. A
 * photograph of four galvanised uprights standing in a yard shows four grey
 * sticks; a section drawn to scale shows immediately that the square post is
 * twice the material of the small T, and that the Guard Master profile is a
 * different kind of object altogether. So this is a section, drawn at a shared
 * scale so the four can be compared by eye.
 *
 * **Drawn to the dimensions in the name.** 100 x 60, 76 x 40 and 76 x 76 are
 * the client's own designations and are drawn at 1 mm = 1.6 units against a
 * common origin, so the tiles are directly comparable rather than each fitted
 * to its own box. The T-post depth of 64 mm comes off the manufacturer's
 * assembly drawing, which dimensions the T-upright as 100 mm base, 60 mm head,
 * 64 mm deep. The 76 x 40 T's depth is *not* published anywhere I can verify,
 * so it is drawn to the same 64 mm and left undimensioned — the two figures in
 * its name are the two that are stated.
 *
 * The Guard Master section is the one profile with features rather than just
 * dimensions, and they are the six named on the client's own post diagram:
 * anti-tamper lip, anti-push lip, mesh securing teeth, clamp securing slots,
 * the fold-over reinforcing rib, and the solar cap it accepts. It is drawn in
 * elevation rather than section for that reason — a section through it would
 * show the rib and lips and hide the teeth and slots, which are the parts that
 * sell it.
 *
 * Static. These are reference drawings inside a specification table; they
 * should be readable the moment the row is, not after an animation.
 */

interface Props {
  variant: 'guardMaster' | 't100' | 't76' | 'sq76';
  label: string;
}

const { variant, label } = Astro.props;

/** 1 mm at drawing scale. Shared by all four, so the sections compare. */
const S = 1.6;
/** Common origin: sections sit on this baseline, centred on this axis. */
const CX = 100;
const BASE = 150;

/** A T-section: `w` base, `head` across the top, `d` deep. */
const tee = (w: number, head: number, d: number): string => {
  const x0 = CX - (w * S) / 2;
  const x1 = CX + (w * S) / 2;
  const h0 = CX - (head * S) / 2;
  const h1 = CX + (head * S) / 2;
  const y = BASE - d * S;
  return `M${x0} ${BASE} L${h0} ${y} L${h1} ${y} L${x1} ${BASE} Z`;
};

const SQ = 76;
const sqX0 = CX - (SQ * S) / 2;
const sqY0 = BASE - SQ * S;

/* Guard Master, in elevation — the only profile whose selling points are
   features rather than dimensions. */
const GM = { x: 84, w: 32, top: 34, bottom: 168 };
const teeth = [70, 92, 114, 136];
---

<div class="ps" role="img" aria-label={label}>
  <svg viewBox="0 0 200 200" class="h-full w-full" aria-hidden="true">
    <line class="ps-faint" x1="10" y1={BASE} x2="190" y2={BASE}></line>

    {variant === 't100' && <path class="ps-solid" d={tee(100, 60, 64)} />}
    {variant === 't76' && <path class="ps-solid" d={tee(76, 40, 64)} />}

    {
      variant === 'sq76' && (
        <g>
          <rect class="ps-solid" x={sqX0} y={sqY0} width={SQ * S} height={SQ * S} rx="3" />
          {/* hollow section — the wall thickness is what it is, not a claim */}
          <rect
            class="ps-thin"
            x={sqX0 + 5}
            y={sqY0 + 5}
            width={SQ * S - 10}
            height={SQ * S - 10}
            rx="2"
          />
        </g>
      )
    }

    {
      variant === 'guardMaster' && (
        <g>
          {/* solar cap */}
          <rect
            class="ps-solid"
            x={GM.x - 8}
            y={GM.top - 16}
            width={GM.w + 16}
            height="16"
            rx="2"
          />
          <circle class="ps-led" cx={GM.x + 8} cy={GM.top - 8} r="2.4" />
          <circle class="ps-led" cx={GM.x + GM.w - 8} cy={GM.top - 8} r="2.4" />

          <rect class="ps-solid" x={GM.x} y={GM.top} width={GM.w} height={GM.bottom - GM.top} />
          {/* fold-over reinforcing rib */}
          <line class="ps-mid" x1={GM.x + 17} y1={GM.top + 8} x2={GM.x + 17} y2={GM.bottom - 8} />
          <line class="ps-thin" x1={GM.x + 10} y1={GM.top + 8} x2={GM.x + 10} y2={GM.bottom - 8} />
          {/* anti-tamper lip, then anti-push lip */}
          <path class="ps-edge" d={`M${GM.x} 58 H${GM.x - 9} V70 H${GM.x}`} />
          <path class="ps-edge" d={`M${GM.x} 140 H${GM.x - 9} V152 H${GM.x}`} />
          {/* clamp securing slot */}
          <rect class="ps-mid" x={GM.x + 6} y="100" width="18" height="8" rx="1" />
          {/* mesh securing teeth */}
          {teeth.map((y) => (
            <path
              class="ps-tooth"
              d={`M${GM.x + GM.w} ${y - 6} L${GM.x + GM.w + 12} ${y} L${GM.x + GM.w} ${y + 6} Z`}
            />
          ))}
        </g>
      )
    }
  </svg>
</div>

<style>
  .ps {
    width: 100%;
    height: 100%;
  }

  .ps .ps-faint,
  .ps .ps-thin,
  .ps .ps-mid,
  .ps .ps-edge {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .ps .ps-faint {
    stroke: #d6d6d6;
    stroke-width: 1;
  }
  .ps .ps-thin {
    stroke: #bdbdbd;
    stroke-width: 1;
  }
  .ps .ps-mid {
    stroke: #8a8a8a;
    stroke-width: 1.3;
  }
  .ps .ps-edge {
    stroke: #161616;
    stroke-width: 1.6;
  }
  .ps .ps-solid {
    fill: #ffffff;
    stroke: #161616;
    stroke-width: 2;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .ps .ps-tooth {
    fill: #161616;
    stroke: none;
  }
  .ps .ps-led {
    fill: #e4112a;
    stroke: none;
  }
</style>
