---
import type { ProductImage } from '@data/products';

/**
 * A photograph that opens on hover.
 *
 * Extracted from AfterDark.astro once a second page wanted the same
 * behaviour: the alternative was ~120 lines of duplicated hover CSS in two
 * components, which is exactly the sort of thing that drifts apart the first
 * time one of them is tuned. The section prose stays with the sections; only
 * the frame and its motion live here.
 *
 * **Motion is CSS only** — no GSAP, no island, no JS at all. animationguide.md
 * §3 and §8: compositor-only properties, restraint over blanket animation, and
 * nothing on the critical path. Four things move, all `transform` or
 * `opacity`:
 *
 *   1. a scrim over the image lifts — the frame "lights up"
 *   2. the image scales 1.04 behind `overflow: hidden`
 *   3. the note rises and fades in
 *   4. a red hairline draws left-to-right under the title (`scaleX`)
 *
 * The scrim is a painted layer rather than `filter: brightness()`: filters on
 * a large image force a repaint on some mobile GPUs, and animating opacity on
 * a solid overlay reads the same for free.
 *
 * **Touch is not an afterthought** (governing rule #5). The whole reveal sits
 * inside `@media (hover: hover) and (pointer: fine)`, so a phone never lands
 * in a state it cannot open — the scrim rests light and the note is simply
 * visible. The same query excludes `prefers-reduced-motion`, and
 * `:focus-within` opens a frame for keyboard users on pointer devices.
 *
 * **CLS is structurally zero.** The caption is absolutely positioned over the
 * frame, so revealing it moves nothing; the image carries its real intrinsic
 * width/height and the frame reserves its box via `aspect-ratio` before the
 * first byte of image data arrives.
 */

interface Props {
  image: ProductImage;
  /** Small mono line above the title — an index, a sector, a place. */
  kicker?: string;
  title?: string;
  /** The line that stays hidden until hover on pointer devices. */
  body?: string;
  /** Required: this component has no idea how wide it will be rendered. */
  sizes: string;
  /**
   * CSS `aspect-ratio` for the frame. Defaults to the image's own, so the
   * caller has to opt in to cropping rather than getting it by accident.
   */
  ratio?: string;
  /**
   * `aspect-ratio` from 1024px up, where a frame that spans the full grid is
   * suddenly twice as wide and a native ratio starts running 750 px tall.
   * Separate from `ratio` because the crop that rescues a desktop band is
   * usually the wrong one on a phone, where the same frame is already narrow
   * — cropping it there just throws away the composition.
   */
  ratioLg?: string;
  /**
   * `object-position` for the crop. Defaults to centre. Worth setting on any
   * portrait phone shot forced into a landscape band: the subject in those is
   * almost always in the top third, and a centred crop throws it away — on
   * the delivery frame here it removed the vehicles, the cone and the ground
   * and left an abstract wall of mesh.
   */
  position?: string;
  /** Above-the-fold frames pass 'eager'; everything else stays lazy. */
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  image,
  kicker,
  title,
  body,
  sizes,
  ratio,
  ratioLg,
  position,
  loading = 'lazy',
  class: className = '',
} = Astro.props;

const frameRatio = ratio ?? `${image.width} / ${image.height}`;
/* Only emitted when the caller asked for it — the stylesheet falls back to
   `--rf-ratio` and a centred crop for every frame that doesn't. */
const vars =
  `--rf-ratio: ${frameRatio};` +
  (ratioLg ? ` --rf-ratio-lg: ${ratioLg};` : '') +
  (position ? ` --rf-pos: ${position};` : '');
---

<figure class:list={['rf', className]} style={vars}>
  <img
    src={image.src}
    srcset={image.srcset}
    sizes={sizes}
    width={image.width}
    height={image.height}
    alt={image.alt}
    loading={loading}
    decoding="async"
    class="rf-img"
  />
  <span class="rf-scrim" aria-hidden="true"></span>
  {
    (kicker || title || body) && (
      <figcaption class="rf-body">
        {kicker && <p class="rf-kicker">{kicker}</p>}
        {title && <h3 class="rf-title">{title}</h3>}
        {body && <span class="rf-rule" aria-hidden="true" />}
        {body && <p class="rf-note">{body}</p>}
      </figcaption>
    )
  }
</figure>

<style>
  /* ---- base: the touch / no-hover / reduced-motion state ----
     Everything is visible and static. The reveal below is layered on top for
     pointer devices only. */
  .rf {
    position: relative;
    overflow: hidden;
    background: #0c0c0e;
    border: 1px solid rgb(255 255 255 / 0.08);
  }

  .rf-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--rf-pos, 50% 50%);
    aspect-ratio: var(--rf-ratio);
  }
  @media (min-width: 1024px) {
    .rf-img {
      aspect-ratio: var(--rf-ratio-lg, var(--rf-ratio));
    }
  }

  .rf-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.92) 0%,
      rgb(0 0 0 / 0.35) 45%,
      transparent 78%
    );
  }

  .rf-body {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 1.25rem;
  }
  @media (min-width: 640px) {
    .rf-body {
      padding: 1.75rem;
    }
  }

  .rf-kicker {
    color: var(--color-gm-red);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .rf-title {
    margin-top: 0.5rem;
    color: var(--color-gm-white);
    font-family: var(--font-display, inherit);
    font-size: clamp(1.05rem, 2vw, 1.4rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.1;
    text-transform: uppercase;
  }
  .rf-rule {
    display: block;
    width: 3rem;
    height: 2px;
    margin-top: 0.8rem;
    background: var(--color-gm-red);
  }
  .rf-note {
    margin-top: 0.8rem;
    max-width: 34rem;
    color: var(--color-gm-grey-300);
    font-size: 13px;
    line-height: 1.6;
  }

  /* ---- enhancement: real hover, real pointer, motion allowed ---- */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .rf-img,
    .rf-scrim,
    .rf-note,
    .rf-kicker,
    .rf-title,
    .rf-rule {
      transition:
        transform 0.62s cubic-bezier(0.16, 0.84, 0.24, 1),
        opacity 0.42s cubic-bezier(0.16, 0.84, 0.24, 1);
    }

    /* `will-change` only where the movement is big enough to be worth a
       promoted layer. On all six it would promote six layers per frame for
       the sake of a 0.5rem nudge on a line of text. */
    .rf-img,
    .rf-note {
      will-change: transform, opacity;
    }

    /* Resting: dimmed, titled, closed. Heavier than the touch gradient so the
       hover has somewhere to travel from, and heavy enough at mid-height that
       a caption still reads there — on /gallery the tiles are short and the
       caption block nearly fills them, so the kicker sits around the middle
       of the frame rather than at its foot. A version tuned only against the
       large frames left it illegible over anything bright. */
    .rf-scrim {
      background: linear-gradient(
        to top,
        rgb(0 0 0 / 0.92) 0%,
        rgb(0 0 0 / 0.5) 50%,
        rgb(0 0 0 / 0.26) 100%
      );
    }
    /* Everything enters from the left, in sequence, so the block reads as
       one sweep across the frame rather than four things arriving at once.
       The hairline already drew left-to-right, and the rest now travels the
       same axis with it — the offsets step down (1.5rem → 1.25rem → 1rem)
       so the lines arrive slightly fanned instead of locked together. */
    .rf-note {
      opacity: 0;
      transform: translate3d(-1.5rem, 0, 0);
    }
    .rf-kicker {
      transform: translate3d(-1rem, 0, 0);
    }
    .rf-title {
      transform: translate3d(-1.25rem, 0, 0);
    }
    .rf-rule {
      transform: scaleX(0);
      transform-origin: left center;
    }

    /* Open. `:focus-within` matters — these sit among real links, and a
       keyboard user must see what a mouse user sees. */
    .rf:hover .rf-img,
    .rf:focus-within .rf-img {
      transform: scale(1.04);
    }
    /* The "lights come on" beat — a big enough step to read as the frame
       brightening, while the caption keeps enough backing to stay legible
       once the note has faded in on top of it. */
    .rf:hover .rf-scrim,
    .rf:focus-within .rf-scrim {
      opacity: 0.55;
    }
    /* Staggered in reading order: kicker, title, hairline, note. */
    .rf:hover .rf-kicker,
    .rf:focus-within .rf-kicker {
      transform: translate3d(0, 0, 0);
    }
    .rf:hover .rf-title,
    .rf:focus-within .rf-title {
      transform: translate3d(0, 0, 0);
      transition-delay: 0.05s;
    }
    .rf:hover .rf-rule,
    .rf:focus-within .rf-rule {
      transform: scaleX(1);
      transition-delay: 0.1s;
    }
    .rf:hover .rf-note,
    .rf:focus-within .rf-note {
      opacity: 1;
      transform: translate3d(0, 0, 0);
      transition-delay: 0.14s;
    }
  }
</style>
